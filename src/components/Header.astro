---
// Every non-home page uses the same pill header as the home (founder 2026-09-16). App landings,
// articles and SEO pages keep their conversion: the CTA downloads THIS app.
import { storeLink } from '../config/apps';
import PillBar from './PillBar.astro';

interface Props {
  activeApp?: string;
  /** app-scoped page: the CTA is this app's store link */
  solo?: { slug: string; name: string; appStoreUrl: string; comingSoon?: boolean };
}
const { solo } = Astro.props;
const DEV_PAGE = 'https://apps.apple.com/us/developer/bliss-coach/id1628409883';
const cta = solo
  ? solo.comingSoon
    ? { href: '', label: 'Coming soon', placement: `${solo.slug}-header` }
    : { href: storeLink(solo.appStoreUrl, `${solo.slug}-header`), label: `Get ${solo.name}`, placement: `${solo.slug}-header` }
  : { href: storeLink(DEV_PAGE, 'site-header'), label: 'Get the apps', placement: 'site-header' };
---

<PillBar cta={cta} soon={!!solo?.comingSoon} />
