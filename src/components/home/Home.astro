---
// Home — Bliss, the all-tutors language app (live on the App Store since 2026-09-22).
// Rendered by src/pages/index.astro (EN) and src/pages/fr/index.astro (FR): one layout, one copy
// table below. A new string goes in BOTH languages.
//
// Layout, measures, type scale and interactions mirror praktika.ai's home (founder request,
// 2026-09-23): same grid (12 cols, 32px gutter, 1200px layout), same section order, same
// scroll-driven feature phone, same hover-to-expand tutor row. Everything shown is Bliss:
// its tutors, its real screens, its real reviews. No rating count and no learner count —
// Bliss has neither yet, so the hero laurels carry product facts (tutors, languages).
// The home sells Bliss ONLY (founder 2026-09-23): no links to the single-tutor apps here, so the
// visit is not diluted. Their landings stay live for SEO.
import { ClientRouter } from 'astro:transitions';
import Analytics from '../Analytics.astro';
import BlissBloom from '../BlissBloom.astro';
import Pixels from '../Pixels.astro';
import ConsentBanner from '../ConsentBanner.astro';
import CarryParams from '../CarryParams.astro';
import { withBase, storeLink, BLISS_APP_STORE_URL } from '../../config/apps';
import { isCheckoutConfigured } from '../../config/funnel';

interface Props { lang?: 'en' | 'fr' }
const { lang = 'en' } = Astro.props;
const fr = lang === 'fr';

const STORE = BLISS_APP_STORE_URL;
const START = withBase(fr ? '/start/?lang=fr' : '/start/');
// The web path only shows once Bliss can actually be bought on the web (PUBLIC_RC_WEB_BILLING_URL_BLISS
// set at build). Without it /start/ ends on a disabled paywall — the App Store is the only path then.
const WEB_OK = isCheckoutConfigured('bliss');
const u = (p: string) => withBase(p);
const HOME_URL = fr ? 'https://bliss-coach.com/fr/' : 'https://bliss-coach.com/';

