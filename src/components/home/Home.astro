      }
      .fover--3 {
        left: 15%; top: 53%; width: 100%; display: flex; flex-direction: column; gap: .8rem; padding: 2rem 2.2rem;
        background: #fff0f6; border: 3px solid #fff; border-radius: 2.4rem; box-shadow: 0 1.2rem 3.2rem -.8rem rgba(13, 13, 13, .18);
      }
