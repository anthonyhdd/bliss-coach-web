      .mis__fade { display: none; }

      /* ---------- reviews ---------- */
      .award-title { text-align: center; }
      @media (max-width: 480px) { .award-title { width: 22rem; } }
      .rgrid { grid-template-columns: repeat(3, minmax(0, 1fr)); position: relative; }
      @media (max-width: 1024px) { .rgrid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
      @media (max-width: 480px) { .rgrid { grid-template-columns: 1fr; } }
      .rcol { display: flex; flex-direction: column; row-gap: var(--gutter); }
      .review { background: var(--g-50); border-radius: var(--r-lg); display: flex; flex-direction: column; padding: var(--s-xl); row-gap: var(--s-md); }
      .review__data { align-items: center; column-gap: var(--s-md); display: flex; justify-content: space-between; }
      .review__col { flex: 1; min-width: 0; }
      .review__stars { display: flex; flex-shrink: 0; color: var(--orange); }
      .review__stars svg { height: 2.4rem; width: 2.4rem; }
      .review__about { color: var(--g-800); display: block; overflow: hidden; text-align: right; text-overflow: ellipsis; white-space: nowrap; }

      /* ---------- compare ---------- */
      .cmp__item { border-radius: var(--r-lg); padding: var(--s-2xl); }
      .cmp__item--first { background: var(--grad); grid-column: 2 / 7; overflow: hidden; position: relative; isolation: isolate; clip-path: inset(0 round var(--r-lg)); }
      .cmp__item--second { border: 1px solid var(--g-200); grid-column: 7 / 12; }
      @media (max-width: 1024px) { .cmp__item--first { grid-column: 1 / 5; } .cmp__item--second { grid-column: 5 / 9; } }
      @media (max-width: 480px) {
        .cmp-slider { margin: 0 -2rem; overflow-x: auto; padding: 0 2rem var(--s-lg); scrollbar-width: none; }
        .cmp { display: flex; column-gap: var(--s-sm); }
        .cmp__item { flex-shrink: 0; width: 32rem; }
      }
      .cmp__title { display: block; margin-bottom: var(--s-xs); position: relative; z-index: 1; }
      .cmp__price { margin-bottom: var(--s-3xl); position: relative; z-index: 1; }
      .cmp__main { color: #fff; font-family: var(--font-heading); font-size: 6rem; font-weight: 500; margin-right: var(--s-xs); }
      .cmp__main--red { color: var(--red-600); }
      .cmp__dur { font-weight: 500; }
      .cmp__list { display: flex; flex-direction: column; position: relative; row-gap: var(--s-md); z-index: 1; }
      .cmp__list:not(:last-child) { margin-bottom: var(--s-3xl); }
      .cmp__li { align-items: flex-start; column-gap: var(--s-md); display: flex; }
      .cmp__icon { align-items: center; color: #fff; display: flex; flex-shrink: 0; height: 4.8rem; justify-content: center; width: 4.8rem; }
      .cmp__icon svg { height: 2.4rem; }
      .cmp__li--pos .cmp__icon { background: rgba(255, 255, 255, .16); border-radius: var(--r-md); }
      .cmp__li--neg .cmp__icon { background: var(--red-600); border-radius: 50%; }
      .cmp__text { display: flex; flex-direction: column; padding-top: var(--s-2xs); row-gap: var(--s-3xs); }
      .cmp__li--pos .cmp__lt { color: #fff; }
      .cmp__lc { color: var(--g-800); font-weight: 500; }
      .cmp__li--pos .cmp__lc { color: rgba(255, 255, 255, .7); }
      .cmp__item--first > div[data-placement] { position: relative; z-index: 1; }

      /* ---------- footer ---------- */
      .foot { position: relative; }
      .foot__main { align-items: center; display: flex; flex-direction: column; position: relative; }
      .foot__bg { height: 120%; left: 0; top: -10%; width: 100%; z-index: -1; }
      .foot__logo { filter: drop-shadow(1.2rem 1.6rem 1.6rem rgba(219, 39, 119, .35)); height: auto; margin-bottom: var(--s-6xl); width: 16rem; border-radius: 22.5%; }
      .foot__logo.is-loaded { filter: drop-shadow(1.2rem 1.6rem 1.6rem rgba(219, 39, 119, .35)); }
      @media (max-width: 480px) { .foot__logo { width: 12rem; } }
      .foot__title { display: block; margin-bottom: var(--s-5xl); text-align: center; }
      @media (max-width: 1024px) { .foot__title { margin-bottom: var(--s-4xl); } }
      @media (max-width: 480px) { .foot__title { margin-bottom: var(--s-3xl); } }
      .foot__dl { column-gap: var(--s-md); display: flex; flex-wrap: wrap; justify-content: center; row-gap: var(--s-md); }
      .foot__menu { border-bottom: 1px solid var(--g-200); grid-column: 2 / 12; padding-bottom: var(--s-4xl); flex-wrap: wrap; }
      @media (max-width: 1024px) { .foot__menu { grid-column: 1 / 9; justify-content: space-between; padding-bottom: var(--s-2xl); } }
      @media (max-width: 480px) {
        .foot__menu { grid-column: 1 / 3; display: block; column-count: 2; padding-bottom: var(--s-4xl); }
        .foot__menu .menu__item { display: flex; padding: 0; margin-bottom: var(--s-lg); line-height: 2rem; }
      }
      .foot__bottom { align-items: center; display: flex; grid-column: 2 / 12; height: 14.8rem; justify-content: space-between; }
      @media (max-width: 1024px) { .foot__bottom { grid-column: 1 / 9; height: 9.2rem; } }
      @media (max-width: 480px) {
        .foot__bottom { align-items: flex-start; flex-direction: column; grid-column: 1 / 3; height: auto; padding: var(--s-xl) 0 12rem; row-gap: var(--s-xl); }
      }
      .foot__left { display: flex; flex-direction: column; }
      .foot__copy { color: var(--g-800); }
      .foot__links { display: inline-flex; margin-left: calc(var(--s-xs) * -1); }
      .foot__link { font-weight: 500; padding: var(--s-xs); text-decoration: none; transition: color .2s ease; }
      .foot__link:hover { color: var(--brand-700); }
      .foot__socials { display: inline-flex; }
      .foot__social { align-items: center; border-radius: 50%; color: var(--g-900); display: flex; height: 5.2rem; justify-content: center; transition: background-color .2s ease; width: 5.2rem; }
      .foot__social:hover { background: var(--g-100); }
      .foot__social:active { background: var(--g-200); }
      .foot__social svg { width: 2.4rem; height: 2.4rem; }

      /* ---------- QR ---------- */
      .qr { bottom: 0; left: 0; pointer-events: none; position: fixed; width: 100%; z-index: 20; }
      .qr__layout { display: flex; justify-content: flex-end; margin: 0 auto; max-width: 144rem; padding: 0 var(--s-md); }
      .qr__block {
        display: block; pointer-events: auto; text-decoration: none; background: #fff; width: 11.2rem;
        border-radius: var(--r-md) var(--r-md) 0 0; box-shadow: 0 17.45px 34.9px -4.36px rgba(13, 13, 13, .1);
        padding: var(--s-xs) var(--s-xs) var(--s-sm);
      }
      .qr__code { width: 100%; height: auto; margin-bottom: var(--s-2xs); }
      .qr__cap {
        color: var(--brand-700); display: block; font-family: var(--font-heading); font-size: 1.2rem; font-weight: 500;
        letter-spacing: .02em; line-height: 1.06; text-align: center; text-transform: uppercase;
      }
      @media (max-width: 1024px) { .qr { display: none; } }

      @media (prefers-reduced-motion: reduce) {
        .hero__wave, .langs__track, .improve__bars i { animation: none; }
      }
    </style>

    <script>
      function init() {
        // images: fade in once decoded
        document.querySelectorAll<HTMLImageElement>('img.image').forEach((img) => {
          const done = () => img.classList.add('is-loaded');
          if (img.complete && img.naturalWidth) done();
          else { img.addEventListener('load', done, { once: true }); img.addEventListener('error', done, { once: true }); }
        });

        // hero phone: Emily or Mila, 50/50, kept for the session
        const heroVideo = document.getElementById('heroVideo') as HTMLVideoElement | null;
        if (heroVideo) {
          let pick = '';
          try { pick = sessionStorage.getItem('hero_tutor') || ''; } catch {}
          if (pick !== 'emily' && pick !== 'mila') pick = Math.random() < 0.5 ? 'emily' : 'mila';
          try { sessionStorage.setItem('hero_tutor', pick); } catch {}
          if (pick === 'mila') {
            const base = heroVideo.dataset.base || '/home/';
            heroVideo.poster = `${base}pk/tutor-mila.webp`;
            heroVideo.src = `${base}video/mila.mp4`;
            const nm = document.getElementById('heroName');
            if (nm) nm.textContent = 'Mila';
          }
          document.querySelectorAll<HTMLElement>('.hero__bubbles').forEach((b) => { b.hidden = b.dataset.tutor !== pick; });
          document.documentElement.dataset.heroTutor = pick;
          (window as any).gtag?.('event', 'hero_tutor', { tutor: pick, page_path: location.pathname });
        }

        // muted loops: some browsers ignore the autoplay attribute until nudged
        document.querySelectorAll<HTMLVideoElement>('video[autoplay]').forEach((v) => { v.muted = true; v.play().catch(() => {}); });

        // header: white pill + shadow as soon as the page scrolls
        const box = document.getElementById('hdrBox');
        const onScroll = () => box?.classList.toggle('is-shadow', window.scrollY > 0);
        onScroll();
        window.addEventListener('scroll', onScroll, { passive: true });

        // features: the slide crossing the viewport centre drives the sticky phone
        const slides = Array.from(document.querySelectorAll<HTMLElement>('.fslide'));
        const contents = Array.from(document.querySelectorAll<HTMLElement>('.fphone__content'));
        const overs = Array.from(document.querySelectorAll<HTMLElement>('.fover'));
        let current = -1;
        const setStep = (n: number) => {
          if (n === current) return;
          current = n;
          slides.forEach((s, i) => s.classList.toggle('is-active', i === n));
          contents.forEach((c) => {
            const on = Number(c.dataset.step) === n;
            c.classList.toggle('is-active', on);
            const v = c.querySelector('video');
            if (v) on ? v.play().catch(() => {}) : v.pause();
          });
          overs.forEach((o) => o.classList.toggle('is-active', Number(o.dataset.step) === n));
        };
        const pickStep = () => {
          if (window.innerWidth <= 1024 || !slides.length) return;
          const mid = window.innerHeight / 2;
          let best = 0, dist = Infinity;
          slides.forEach((s, i) => {
            const r = s.getBoundingClientRect();
            const d = Math.abs(r.top + r.height / 2 - mid);
            if (d < dist) { dist = d; best = i; }
          });
          setStep(best);
        };
        pickStep();
        window.addEventListener('scroll', pickStep, { passive: true });

        // below 1024px the features become a carousel: timer + arrows, progress segments
        const prog = Array.from(document.querySelectorAll<HTMLElement>('.fprog span'));
        const paintProg = (n: number) => prog.forEach((p, i) => {
          p.classList.remove('is-active', 'is-done');
          void p.offsetWidth; // restart the fill animation
          if (i < n) p.classList.add('is-done');
          if (i === n) p.classList.add('is-active');
        });
        let timer = 0;
        let inView = false;
        const goTo = (n: number) => {
          const k = (n + slides.length) % slides.length;
          current = -1;
          setStep(k);
          paintProg(k);
          window.clearTimeout(timer);
          if (inView && window.innerWidth <= 1024) timer = window.setTimeout(() => goTo(k + 1), 6000);
        };
        document.getElementById('fPrev')?.addEventListener('click', () => goTo(current - 1));
        document.getElementById('fNext')?.addEventListener('click', () => goTo(current + 1));
        const feat = document.getElementById('features');
        if (feat && 'IntersectionObserver' in window) {
          new IntersectionObserver(([e]) => {
            inView = e.isIntersecting;
            if (window.innerWidth > 1024) return;
            if (inView) goTo(Math.max(0, current)); else window.clearTimeout(timer);
          }, { threshold: .35 }).observe(feat);
        }

        // language switcher (desktop): flag button -> small menu
        const langBtn = document.getElementById('langBtn');
        const langMenu = document.getElementById('langMenu');
        langBtn?.addEventListener('click', (e) => {
          e.stopPropagation();
          const open = langMenu?.hidden ?? false;
          if (langMenu) langMenu.hidden = !open;
          langBtn.setAttribute('aria-expanded', String(open));
        });
        document.addEventListener('click', (e) => {
          if (langMenu && !langMenu.hidden && !(e.target as Element).closest('#lang')) {
            langMenu.hidden = true;
            langBtn?.setAttribute('aria-expanded', 'false');
          }
        });

        // mobile menu
        const burger = document.getElementById('burger');
        const drop = document.getElementById('hdrDrop');
        burger?.addEventListener('click', () => {
          const open = burger.getAttribute('aria-expanded') !== 'true';
          burger.setAttribute('aria-expanded', String(open));
          burger.classList.toggle('is-open', open);
          box?.classList.toggle('is-open', open);
          if (drop) drop.hidden = !open;
        });
        window.addEventListener('resize', pickStep);

        // tutors: hovering a card expands it; the others shrink by distance
        const slider = document.getElementById('tslider');
        const cards = Array.from(document.querySelectorAll<HTMLElement>('.tcard'));
        const dots = Array.from(document.querySelectorAll<HTMLElement>('#tdots span'));
        const activate = (n: number) => {
          cards.forEach((c, i) => {
            c.classList.remove('idx0', 'idx1', 'idx2', 'idx3', 'idx4');
            c.classList.add(`idx${Math.min(4, Math.abs(i - n))}`);
            c.classList.toggle('is-active', i === n);
          });
          dots.forEach((d, i) => d.classList.toggle('is-active', i === n));
        };
        const mobile = () => window.innerWidth <= 768;
        cards.forEach((c, i) => {
          c.addEventListener('pointerenter', (e) => { if (!mobile() && e.pointerType === 'mouse') activate(i); });
          c.addEventListener('click', () => {
            if (mobile()) c.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
            else activate(i);
          });
        });
        if (slider) {
          const centreOnActive = () => {
            if (!mobile()) return;
            const a = slider.querySelector<HTMLElement>('.tcard.is-active');
            if (a) slider.scrollLeft = a.offsetLeft - (slider.clientWidth - a.clientWidth) / 2;
          };
          centreOnActive();
          let t = 0;
          slider.addEventListener('scroll', () => {
            if (!mobile()) return;
            cancelAnimationFrame(t);
            t = requestAnimationFrame(() => {
              const mid = slider.getBoundingClientRect().left + slider.clientWidth / 2;
              let best = 0, dist = Infinity;
              cards.forEach((c, i) => {
                const r = c.getBoundingClientRect();
                const d = Math.abs(r.left + r.width / 2 - mid);
                if (d < dist) { dist = d; best = i; }
              });
              activate(best);
            });
          }, { passive: true });
        }

        // intro video: play / pause toggle
        const vid = document.getElementById('introVideo') as HTMLVideoElement | null;
        const ctl = document.getElementById('introCtl');
        ctl?.addEventListener('click', () => {
          if (!vid) return;
          if (vid.paused) { vid.play().catch(() => {}); ctl.classList.remove('is-paused'); ctl.setAttribute('aria-label', ctl.dataset.pause || ''); }
          else { vid.pause(); ctl.classList.add('is-paused'); ctl.setAttribute('aria-label', ctl.dataset.play || ''); }
        });
      }
      document.addEventListener('astro:page-load', init);
    </script>
  </body>
</html>
