    </svg>

    <style>
      /* ---------- header ---------- */
      .hdr { position: sticky; top: 0; left: 0; z-index: 30; padding: var(--s-md); pointer-events: none; }
      .hdr::before {
        content: ''; position: absolute; left: 0; top: 0; width: 100%; height: calc(100% - var(--s-md)); z-index: -1;
        background: linear-gradient(180deg, rgba(255, 255, 255, .9) 0, rgba(255, 255, 255, 0) 100%);
      }
      @media (max-width: 1024px) { .hdr { padding: var(--s-md) var(--s-xl); } }
      @media (max-width: 480px) { .hdr { padding: 0; position: relative; } }
      .hdr__box { border-radius: 3.8rem; margin: 0 auto; max-width: 136rem; pointer-events: auto; position: relative; width: 100%; }
      .hdr__box::before {
        content: ''; position: absolute; inset: 0; border-radius: inherit; z-index: -1; background: #fff; opacity: 0;
        box-shadow: 0 .1rem .3rem rgba(13, 13, 13, .05), 0 .4rem 1.2rem -.4rem rgba(13, 13, 13, .1);
        transition: opacity .2s ease;
      }
      .hdr__box.is-shadow::before { opacity: 1; }
      .hdr__head { align-items: center; display: flex; justify-content: space-between; padding: var(--s-sm) var(--s-md); }
      @media (max-width: 1024px) { .hdr__head { padding: var(--s-md) var(--s-xl); } }
      @media (max-width: 480px) { .hdr__head { padding: var(--s-lg); padding-left: var(--s-xl); } }
      .hdr__logo {
        align-items: center; display: inline-flex; gap: .8rem; height: 4.8rem; text-decoration: none;
        color: var(--black); font-family: var(--font-heading); font-weight: 700; font-size: 3.2rem; letter-spacing: -.03em;
      }
      @media (max-width: 1024px) { .hdr__logo { height: 4.4rem; font-size: 3rem; } }
      .hdr__ctl { align-items: center; column-gap: var(--s-lg); display: flex; }
      .menu { display: flex; justify-content: center; }
      .menu__item {
        align-items: center; color: var(--black); display: inline-flex; font-family: var(--font-heading);
        font-size: 1.6rem; font-weight: 500; padding: var(--s-xs) var(--s-sm); text-decoration: none; transition: color .2s ease;
      }
      .menu__item:hover { color: var(--g-600); }
      .burger { display: none; align-items: center; justify-content: center; width: 5.2rem; height: 5.2rem; border-radius: 50%; cursor: pointer; }
      .burger svg { width: 2.4rem; height: 2.4rem; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; overflow: visible; }
      .burger .l1, .burger .l3 { transform-origin: center; transform-box: fill-box; transition: transform .2s ease; }
      .burger .l2 { transition: opacity .2s ease, transform .2s ease; }
      .burger.is-open .l1 { transform: translateY(.5rem) rotate(45deg); }
      .burger.is-open .l2 { opacity: 0; transform: translateX(100%); }
      .burger.is-open .l3 { transform: translateY(-.5rem) rotate(-45deg); }
      .hdr__drop { padding: var(--s-md) var(--s-2xl) var(--s-2xl); }
      .hdr__drop[hidden] { display: none; }
      .hdr__dropmenu { display: flex; flex-direction: column; margin-bottom: var(--s-xl); }
      .hdr__dropitem { font-family: var(--font-heading); font-size: 2rem; font-weight: 500; padding: 1.2rem 0; text-decoration: none; border-bottom: 1px solid var(--g-100); }
      .hdr__box.is-open::before { opacity: 1; }
      @media (max-width: 1024px) { .hdr .menu { display: none; } .burger { display: flex; } }
      @media (max-width: 480px) { .hdr__cta { display: none; } }
      .lang { position: relative; }
      .lang__btn { width: 4rem; height: 4rem; border-radius: 50%; cursor: pointer; display: flex; align-items: center; justify-content: center; transition: background-color .2s ease; }
      .lang__btn:hover { background: var(--g-100); }
      .lang__flag { display: block; width: 2.8rem; height: 2.8rem; border-radius: 50%; overflow: hidden; box-shadow: inset 0 0 0 1px rgba(0, 0, 0, .08); flex-shrink: 0; }
      .lang__flag :global(svg) { display: block; width: 100%; height: 100%; transform: scale(1.5); }
      .lang__menu {
        position: absolute; right: 0; top: calc(100% + .8rem); min-width: 18rem; background: #fff; border-radius: var(--r-md); padding: .6rem;
        box-shadow: 0 .1rem .3rem rgba(13, 13, 13, .05), 0 1.2rem 3.2rem -.8rem rgba(13, 13, 13, .2); z-index: 40;
      }
      .lang__menu[hidden] { display: none; }
      .lang__opt { display: flex; align-items: center; gap: 1.2rem; padding: 1rem 1.2rem; border-radius: var(--r-sm); text-decoration: none; font: 500 1.6rem/1 var(--font-heading); transition: background-color .12s ease; }
      .lang__opt:hover { background: var(--g-50); }
      .lang__opt.is-on { color: var(--brand-600); }
      .hdr__droplangs { display: flex; gap: 1.6rem; margin-top: var(--s-lg); font: 500 1.6rem/1 var(--font-heading); }
      .hdr__droplangs a { text-decoration: none; color: var(--g-600); }
      .hdr__droplangs a.is-on { color: var(--black); }
      @media (max-width: 1024px) { .lang { display: none; } }

      /* ---------- hero ---------- */
      @media (max-width: 480px) { .hero-layout { padding: 0; } }
      .hero-main { padding-top: 3%; position: relative; z-index: 1; }
      @media (max-width: 1024px) { .hero-main { padding-top: 0; } }
      .hero {
        background: var(--grad); border-radius: var(--r-2xl); display: flex; grid-column: 1 / 13; position: relative;
      }
      @media (max-width: 1024px) { .hero { flex-direction: column; grid-column: 1 / 9; } }
      @media (max-width: 480px) { .hero { grid-column: 1 / 3; } }
      .hero__shadowbox { border-radius: inherit; height: 100%; left: 0; overflow: hidden; position: absolute; top: 0; width: 100%; clip-path: inset(0 round var(--r-2xl)); isolation: isolate; }
      .hero__shadow {
        background: #1c1c1c; border-radius: 50%; bottom: -40%; filter: blur(8rem); height: 100%;
        mix-blend-mode: darken; opacity: .1; position: absolute; right: 0; width: 50%;
      }
      @media (max-width: 1024px) { .hero__shadow { width: 100%; } }
      .hero__content {
        display: flex; flex-direction: column; gap: var(--s-3xl); justify-content: space-between;
        padding: var(--s-4xl); position: relative; flex: 1 1 auto;
      }
      @media (max-width: 1024px) {
        .hero__content { align-items: center; gap: var(--s-4xl); padding: var(--s-3xl); padding-bottom: var(--s-6xl); text-align: center; }
      }
      @media (max-width: 480px) { .hero__content { padding: var(--s-3xl) var(--s-xl); } }
      .hero__head { display: flex; flex-direction: column; row-gap: var(--s-2xl); }
      .hero__bloom { display: flex; margin-bottom: calc(var(--s-md) * -1); }
      @media (max-width: 1024px) { .hero__bloom { justify-content: center; } }
      @media (max-width: 1024px) { .hero__head { row-gap: var(--s-4xl); } }
      @media (max-width: 480px) { .hero__head { row-gap: var(--s-2xl); } }
      .hero__awards { align-items: center; column-gap: var(--s-3xl); display: inline-flex; flex-wrap: wrap; row-gap: var(--s-md); }
      @media (max-width: 1024px) { .hero__awards { column-gap: var(--s-2xl); justify-content: center; } }
      @media (max-width: 480px) { .hero__awards { column-gap: var(--s-lg); } }
      .hero__award { column-gap: 0; width: 20.4rem; }
      @media (max-width: 1024px) { .hero__award { width: 17.8rem; } }
      @media (max-width: 480px) { .hero__award { width: 16rem; } }
      .hero__download { align-items: center; display: inline-flex; flex-wrap: wrap; gap: var(--s-md); }
      @media (max-width: 1024px) { .hero__download { justify-content: center; } }
      .hero__side { align-items: flex-end; display: flex; flex-basis: 40%; flex-shrink: 0; padding-right: 10%; position: relative; }
      @media (max-width: 1024px) { .hero__side { flex-basis: auto; justify-content: center; padding-right: 0; } }
      .hero__sidec { margin-top: -10%; position: relative; width: 100%; }
      @media (max-width: 1024px) { .hero__sidec { height: 56rem; margin-top: 0; width: auto; aspect-ratio: 342 / 616; } }
      @media (max-width: 480px) { .hero__sidec { height: 40rem; } }
      .hero__phone { height: 100%; position: relative; }

      /* hero phone: top of an iPhone, cut flush by the card's bottom edge */
      .hphone {
        position: relative; width: 100%; aspect-ratio: 342 / 616; padding: .7rem .7rem 0;
        border-radius: 5.6rem 5.6rem 0 0; background: linear-gradient(135deg, #fafafb, #cfced5 28%, #f2f1f4 55%, #bdbcc3);
        box-shadow: inset 0 0 0 .1rem rgba(0, 0, 0, .12);
        filter: drop-shadow(-.8rem -.5rem 3.6rem rgba(0, 0, 0, .12));
      }
      @media (max-width: 1024px) { .hphone { height: 100%; width: auto; } }
      .hphone__screen { position: relative; height: 100%; border-radius: 4.3rem 4.3rem 0 0; overflow: hidden; background: #2a1a22; border: .8rem solid #0c0c0d; border-bottom: 0; }
      .hphone__video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 50% 20%; }
      .hphone__bar {
        position: absolute; top: 1.6rem; left: 0; right: 0; padding: 0 2.6rem; display: flex; justify-content: space-between;
        font: 600 1.4rem/1 var(--font-main); color: #fff; z-index: 4;
      }
      .hphone__icons { width: 6.8rem; height: 1.2rem; }
      .hphone__name {
        position: absolute; top: 5.4rem; left: 2.2rem; z-index: 2; display: flex; align-items: center; gap: .5rem;
        font: 600 1.5rem/1 var(--font-main); color: #fff; text-shadow: 0 1px 6px rgba(0, 0, 0, .25);
      }
      .hphone__name svg { width: 1rem; }
      .hphone__island { position: absolute; top: 1.3rem; left: 50%; transform: translateX(-50%); width: 30%; height: 2.7rem; background: #000; border-radius: 99px; z-index: 3; }

      .hero__mic {
        align-items: flex-end; bottom: 0; display: flex; height: 100%; justify-content: center; left: -25%;
        overflow: hidden; padding: var(--s-sm); position: absolute; width: 150%;
      }
      .hero__micbtn { align-items: center; background: #fff; border-radius: 50%; display: flex; height: 10rem; justify-content: center; position: relative; width: 10rem; }
      @media (max-width: 480px) { .hero__micbtn { height: 6.7rem; width: 6.7rem; } }
      .hero__wave {
        animation: pulse 4s ease-in-out infinite; border: 1px solid #535353; border-radius: 50%;
        height: 100%; left: 0; mix-blend-mode: plus-lighter; position: absolute; top: 0; width: 100%;
      }
      .hero__wave:nth-child(2) { animation-delay: .8s; }
      .hero__wave:nth-child(3) { animation-delay: 1.6s; }
      .hero__wave:nth-child(4) { animation-delay: 2.4s; }
      @keyframes pulse { 0% { opacity: .7; transform: scale(1); } to { opacity: 0; transform: scale(4); } }
      .hero__micicon { color: var(--b2); width: 4.7rem; position: relative; }
      @media (max-width: 480px) { .hero__micicon { width: 3.2rem; } }
      [hidden].hero__bubbles { display: none; }
