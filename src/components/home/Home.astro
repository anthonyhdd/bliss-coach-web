      .ico { flex-shrink: 0; width: 2.2rem; height: 2.2rem; border-radius: 50%; color: #fff; font: 700 1.3rem/2.2rem var(--font-main); text-align: center; }
      .ico--ok { background: #34c759; } .ico--why { background: #ff9500; }

      @media (max-width: 1024px) {
