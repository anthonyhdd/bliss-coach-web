---
// One "Bliss vs X" page, in English (/bliss/vs/<slug>/) or French (/fr/bliss/vs/<slug>/).
// Content: src/config/bliss/vsPages.ts (+ vsPages.fr.ts) — read its header before editing.
import Base from '../../layouts/Base.astro';
import FaqList from '../tutor/FaqList.astro';
import AppStoreButton from '../AppStoreButton.astro';
import { withBase, BLISS_APP_STORE_URL, BLISS_APP_STORE_ID } from '../../config/apps';
import { vsPathLang, vsHubPath, VS_LANGS, type VsLang, type VsPage } from '../../config/bliss/vsPages';
import { TUTORS } from '../../config/bliss/tutors';
import '../../styles/tutor.css';

interface Props {
  page: VsPage;
  others: readonly VsPage[];
  lang: VsLang;
}
const { page, others, lang } = Astro.props;
const pathFor = (p: VsPage) => vsPathLang(p, lang);
const hubPath = vsHubPath(lang);
const otherLangs = VS_LANGS.filter((l) => l !== lang);
const LANG_LABEL: Record<VsLang, string> = { en: 'English', fr: 'Français', es: 'Español' };
const sfx = lang === 'en' ? '' : `-${lang}`;
const url = `https://bliss-coach.com${pathFor(page)}`;
const brandStyle = '--brand-1:#FF6B35;--brand-2:#DB2777;--brand-3:#6366F1;--accent:#DB2777;--on-gradient:#ffffff';
const faces = TUTORS.slice(0, 5);
const face = (p: string) => withBase(`/home/face/${p}.jpg`);
const initial = page.name.charAt(0);

const UI = {
  en: {
    download: 'Download on the App Store',
    chips: ['Explains in your language', '8 tutors, 10 languages', 'Unlimited with Bliss Pro'],
    shot: 'The Bliss app: role-plays with your tutor',
    heroFine: 'Free to download on iPhone · unlimited practice with Bliss Pro',
    faces: 'Sofia, Amélie, Emily, Meilin and four more Bliss tutors',
    comparisons: 'Comparisons',
    verdict: 'Our verdict',
    chooseBliss: 'Choose Bliss if…',
    chooseThem: (n: string) => `${n} may still suit you if…`,
    sideBySide: 'Side by side',
    tableH2: (n: string) => `Bliss and ${n}, feature by feature`,
    tableLead: 'Competitor details reflect their own store listings at the time of writing (October 2026) and can change. We leave prices out on purpose — check both apps for current plans.',
    wins: 'Bliss wins',
    whyBliss: 'Why Bliss',
    whyH2: (n: string) => `Why learners pick Bliss over ${n}`,
    fair: (n: string) => `To be fair to ${n}`,
    faqH2: (n: string) => `Bliss vs ${n}: questions, answered`,
    more: 'More comparisons',
    moreH2: 'Comparing other language apps?',
    learnSpanish: 'Learn Spanish with Bliss',
    ctaH2: 'Try Bliss free',
    ctaP: 'Download Bliss on the App Store, pick a language and a tutor, and say your first sentence today. Bliss Pro gives you every tutor with unlimited practice.',
  },
  fr: {
    download: 'Télécharger sur l’App Store',
    chips: ['Explique en français', '8 profs, 10 langues', 'Illimité avec Bliss Pro'],
    shot: 'L’appli Bliss : jeux de rôle avec votre prof',
    heroFine: 'Téléchargement gratuit sur iPhone · pratique illimitée avec Bliss Pro',
    faces: 'Sofia, Amélie, Emily, Meilin et quatre autres profs Bliss',
    comparisons: 'Comparatifs',
    verdict: 'Notre verdict',
    chooseBliss: 'Choisissez Bliss si…',
    chooseThem: (n: string) => `${n} peut encore vous convenir si…`,
    sideBySide: 'Côte à côte',
    tableH2: (n: string) => `Bliss et ${n}, point par point`,
    tableLead: 'Les informations sur le concurrent reprennent sa propre fiche App Store au moment où nous écrivons (octobre 2026) et peuvent changer. Nous ne citons volontairement aucun prix : vérifiez les offres actuelles dans chaque app.',
    wins: 'Avantage Bliss',
    whyBliss: 'Pourquoi Bliss',
    whyH2: (n: string) => `Pourquoi choisir Bliss plutôt que ${n}`,
    fair: (n: string) => `Pour être juste envers ${n}`,
    faqH2: (n: string) => `Bliss vs ${n} : vos questions`,
    more: 'Autres comparatifs',
    moreH2: 'Vous comparez d’autres applis de langues ?',
    learnSpanish: 'Apprendre l’espagnol avec Bliss (en anglais)',
    ctaH2: 'Essayez Bliss gratuitement',
    ctaP: 'Téléchargez Bliss sur l’App Store, choisissez une langue et un prof, et dites votre première phrase dès aujourd’hui. Bliss Pro vous donne tous les profs, en pratique illimitée.',
  },
  es: {
    download: 'Descargar en la App Store',
    chips: ['Te explica en español', '8 profes, 10 idiomas', 'Ilimitado con Bliss Pro'],
    shot: 'La app Bliss: juegos de rol con tu profe',
    heroFine: 'Descarga gratis en iPhone · práctica ilimitada con Bliss Pro',
    faces: 'Sofia, Amélie, Emily, Meilin y cuatro profes más de Bliss',
    comparisons: 'Comparativas',
    verdict: 'Nuestro veredicto',
    chooseBliss: 'Elige Bliss si…',
    chooseThem: (n: string) => `${n} puede convenirte si…`,
    sideBySide: 'Cara a cara',
    tableH2: (n: string) => `Bliss y ${n}, punto por punto`,
    tableLead: 'Los datos del competidor vienen de su propia ficha de App Store al momento de escribir esto (octubre de 2026) y pueden cambiar. No citamos precios a propósito: revisa los planes actuales en cada app.',
    wins: 'Ventaja Bliss',
    whyBliss: 'Por qué Bliss',
    whyH2: (n: string) => `Por qué elegir Bliss en vez de ${n}`,
    fair: (n: string) => `Para ser justos con ${n}`,
    faqH2: (n: string) => `Bliss vs ${n}: preguntas frecuentes`,
    more: 'Más comparativas',
    moreH2: '¿Comparando otras apps de idiomas?',
    learnSpanish: 'Aprender inglés con Bliss',
    ctaH2: 'Prueba Bliss gratis',
    ctaP: 'Descarga Bliss en la App Store, elige un idioma y un profe, y di tu primera frase hoy mismo. Bliss Pro te da todos los profes con práctica ilimitada.',
  },
} as const;
const t = UI[lang];

const alternates = [
  ...VS_LANGS.map((l) => ({ hreflang: l, href: `https://bliss-coach.com${vsPathLang(page, l)}` })),
  { hreflang: 'x-default', href: `https://bliss-coach.com${vsPathLang(page, 'en')}` },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    inLanguage: lang,
    mainEntity: page.faq.map(({ q, a }) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Bliss Coach', item: 'https://bliss-coach.com/' },
      { '@type': 'ListItem', position: 2, name: 'Bliss', item: 'https://bliss-coach.com/bliss/' },
      { '@type': 'ListItem', position: 3, name: t.comparisons, item: `https://bliss-coach.com${hubPath}` },
      { '@type': 'ListItem', position: 4, name: `Bliss vs ${page.name}`, item: url },
    ],
  },
];
---


<Base
  lang={lang}
  alternates={alternates}
  title={page.title}
  description={page.description}
  appStoreId={BLISS_APP_STORE_ID}
  brandStyle={brandStyle}
  jsonLd={jsonLd}
  activeApp="bliss"
  ogImage="/home/og.png"
>
  <div class="app-bliss vs" style={brandStyle}>
    <section class="vs-hero">
      <div class="container vs-hero-grid">
        <div class="vs-hero-text">
          <nav class="vs-crumb" aria-label="Breadcrumb">
            <a href={withBase('/bliss/')}>Bliss</a> <span aria-hidden="true">/</span>
            <a href={withBase(hubPath)}>{t.comparisons}</a> <span aria-hidden="true">/</span> Bliss vs {page.name}
            <span class="vs-langs">{otherLangs.map((l) => <a class="vs-lang" href={withBase(vsPathLang(page, l))} hreflang={l} lang={l}>{LANG_LABEL[l]}</a>)}</span>
          </nav>
          <div class="vs-matchup" aria-hidden="true">
            <span class="vs-logo"><img src={withBase('/home/pk/bliss-appicon-128.webp')} alt="" width="40" height="40" />Bliss</span>
            <span class="vs-x">vs</span>
            <span class="vs-logo them"><i>{initial}</i>{page.name}</span>
          </div>
          <h1>{page.h1}</h1>
          <p class="sub">{page.intro}</p>
          <div class="vs-hero-cta">
            <AppStoreButton href={BLISS_APP_STORE_URL} placement={`vs-${page.slug}-hero${sfx}`} label={t.download} />
          </div>
          <p class="vs-fine">{t.heroFine}</p>
          <div class="vs-faces">
            <div class="vs-stack" aria-hidden="true">
              {faces.map((tu) => <img src={face(tu.persona)} alt="" width="40" height="40" loading="eager" />)}
            </div>
            <span>{t.faces}</span>
          </div>
        </div>
        <div class="vs-hero-art" aria-hidden="true">
          <div class="vs-phone"><img src={withBase('/home/pk/screen-04.webp')} alt={t.shot} width="780" height="1695" loading="eager" /></div>
          <ul class="vs-chips">
            {t.chips.map((c) => <li><span class="ck">✓</span>{c}</li>)}
          </ul>
        </div>
      </div>
    </section>

    <section class="section container">
      <div class="vs-verdict">
        <div class="vs-verdict-head">
          <img src={withBase('/home/pk/bliss-appicon-128.webp')} alt="" width="44" height="44" />
          <span class="skicker">{t.verdict}</span>
        </div>
        <p>{page.verdict}</p>
      </div>
      <div class="vs-choose">
        <div class="vs-col bliss">
          <h2>{t.chooseBliss}</h2>
          <ul>{page.chooseBliss.map((c) => <li><span class="ck">✓</span><span>{c}</span></li>)}</ul>
        </div>
        <div class="vs-col them">
          <h2>{t.chooseThem(page.name)}</h2>
          <ul>{page.chooseThem.map((c) => <li><span class="dot" aria-hidden="true"></span><span>{c}</span></li>)}</ul>
        </div>
      </div>
    </section>

    <section class="section container">
      <span class="skicker">{t.sideBySide}</span>
      <h2 class="vs-h2">{t.tableH2(page.name)}</h2>
      <div class="vs-table-wrap">
        <table class="vs-table">
          <thead>
            <tr>
              <th scope="col"></th>
              <th scope="col" class="col-bliss"><span class="th-logo"><img src={withBase('/home/pk/bliss-appicon-128.webp')} alt="" width="28" height="28" />Bliss</span></th>
              <th scope="col"><span class="th-logo"><i>{initial}</i>{page.name}</span></th>
            </tr>
          </thead>
          <tbody>
            {page.rows.map((r) => (
              <tr>
                <th scope="row">{r.label}</th>
                <td class={r.win ? 'col-bliss win' : 'col-bliss'}>{r.win && <span class="ck" aria-label={t.wins}>✓</span>}{r.bliss}</td>
                <td>{r.them}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="vs-note">{t.tableLead}</p>
    </section>

    <section class="section container">
      <span class="skicker">{t.whyBliss}</span>
      <h2 class="vs-h2">{t.whyH2(page.name)}</h2>
      <div class="vs-grid">
        {page.blissDifference.map((d, i) => (
          <div class="vs-card"><span class="num">{String(i + 1).padStart(2, '0')}</span><h3>{d.title}</h3><p>{d.body}</p></div>
        ))}
      </div>
    </section>

    <section class="section container">
      <div class="vs-fair">
        <h2>{t.fair(page.name)}</h2>
        <ul>
          {page.theirStrengths.slice(0, 2).map((x) => <li><b>{x.title}.</b> {x.body}</li>)}
        </ul>
      </div>
    </section>

    <section class="section container">
      <span class="skicker">FAQ</span>
      <h2 class="vs-h2">{t.faqH2(page.name)}</h2>
      <FaqList items={page.faq} />
    </section>

    <section class="section container vs-more">
      <span class="skicker">{t.more}</span>
      <h2 class="vs-h2">{t.moreH2}</h2>
      <ul>
        {others.map((o) => (
          <li><a href={withBase(pathFor(o))}><b>Bliss</b> vs {o.name}</a></li>
        ))}
      </ul>
      <p class="vs-more-links">
        {page.related?.map((r) => <a href={withBase(r.href)}>{r.label} →</a>)}
        <a href={withBase(lang === 'es' ? '/bliss/learn-english/' : '/bliss/learn-spanish/')}>{t.learnSpanish} →</a>
      </p>
    </section>

    <section class="section container">
      <div class="vs-final">
        <div class="vs-stack big" aria-hidden="true">
          {TUTORS.slice(0, 8).map((tu) => <img src={face(tu.persona)} alt="" width="56" height="56" loading="lazy" />)}
        </div>
        <h2>{t.ctaH2}</h2>
        <p>{t.ctaP}</p>
        <AppStoreButton href={BLISS_APP_STORE_URL} placement={`vs-${page.slug}-final${sfx}`} label={t.download} />
      </div>
    </section>
  </div>
</Base>

<style>
  .vs-hero { padding: 36px 0 16px; overflow: hidden; }
  .vs-hero-grid { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); gap: 56px; align-items: center; }
  .vs-crumb { font-size: 13px; color: var(--text-dim); margin-bottom: 22px; }
  .vs-crumb a { text-decoration: underline; text-underline-offset: 3px; }
  .vs-matchup { display: inline-flex; align-items: center; gap: 12px; margin-bottom: 20px; padding: 6px 8px; border-radius: 999px; background: var(--bg-raised); border: 1px solid var(--border); box-shadow: 0 6px 20px rgba(14, 26, 58, 0.06); }
  .vs-logo { display: inline-flex; align-items: center; gap: 8px; font-weight: 700; font-size: 15px; padding-right: 6px; }
  .vs-logo img { width: 30px; height: 30px; border-radius: 8px; }
  .vs-logo i, .th-logo i { font-style: normal; display: inline-grid; place-items: center; width: 30px; height: 30px; border-radius: 8px; background: #e9ebf2; color: #5a6480; font-weight: 800; font-size: 14px; }
  .vs-logo.them { color: var(--text-dim); }
  .vs-x { font-size: 12px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.08em; color: #fff; background: linear-gradient(135deg, var(--brand-1), var(--brand-2), var(--brand-3)); border-radius: 999px; padding: 5px 10px; }
  .vs-hero h1 { font-size: clamp(30px, 4.4vw, 50px); line-height: 1.06; letter-spacing: -0.035em; margin-bottom: 18px; }
  .vs-hero .sub { color: var(--text-dim); font-size: 17px; line-height: 1.55; max-width: 58ch; }
  .vs-hero-cta { margin-top: 26px; }
  .vs-fine { margin-top: 10px; font-size: 13px; color: var(--text-dim); }
  .vs-faces { display: flex; align-items: center; gap: 14px; margin-top: 22px; flex-wrap: wrap; }
  .vs-faces span { font-size: 13.5px; color: var(--text-dim); }
  .vs-stack { display: flex; }
  .vs-stack img { width: 40px; height: 40px; border-radius: 50%; object-fit: cover; border: 2.5px solid #fff; box-shadow: 0 2px 8px rgba(14, 26, 58, 0.15); margin-left: -10px; }
  .vs-stack img:first-child { margin-left: 0; }
  .vs-stack.big { justify-content: center; margin-bottom: 18px; }
  .vs-stack.big img { width: 56px; height: 56px; margin-left: -14px; border-width: 3px; }
  .vs-stack.big img:first-child { margin-left: 0; }
  .vs-hero-art { position: relative; display: flex; justify-content: center; padding: 10px 0 20px; }
  .vs-hero-art::before { content: ''; position: absolute; inset: 8% 4% 4%; border-radius: 40px; background: radial-gradient(circle at 30% 30%, color-mix(in srgb, var(--brand-1) 35%, transparent), transparent 60%), radial-gradient(circle at 75% 70%, color-mix(in srgb, var(--brand-3) 35%, transparent), transparent 60%); filter: blur(10px); }
  .vs-phone { position: relative; width: min(236px, 62%); border-radius: 38px; padding: 9px; background: #0e1a3a; box-shadow: 0 30px 70px rgba(14, 26, 58, 0.28); transform: rotate(3deg); }
  .vs-phone img { display: block; width: 100%; height: auto; aspect-ratio: 780 / 1300; object-fit: cover; object-position: top; border-radius: 30px; }
  .vs-chips { position: absolute; left: 0; bottom: 56px; list-style: none; display: flex; flex-direction: column; gap: 10px; }
  .vs-chips li { display: inline-flex; align-items: center; gap: 8px; width: max-content; padding: 10px 14px 10px 10px; border-radius: 999px; background: rgba(255, 255, 255, 0.92); backdrop-filter: blur(8px); box-shadow: 0 10px 30px rgba(14, 26, 58, 0.14); font-size: 14px; font-weight: 600; }
  .vs-chips li:nth-child(2) { margin-left: 22px; }
  .vs-chips li:nth-child(3) { margin-left: 6px; }
  .ck { flex: 0 0 auto; display: inline-grid; place-items: center; width: 20px; height: 20px; border-radius: 50%; background: linear-gradient(135deg, var(--brand-1), var(--brand-2)); color: #fff; font-size: 11px; font-weight: 800; }
  .vs-langs { display: inline-flex; gap: 10px; margin-left: 14px; padding-left: 14px; border-left: 1px solid var(--border); }
  .vs-lang { font-size: 13px; font-weight: 600; color: var(--text-dim); text-decoration: underline; text-underline-offset: 3px; }

  .vs-h2 { font-size: clamp(24px, 3.2vw, 34px); letter-spacing: -0.025em; margin-bottom: 24px; }
  .vs-verdict { position: relative; padding: 28px 30px; border-radius: 24px; color: #fff; background: linear-gradient(120deg, var(--brand-1), var(--brand-2) 55%, var(--brand-3)); box-shadow: 0 20px 50px color-mix(in srgb, var(--brand-2) 30%, transparent); }
  .vs-verdict-head { display: flex; align-items: center; gap: 12px; margin-bottom: 12px; }
  .vs-verdict-head img { width: 44px; height: 44px; border-radius: 12px; box-shadow: 0 4px 14px rgba(0, 0, 0, 0.18); }
  .vs-verdict .skicker { color: #fff; opacity: 0.9; margin: 0; }
  .vs-verdict p { font-size: clamp(17px, 2vw, 20px); line-height: 1.5; font-weight: 500; max-width: 70ch; }
  .vs-choose { display: grid; grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr); gap: 18px; margin-top: 18px; }
  .vs-col { border-radius: 20px; padding: 24px; }
  .vs-col h2 { font-size: 19px; margin-bottom: 14px; letter-spacing: -0.01em; }
  .vs-col ul { list-style: none; display: flex; flex-direction: column; gap: 12px; }
  .vs-col li { display: flex; gap: 10px; align-items: flex-start; font-size: 15px; line-height: 1.45; }
  .vs-col li .ck { margin-top: 1px; }
  .vs-col.bliss { background: var(--bg-raised); border: 1px solid color-mix(in srgb, var(--brand-2) 25%, transparent); box-shadow: 0 10px 30px rgba(14, 26, 58, 0.06); }
  .vs-col.them { background: transparent; border: 1px dashed var(--border); }
  .vs-col.them h2 { font-size: 15px; color: var(--text-dim); }
  .vs-col.them li { font-size: 14px; color: var(--text-dim); }
  .dot { flex: 0 0 auto; width: 6px; height: 6px; border-radius: 50%; background: #b7bdcc; margin: 8px 7px 0; }

  .vs-table-wrap { overflow-x: auto; border-radius: 20px; background: var(--bg-raised); border: 1px solid var(--border); box-shadow: 0 10px 30px rgba(14, 26, 58, 0.05); }
  .vs-table { width: 100%; border-collapse: collapse; font-size: 15px; min-width: 600px; }
  .vs-table th, .vs-table td { text-align: left; vertical-align: top; padding: 16px 18px; border-bottom: 1px solid var(--border); line-height: 1.45; }
  .vs-table tbody tr:last-child th, .vs-table tbody tr:last-child td { border-bottom: 0; }
  .vs-table thead th { padding-top: 18px; padding-bottom: 14px; }
  .th-logo { display: inline-flex; align-items: center; gap: 8px; font-size: 15px; font-weight: 700; }
  .th-logo img { width: 28px; height: 28px; border-radius: 8px; }
  .th-logo i { width: 28px; height: 28px; font-size: 13px; }
  .vs-table tbody th { font-weight: 600; width: 20%; color: var(--text-dim); font-size: 14px; }
  .vs-table .col-bliss { background: color-mix(in srgb, var(--brand-2) 5%, transparent); width: 42%; }
  .vs-table td.win { font-weight: 600; }
  .vs-table td .ck { margin-right: 8px; vertical-align: -4px; }
  .vs-table td:last-child { color: var(--text-dim); }
  .vs-note { margin-top: 12px; font-size: 13px; color: var(--text-dim); max-width: 80ch; }

  .vs-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 18px; }
  .vs-card { background: var(--bg-raised); border: 1px solid var(--border); border-radius: 20px; padding: 24px; box-shadow: 0 10px 30px rgba(14, 26, 58, 0.05); }
  .vs-card .num { display: block; font-size: 30px; font-weight: 800; letter-spacing: -0.03em; background: linear-gradient(135deg, var(--brand-1), var(--brand-3)); -webkit-background-clip: text; background-clip: text; color: transparent; margin-bottom: 8px; }
  .vs-card h3 { font-size: 18px; margin-bottom: 8px; letter-spacing: -0.01em; }
  .vs-card p { color: var(--text-dim); font-size: 15px; line-height: 1.5; }

  .vs-fair { padding: 20px 24px; border-radius: 16px; background: rgba(14, 26, 58, 0.03); max-width: 820px; }
  .vs-fair h2 { font-size: 16px; margin-bottom: 8px; color: var(--text-dim); }
  .vs-fair ul { padding-left: 18px; display: flex; flex-direction: column; gap: 6px; }
  .vs-fair li { font-size: 14px; color: var(--text-dim); line-height: 1.5; }

  .vs-more ul { list-style: none; display: flex; flex-wrap: wrap; gap: 10px; }
  .vs-more ul a { display: inline-block; padding: 10px 16px; border-radius: 999px; background: var(--bg-raised); border: 1px solid var(--border); font-size: 15px; transition: border-color 0.15s, transform 0.15s; }
  .vs-more ul a:hover { border-color: color-mix(in srgb, var(--brand-2) 50%, transparent); transform: translateY(-1px); }
  .vs-more-links { display: flex; flex-wrap: wrap; gap: 8px 20px; margin-top: 18px; font-size: 14px; }
  .vs-more-links a { font-weight: 600; text-decoration: underline; text-underline-offset: 3px; }

  .vs-final { text-align: center; padding: 44px 24px; border-radius: 28px; background: var(--bg-raised); border: 1px solid var(--border); box-shadow: 0 20px 50px rgba(14, 26, 58, 0.07); }
  .vs-final h2 { font-size: clamp(26px, 3.4vw, 36px); letter-spacing: -0.03em; margin-bottom: 10px; }
  .vs-final p { color: var(--text-dim); max-width: 56ch; margin: 0 auto 24px; }

