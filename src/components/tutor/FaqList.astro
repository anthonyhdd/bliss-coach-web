---
// Visible FAQ. The page emits FAQPage JSON-LD from the SAME array, so markup always mirrors content.
import '../../styles/tutor.css';

interface Props {
  items: { q: string; a: string }[];
}
const { items } = Astro.props;
---

<div class="tfaq">
  {items.map((f, i) => (
    <details open={i === 0}>
      <summary>{f.q}</summary>
      <p>{f.a}</p>
    </details>
  ))}
</div>
