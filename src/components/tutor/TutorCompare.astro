---
// "Private tutor vs the app" — the price anchor, without a hard price claim (prices vary by
// country and rot on a static page).
// Below 640px the table stacks into one card per row and the column names move into each cell via
// `data-col` — a 520px-wide table on a 390px phone cut the app's column (the whole point of the
// comparison) off-screen behind a scroll nobody could see.
import '../../styles/tutor.css';

interface Props {
  name: string;
  rows: [string, string, string][];
}
const { name, rows } = Astro.props;
---

<div class="tcmp-wrap">
  <table class="tcmp">
    <thead>
      <tr>
        <th scope="col"><span class="sr-only">Compared on</span></th>
        <th scope="col" class="them">Private tutor</th>
        <th scope="col" class="us">{name}</th>
      </tr>
    </thead>
    <tbody>
      {rows.map(([label, them, us]) => (
        <tr>
          <th scope="row">{label}</th>
          <td class="them" data-col="Private tutor">{them}</td>
          <td class="us" data-col={name}>{us}</td>
        </tr>
      ))}
    </tbody>
  </table>
</div>
