---
// Consent banner for the paid funnel — the only pages that carry advertising trackers.
//
// WHY IT EXISTS
// The funnel is bought with ads in France. The CNIL requires a visitor's agreement BEFORE any
// advertising or audience tracker runs, and it sanctions exactly the pattern of loading Meta or
// TikTok on arrival. So on these pages nothing tracks until the visitor says yes: the tracker
// components only define loaders (`__blissLoadGA`, `__blissLoadMeta`, `__blissLoadTikTok`) and this
// banner is what calls them.
//
// THE RULES IT FOLLOWS (CNIL guidelines and recommendations on cookies, 2020)
//   - "Tout refuser" is exactly as visible and as easy as "Tout accepter": same button, same place.
//   - Nothing is pre-ticked; the per-purpose choice is behind "Personnaliser".
//   - No cookie wall: the funnel works the same, underneath, whatever the answer.
//   - The choice is kept 6 months, then asked again — a refusal included, so it is not re-asked on
//     every visit either.
//   - Withdrawing is as easy as agreeing: every funnel page carries a "Cookies" link that reopens
//     this. A script cannot be unloaded, so a withdrawal clears the trackers' cookies and reloads.
//
// What it does NOT gate: RevenueCat and Supabase, which are the purchase and the account themselves
// (strictly necessary to the service the visitor asked for), and `web_funnel_profiles`, first-party
// data written against the visitor's own account. The revenue truth never depends on this banner.
---

<div class="bc" id="bliss-consent" role="dialog" aria-modal="false" aria-labelledby="bc-title" hidden>
  <div class="bc-card">
    <p class="bc-title" id="bc-title" data-bc="title">Cookies et publicité</p>
    <p class="bc-body" data-bc="body"></p>

    <div class="bc-prefs" data-bc-prefs hidden>
      <label class="bc-row" for="bc-analytics">
        <input type="checkbox" id="bc-analytics" />
        <span><b data-bc="analytics"></b><i data-bc="analyticsDesc"></i></span>
      </label>
      <label class="bc-row" for="bc-ads">
        <input type="checkbox" id="bc-ads" />
        <span><b data-bc="ads"></b><i data-bc="adsDesc"></i></span>
      </label>
    </div>

    <div class="bc-actions" data-bc-main>
      <button type="button" class="bc-btn" data-bc-action="refuse" data-bc="refuse"></button>
      <button type="button" class="bc-btn" data-bc-action="accept" data-bc="accept"></button>
    </div>
    <div class="bc-actions" data-bc-save hidden>
      <button type="button" class="bc-btn bc-wide" data-bc-action="save" data-bc="save"></button>
    </div>

    <p class="bc-links">
      <button type="button" class="bc-link" data-bc-action="customize" data-bc="customize"></button>
      <span aria-hidden="true">·</span>
      <a class="bc-link" href="/privacy/" data-bc="privacy"></a>
    </p>
  </div>
</div>

<style>
  /* A rule that sets `display` beats the UA rule behind `hidden` — the prefs panel and the save
     row showed on first open. One rule, for the whole banner. */
  .bc [hidden], .bc[hidden] { display: none !important; }

  .bc {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 1000;
    display: flex;
    justify-content: center;
    padding: 0 12px calc(12px + env(safe-area-inset-bottom, 0px));
    pointer-events: none;
  }
  .bc-card {
    pointer-events: auto;
    width: 100%;
    max-width: 480px;
    padding: 18px 18px 14px;
    border-radius: 22px;
    background: #ffffff;
    color: #0e1a3a;
    border: 1px solid rgba(14, 26, 58, 0.1);
    box-shadow: 0 18px 50px rgba(14, 26, 58, 0.22);
    font-family: Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  }
  .bc-title { margin: 0 0 6px; font-size: 16px; font-weight: 800; letter-spacing: -0.01em; }
  .bc-body { margin: 0; font-size: 13.5px; line-height: 1.5; color: #5a6480; }

  .bc-prefs { display: flex; flex-direction: column; gap: 8px; margin-top: 12px; }
  .bc-row {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 10px;
    align-items: start;
    padding: 10px 12px;
    border-radius: 14px;
    background: #f5f7fb;
    cursor: pointer;
  }
  .bc-row input { width: 18px; height: 18px; margin: 2px 0 0; accent-color: #0e1a3a; }
  .bc-row b { display: block; font-size: 13.5px; font-weight: 700; }
  .bc-row i { display: block; font-style: normal; font-size: 12.5px; line-height: 1.45; color: #5a6480; }

  /* Refuse and accept are the SAME button — same size, same colour, side by side. */
  .bc-actions { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-top: 14px; }
  .bc-btn {
    height: 46px;
    border: 0;
    border-radius: 999px;
    background: #0e1a3a;
    color: #ffffff;
    font: inherit;
    font-size: 14.5px;
    font-weight: 700;
    cursor: pointer;
  }
  .bc-btn:focus-visible, .bc-link:focus-visible { outline: 2px solid #6a5bff; outline-offset: 2px; }
  .bc-wide { grid-column: 1 / -1; }

  .bc-links {
    display: flex;
    justify-content: center;
    gap: 8px;
    margin: 10px 0 0;
    font-size: 12.5px;
    color: #8a93ad;
  }
  .bc-link {
    padding: 0;
    border: 0;
    background: none;
    color: #5a6480;
    font: inherit;
    text-decoration: underline;
    cursor: pointer;
  }
</style>

<script is:inline>
  (function () {
    var root = document.getElementById('bliss-consent');
    if (!root || root.dataset.ready === '1') return;
    root.dataset.ready = '1';

    var KEY = 'bliss_consent_v1';
    // CNIL: keep the choice for 6 months, then ask again — a refusal included.
    var MAX_AGE = 182 * 24 * 60 * 60 * 1000;

    var fr = /^fr\b/i.test(navigator.language || '');
    var T = fr
      ? {
          title: 'Cookies et publicité',
          body:
            "Avec ton accord, nous mesurons l'audience de cette page (Google Analytics) et l'efficacité de nos publicités (Meta, TikTok). Tu peux refuser : le parcours fonctionne exactement pareil. Ton choix est gardé 6 mois et se change à tout moment via « Cookies ».",
          refuse: 'Tout refuser',
          accept: 'Tout accepter',
          customize: 'Personnaliser',
          save: 'Enregistrer mes choix',
          privacy: 'Confidentialité',
          analytics: "Mesure d'audience",
          analyticsDesc: 'Google Analytics : quelles étapes du parcours sont vues.',
          ads: 'Publicité',
          adsDesc: "Meta et TikTok : savoir quelle publicité t'a amené ici.",
        }
      : {
          title: 'Cookies and advertising',
          body:
            'With your consent, we measure how this page is used (Google Analytics) and how well our ads work (Meta, TikTok). You can say no: everything works exactly the same. Your choice is kept for 6 months and can be changed any time via “Cookies”.',
          refuse: 'Reject all',
          accept: 'Accept all',
          customize: 'Customise',
          save: 'Save my choices',
          privacy: 'Privacy',
          analytics: 'Audience measurement',
          analyticsDesc: 'Google Analytics: which steps of the flow are seen.',
          ads: 'Advertising',
          adsDesc: 'Meta and TikTok: knowing which ad brought you here.',
        };
    root.querySelectorAll('[data-bc]').forEach(function (el) {
      var k = el.getAttribute('data-bc');
      if (T[k]) el.textContent = T[k];
    });

    var prefs = root.querySelector('[data-bc-prefs]');
    var main = root.querySelector('[data-bc-main]');
    var saveRow = root.querySelector('[data-bc-save]');
    var boxA = document.getElementById('bc-analytics');
    var boxB = document.getElementById('bc-ads');

    function read() {
      try {
        var c = JSON.parse(localStorage.getItem(KEY) || 'null');
        if (c && c.v === 1 && typeof c.at === 'number' && Date.now() - c.at < MAX_AGE) return c;
      } catch (e) {}
      return null;
    }
    function write(c) {
      try {
        localStorage.setItem(KEY, JSON.stringify(c));
      } catch (e) {
        /* private mode: the choice holds for this page view only */
      }
    }

    function apply(c) {
      if (c.analytics && window.__blissLoadGA) window.__blissLoadGA();
      if (c.ads) {
        if (window.__blissLoadMeta) window.__blissLoadMeta();
        if (window.__blissLoadTikTok) window.__blissLoadTikTok();
      }
    }

    // A loaded script cannot be unloaded: on a withdrawal, clear what the trackers set and reload.
    function clearTrackerCookies() {
      var names = document.cookie.split(';').map(function (p) { return p.split('=')[0].trim(); });
      var host = location.hostname;
      var domains = ['', host, '.' + host.replace(/^www\./, '')];
      names
        .filter(function (n) { return /^(_fbp|_fbc|_ttp|_tt_enable_cookie|_ga|_ga_.*|_gid|_gcl_.*)$/.test(n); })
        .forEach(function (n) {
          domains.forEach(function (d) {
            document.cookie = n + '=; Max-Age=0; path=/' + (d ? '; domain=' + d : '');
          });
        });
    }

    function show(withPrefs) {
      var c = read();
      boxA.checked = !!(c && c.analytics);
      boxB.checked = !!(c && c.ads);
      prefs.hidden = !withPrefs;
      saveRow.hidden = !withPrefs;
      main.hidden = !!withPrefs;
      root.hidden = false;
    }
    function hide() {
      root.hidden = true;
    }

    function decide(analytics, ads) {
      var loaded = !!(window.__ga4Booted || window.__metaPixel || window.__tiktokPixel);
      var c = { v: 1, analytics: !!analytics, ads: !!ads, at: Date.now() };
      write(c);
      hide();
      var gaWithdrawn = window.__ga4Booted && !c.analytics;
      var adsWithdrawn = (window.__metaPixel || window.__tiktokPixel) && !c.ads;
      if (loaded && (gaWithdrawn || adsWithdrawn)) {
        clearTrackerCookies();
        location.reload();
        return;
      }
      apply(c);
    }

    root.addEventListener('click', function (e) {
      var btn = e.target.closest ? e.target.closest('[data-bc-action]') : null;
      if (!btn) return;
      var action = btn.getAttribute('data-bc-action');
      if (action === 'refuse') decide(false, false);
      else if (action === 'accept') decide(true, true);
      else if (action === 'save') decide(boxA.checked, boxB.checked);
      else if (action === 'customize') show(true);
    });

    // Every funnel page carries a "Cookies" link: withdrawing is as easy as agreeing.
    document.addEventListener('click', function (e) {
      var t = e.target.closest ? e.target.closest('[data-consent-open]') : null;
      if (!t) return;
      e.preventDefault();
      show(true);
    });

    var existing = read();
    if (existing) apply(existing);
    else show(false);
  })();
</script>
