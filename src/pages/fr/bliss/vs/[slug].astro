---
// /fr/bliss/vs/<competitor>/ — French "Bliss vs X" pages. Content: src/config/bliss/vsPages.fr.ts
import VsPage from '../../../../components/bliss/VsPage.astro';
import type { VsPage as VsPageData } from '../../../../config/bliss/vsPages';
import { VS_PAGES_FR } from '../../../../config/bliss/vsPages.fr';

export function getStaticPaths() {
  return VS_PAGES_FR.map((page) => ({ params: { slug: page.slug }, props: { page } }));
}
const { page } = Astro.props as { page: VsPageData };
---

<VsPage page={page} others={VS_PAGES_FR.filter((p) => p.slug !== page.slug)} lang="fr" />
