---
// /bliss/vs/<competitor>/ — English "Bliss vs X" pages. Markup: src/components/bliss/VsPage.astro
import VsPage from '../../../components/bliss/VsPage.astro';
import { VS_PAGES, type VsPage as VsPageData } from '../../../config/bliss/vsPages';

export function getStaticPaths() {
  return VS_PAGES.map((page) => ({ params: { slug: page.slug }, props: { page } }));
}
const { page } = Astro.props as { page: VsPageData };
---

<VsPage page={page} others={VS_PAGES.filter((p) => p.slug !== page.slug)} lang="en" />
