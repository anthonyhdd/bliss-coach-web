---
// /bliss/vs/ — hub of the "Bliss vs X" comparisons (src/config/bliss/vsPages.ts).
import Base from '../../../layouts/Base.astro';
import AppStoreButton from '../../../components/AppStoreButton.astro';
import { withBase, BLISS_APP_STORE_URL, BLISS_APP_STORE_ID } from '../../../config/apps';
import { VS_PAGES, vsPath } from '../../../config/bliss/vsPages';
import '../../../styles/tutor.css';

const brandStyle = '--brand-1:#FF6B35;--brand-2:#DB2777;--brand-3:#6366F1;--accent:#DB2777;--on-gradient:#ffffff';
const url = 'https://bliss-coach.com/bliss/vs/';
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'Bliss compared with other language learning apps',
    itemListElement: VS_PAGES.map((p, i) => ({ '@type': 'ListItem', position: i + 1, name: `Bliss vs ${p.name}`, url: `https://bliss-coach.com${vsPath(p)}` })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Bliss Coach', item: 'https://bliss-coach.com/' },
      { '@type': 'ListItem', position: 2, name: 'Bliss', item: 'https://bliss-coach.com/bliss/' },
      { '@type': 'ListItem', position: 3, name: 'Comparisons', item: url },
    ],
  },
];
---

<Base
  title="Bliss vs Other Language Apps: Honest Comparisons"
  description="How Bliss compares with Praktika, Speak, Learna, Duolingo, Babbel, TalkPal, Langua and Univerbal — and why learners who want to speak pick Bliss."
  appStoreId={BLISS_APP_STORE_ID}
  brandStyle={brandStyle}
  jsonLd={jsonLd}
  activeApp="bliss"
  ogImage="/home/og.png"
>
  <div class="app-bliss" style={brandStyle}>
    <section class="section container">
      <span class="skicker">Comparisons</span>
      <h1 class="hub-h1">Bliss vs other language learning apps</h1>
      <p class="lead">Side-by-side comparisons with the AI tutors and language apps learners ask us about. Short version: if you want to actually speak, talk to a tutor who explains in your language and corrects you live.</p>
      <ul class="hub-list">
        {VS_PAGES.map((p) => (
          <li>
            <a href={withBase(vsPath(p))}>
              <b>Bliss vs {p.name}</b>
              <span>{p.description}</span>
            </a>
          </li>
        ))}
      </ul>
      <div class="hub-cta"><AppStoreButton href={BLISS_APP_STORE_URL} placement="vs-hub" /></div>
    </section>
  </div>
</Base>

<style>
  .hub-h1 { font-size: clamp(30px, 4.6vw, 48px); line-height: 1.08; letter-spacing: -0.03em; margin-bottom: 16px; }
  .hub-list { list-style: none; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; }
  .hub-list a { display: flex; flex-direction: column; gap: 6px; padding: 18px 20px; border: 1px solid var(--border); border-radius: var(--radius); background: var(--bg-raised); height: 100%; }
  .hub-list a:hover { border-color: color-mix(in srgb, var(--accent) 50%, transparent); }
  .hub-list b { font-size: 18px; }
  .hub-list span { font-size: 14.5px; color: var(--text-dim); }
  .hub-cta { margin-top: 32px; }
  @media (max-width: 860px) { .hub-list { grid-template-columns: 1fr; } }
</style>
