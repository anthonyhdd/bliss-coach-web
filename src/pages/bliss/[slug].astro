---
// /bliss/learn-<language>/ — one page per language Bliss teaches. Content: src/config/bliss/learnPages.ts
// (read its header before editing: distinct content per language, no ratings, no learner counts).
import Base from '../../layouts/Base.astro';
import FaqList from '../../components/tutor/FaqList.astro';
import AppStoreButton from '../../components/AppStoreButton.astro';
import { withBase, BLISS_APP_STORE_URL, BLISS_APP_STORE_ID } from '../../config/apps';
import { LEARN_PAGES, learnPath, type LearnPage } from '../../config/bliss/learnPages';
import { recommendedTutor, TUTORS } from '../../config/bliss/tutors';
import '../../styles/tutor.css';

export function getStaticPaths() {
  return LEARN_PAGES.map((page) => ({ params: { slug: `learn-${page.slug}` }, props: { page } }));
}

const { page } = Astro.props as { page: LearnPage };
const tutor = recommendedTutor(page.code);
const url = `https://bliss-coach.com${learnPath(page)}`;
const brandStyle = `--brand-1:${tutor.gradient[0]};--brand-2:${tutor.gradient[1]};--brand-3:${tutor.gradient[2]};--accent:${tutor.accent};--on-gradient:#ffffff`;
const others = LEARN_PAGES.filter((p) => p.code !== page.code);
const phraseLang = page.code === 'zh' ? 'zh-Hans' : page.code;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'Bliss',
    operatingSystem: 'iOS',
    applicationCategory: 'EducationApplication',
    description: `Language learning app with AI tutors you talk to. Learn ${page.name} out loud, explained in your own language and corrected as you go.`,
    url,
    installUrl: BLISS_APP_STORE_URL,
    author: { '@type': 'Organization', name: 'Bliss Coach', url: 'https://bliss-coach.com/' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: page.faq.map(({ q, a }) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Bliss Coach', item: 'https://bliss-coach.com/' },
      { '@type': 'ListItem', position: 2, name: 'Bliss', item: 'https://bliss-coach.com/bliss/' },
      { '@type': 'ListItem', position: 3, name: `Learn ${page.name}`, item: url },
    ],
  },
];
---

<Base
  title={page.title}
  description={page.description}
  appStoreId={BLISS_APP_STORE_ID}
  brandStyle={brandStyle}
  jsonLd={jsonLd}
  activeApp="bliss"
  ogImage={`/home/${tutor.photo}`}
>
  <div class="app-bliss learn" style={brandStyle}>
    <section class="learn-hero">
      <div class="container learn-hero-inner">
        <div class="pitch">
          <nav class="learn-crumb" aria-label="Breadcrumb">
            <a href={withBase('/bliss/')}>Bliss</a> <span aria-hidden="true">/</span> Learn {page.name}
          </nav>
          <span class="skicker" lang={page.code} dir={page.rtl ? 'rtl' : undefined}>{page.endonym}</span>
          <h1>{page.h1}</h1>
          <p class="sub">{page.intro}</p>
          <div class="hero-cta hero-cta-row">
            <AppStoreButton href={BLISS_APP_STORE_URL} placement={`learn-${page.code}-hero`} />
            <a class="btn btn-ghost" href="#phrases">Starter phrases</a>
          </div>
          <p class="fine">Free to download on iPhone. Plans and prices are shown in the app before you pay anything.</p>
        </div>
        <figure class="learn-tutor" style={`--c:${tutor.accent}`}>
          <img src={withBase(`/home/${tutor.photo}`)} alt={`${tutor.name}, Bliss AI tutor for ${page.name}`} width="320" height="400" loading="eager" />
          <figcaption>
            <b>{tutor.name}</b>
            <span>{tutor.traits.join(' · ')}</span>
          </figcaption>
        </figure>
      </div>
    </section>

    <section class="section container">
      <span class="skicker">Why learn {page.name}</span>
      <h2>What makes {page.name} worth it — and what makes it hard</h2>
      <div class="learn-grid">
        {page.why.map((w) => (
          <div class="learn-card">
            <h3>{w.title}</h3>
            <p>{w.body}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="section container">
      <span class="skicker">How Bliss teaches {page.name}</span>
      <h2>A tutor you talk to, focused on what trips {page.name} learners up</h2>
      <p class="lead">
        In every language, your Bliss tutor explains in the language you already speak, has you say the {page.name} out
        loud, and corrects the sentence you just said. For {page.name} specifically:
      </p>
      <div class="learn-grid">
        {page.how.map((h) => (
          <div class="learn-card">
            <h3>{h.title}</h3>
            <p>{h.body}</p>
          </div>
        ))}
      </div>
      <div class="learn-tutor-note">
        <img src={withBase(`/home/${tutor.photo}`)} alt="" width="56" height="56" loading="lazy" />
        <p>{page.tutorNote}</p>
      </div>
      <div class="learn-faces" aria-label="The eight Bliss tutors">
        {TUTORS.map((t) => (
          <img src={withBase(`/home/${t.photo}`)} alt={t.name} title={t.name} width="40" height="40" loading="lazy" />
        ))}
      </div>
    </section>

    <section class="section container" id="phrases">
      <span class="skicker">Starter phrases</span>
      <h2>{page.name} phrases for your first week</h2>
      <p class="lead">{page.phrasesIntro}</p>
      <ol class="learn-phrases">
        {page.phrases.map((p) => (
          <li>
            <span class="ph-text" lang={phraseLang} dir={page.rtl ? 'rtl' : undefined}>{p.text}</span>
            {p.say && <span class="ph-say">{p.say}</span>}
            <span class="ph-meaning">{p.meaning}</span>
            {p.note && <span class="ph-note">{p.note}</span>}
          </li>
        ))}
      </ol>
    </section>

    {page.related && page.related.length > 0 && (
      <section class="section container learn-related">
        <span class="skicker">Keep going</span>
        <h2>More {page.name} on this site</h2>
        <ul>
          {page.related.map((r) => (
            <li><a href={withBase(r.href)}>{r.label} →</a></li>
          ))}
        </ul>
      </section>
    )}

    <section class="section container">
      <span class="skicker">FAQ</span>
      <h2>Learning {page.name} with Bliss: questions, answered</h2>
      <FaqList items={page.faq} />
    </section>

    <section class="section container">
      <span class="skicker">Ten languages, one app</span>
      <h2>Learning more than one language?</h2>
      <p class="lead">Bliss teaches ten languages with the same tutors. Switch language whenever you want — no second app, no restart.</p>
      <ul class="learn-langs">
        {others.map((o) => (
          <li>
            <a href={withBase(learnPath(o))}>
              <span lang={o.code} dir={o.rtl ? 'rtl' : undefined}>{o.endonym}</span>
              <b>Learn {o.name}</b>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <section class="cta-band">
      <div class="container inner-cta">
        <img src={withBase(`/home/${tutor.photo}`)} alt="" width="72" height="72" loading="lazy" />
        <div class="txt">
          <h2>Start speaking {page.name} today</h2>
          <p>Download Bliss free on the App Store, pick {page.name}, and say your first sentence to {tutor.name}.</p>
        </div>
        <AppStoreButton href={BLISS_APP_STORE_URL} placement={`learn-${page.code}-final`} />
      </div>
    </section>
  </div>
</Base>

<style>
  .learn-hero { padding: 56px 0 24px; }
  .learn-hero-inner { display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr); gap: 48px; align-items: center; }
  .learn-hero h1 { font-size: clamp(32px, 5vw, 50px); line-height: 1.08; letter-spacing: -0.03em; margin-bottom: 18px; }
  .learn-hero .sub { color: var(--text-dim); font-size: 17px; max-width: 60ch; margin-bottom: 26px; }
  .learn-hero .hero-cta-row { display: flex; flex-wrap: wrap; gap: 12px; }
  .learn-hero .fine { margin-top: 14px; font-size: 13px; color: var(--text-dim); }
  .learn-crumb { font-size: 13px; color: var(--text-dim); margin-bottom: 16px; }
  .learn-crumb a { text-decoration: underline; text-underline-offset: 3px; }
  .learn-tutor { position: relative; border-radius: 24px; overflow: hidden; box-shadow: 0 24px 60px color-mix(in srgb, var(--c) 28%, transparent); max-width: 340px; justify-self: center; }
  .learn-tutor img { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; object-position: top center; }
  .learn-tutor figcaption { position: absolute; left: 0; right: 0; bottom: 0; padding: 40px 18px 16px; background: linear-gradient(transparent, rgba(0, 0, 0, 0.72)); color: #fff; display: flex; flex-direction: column; }
  .learn-tutor figcaption b { font-size: 20px; }
  .learn-tutor figcaption span { font-size: 13px; opacity: 0.85; }
  .learn-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 18px; margin-top: 24px; }
  .learn-card { background: var(--bg-raised); border: 1px solid var(--border); border-radius: var(--radius); padding: 22px; }
  .learn-card h3 { font-size: 17px; margin-bottom: 8px; letter-spacing: -0.01em; }
  .learn-card p { color: var(--text-dim); font-size: 15px; }
  .learn-tutor-note { display: flex; gap: 14px; align-items: center; margin-top: 28px; padding: 16px 18px; border-radius: var(--radius); background: color-mix(in srgb, var(--accent) 8%, var(--bg-raised)); max-width: 780px; }
  .learn-tutor-note img { width: 56px; height: 56px; border-radius: 50%; object-fit: cover; object-position: top; flex: 0 0 auto; }
  .learn-tutor-note p { font-size: 15px; }
  .learn-faces { display: flex; gap: 6px; margin-top: 16px; flex-wrap: wrap; }
  .learn-faces img { width: 40px; height: 40px; border-radius: 50%; object-fit: cover; object-position: top; border: 2px solid var(--bg-raised); }
  .learn-phrases { list-style: none; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; counter-reset: ph; }
  .learn-phrases li { background: var(--bg-raised); border: 1px solid var(--border); border-radius: var(--radius); padding: 16px 18px; display: flex; flex-direction: column; gap: 2px; }
  .ph-text { font-size: 20px; font-weight: 700; letter-spacing: -0.01em; }
  .ph-say { font-size: 14px; color: color-mix(in srgb, var(--accent) 85%, #0e1a3a); font-style: italic; }
  .ph-meaning { font-size: 15px; }
  .ph-note { font-size: 13.5px; color: var(--text-dim); margin-top: 4px; }
  .learn-related ul { list-style: none; display: flex; flex-direction: column; gap: 10px; margin-top: 16px; }
  .learn-related a { font-weight: 600; text-decoration: underline; text-underline-offset: 3px; }
  .learn-langs { list-style: none; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; }
  .learn-langs a { display: flex; flex-direction: column; padding: 14px 16px; border: 1px solid var(--border); border-radius: var(--radius); background: var(--bg-raised); }
  .learn-langs a:hover { border-color: color-mix(in srgb, var(--accent) 50%, transparent); }
  .learn-langs span { font-size: 13px; color: var(--text-dim); }
  .learn-langs b { font-size: 16px; }
  .cta-band .inner-cta img { border-radius: 50%; object-fit: cover; object-position: top; }
  @media (max-width: 860px) {
    .learn-hero-inner { grid-template-columns: 1fr; gap: 32px; }
    .learn-grid { grid-template-columns: 1fr; }
    .learn-phrases { grid-template-columns: 1fr; }
    .learn-langs { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
</style>
