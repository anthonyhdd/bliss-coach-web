---
// /start/ — the paid funnel, running the app's OWN onboarding.
//
// The flow, its copy and its vocabulary grids are ported from Bliss (src/config/bliss/*, mirrored
// from the APPSOFIA repo). v1 of this page was a Praktika-shaped quiz of questions and pitch
// screens; the founder's verdict on 2026-09-17 was that it sold a product the visitor had not met.
// Here the visitor picks a teacher and measures their own vocabulary BEFORE seeing a price, and the
// answers are handed to the app so the onboarding is never run twice. See src/config/funnel.ts.
//
// `bare` (no header, no footer) and `noindex`: there is no way out but forward or back, and the page
// must not rank as a thin duplicate of the landings and split their organic signal.
//
// Every screen is in this one document and switched client-side — each avoided navigation is
// conversion that does not leak. The hash still changes per screen so the back button works and GA4
// sees the progression. What cannot be static (the tutors of a language, the grid of a language,
// the goals of a language) is built by the script from the same config.
import Base from '../../layouts/Base.astro';
import { FUNNELS, DEFAULT_FUNNEL, isCheckoutConfigured } from '../../config/funnel';
import { APPS } from '../../config/apps';
import { COPY } from '../../config/bliss/onboarding';
import '../../styles/funnel.css';

const funnel = FUNNELS[DEFAULT_FUNNEL];
const app = APPS[funnel.app] ?? APPS.sofia;
const checkoutReady = isCheckoutConfigured();

// Bliss's own colour (the violet of the site's hero), not a single tutor's: the tutor's colour takes
// over from the moment one is picked, set on the root as --tutor-* by the script.
const brandStyle =
  '--brand-1:#4B45D6;--brand-2:#6A5BFF;--brand-3:#B9A4FF;--accent:#6A5BFF;--on-gradient:#ffffff';
---

<Base
  title="Speak a language for real — Bliss"
  description="Pick your language and your tutor, measure where you stand, and start speaking."
  bare
  noindex
  pixels
  brandStyle={brandStyle}
  bodyClass="funnel-body"
>
  <div
    class="fnl"
    data-funnel={funnel.id}
    data-app={funnel.app}
    data-countdown={String(funnel.countdownMinutes)}
    data-checkout-ready={checkoutReady ? '1' : '0'}
    data-store-url={app.appStoreUrl}
  >
    <header class="fnl-bar">
      <button class="fnl-back" type="button" aria-label="Go back" hidden>&larr;</button>
      <div class="fnl-progress" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
        <span class="fnl-progress-fill"></span>
      </div>
    </header>

    <!-- Intro: the principle, shown ---------------------------------------- -->
    <!--
      Not argued in three sentences — SHOWN. A teacher card, a caption being typed in the language
      she teaches, then a "your turn" card whose words colour in one by one. The row rotates through
      the teachers every ten seconds. This is the app's own intro screen (v2, founder 2026-09-17:
      « ça doit être court, méga stylé »).
    -->
    <section class="fnl-screen is-active" data-screen="intro">
      <div class="fnl-inner fnl-center">
        <h1 class="bl-title" data-title={COPY.introTitle}></h1>
        <p class="fnl-sub">{COPY.introPromise}</p>

        <div class="bl-demo" data-demo>
          <div class="bl-demo-card" data-demo-card>
            <img class="bl-demo-photo" data-demo-photo src="" alt="" width="132" height="168" />
            <span class="bl-demo-live"><i></i>{COPY.demoLive}</span>
            <span class="bl-demo-name" data-demo-name></span>
          </div>
          <div class="bl-demo-talk">
            <p class="bl-bubble" data-demo-line></p>
            <p class="bl-roman" data-demo-line-roman hidden></p>
            <div class="bl-reply" data-demo-reply hidden>
              <span class="bl-reply-tag">{COPY.demoYourTurn}</span>
              <p class="bl-reply-words" data-demo-reply-words></p>
              <p class="bl-roman" data-demo-reply-roman hidden></p>
            </div>
          </div>
        </div>

        <button class="fnl-cta" type="button" data-action="start">{COPY.continue}</button>
      </div>
    </section>

    <!-- Language ----------------------------------------------------------- -->
    <section class="fnl-screen" data-screen="language">
      <div class="fnl-inner">
        <h1 class="bl-title" data-title={COPY.languageTitle}></h1>
        <div class="bl-langs" data-langs></div>
      </div>
    </section>

    <!-- Tutor -------------------------------------------------------------- -->
    <section class="fnl-screen" data-screen="tutor">
      <div class="fnl-inner">
        <h1 class="bl-title" data-title={COPY.tutorTitle}></h1>
        <p class="fnl-sub">{COPY.tutorSubtitle}</p>
        <div class="bl-tutors" data-tutors></div>
        <button class="fnl-cta" type="button" data-action="next-from-tutor">{COPY.continue}</button>
      </div>
    </section>

    <!-- Vocabulary probe ---------------------------------------------------- -->
    <!--
      The level is never asked (app: ASKS_LEVEL = false). The grids measure it instead, starting on
      the easiest one and stepping up or down once — ticking nothing is still an answer.
    -->
    <section class="fnl-screen" data-screen="vocabulary">
      <div class="fnl-inner">
        <h1 class="bl-title" data-vocab-title></h1>
        <p class="fnl-sub" data-vocab-tier></p>
        <div class="bl-words" data-words></div>
        <button class="fnl-cta" type="button" data-action="words-done">{COPY.continue}</button>
        <!-- Ticking nothing is an answer, and saying so out loud is what makes it one. -->
        <button class="bl-none" type="button" data-action="words-none">{COPY.vocabularyNone}</button>
      </div>
    </section>

    <!-- Goal + optional deadline -------------------------------------------- -->
    <section class="fnl-screen" data-screen="goal">
      <div class="fnl-inner">
        <h1 class="bl-title" data-title={COPY.goalTitle}></h1>
        <div class="bl-goals" data-goals></div>

        <div class="bl-deadline" data-deadline hidden>
          <p class="bl-deadline-q">{COPY.goalDeadline} <em>{COPY.optional}</em></p>
          <div class="bl-chips" data-events></div>
          <label class="bl-date" data-date-field hidden>
            <span>When is it?</span>
            <input type="date" data-date />
          </label>
          <button class="fnl-cta" type="button" data-action="goal-done">{COPY.continue}</button>
        </div>
      </div>
    </section>

    <!-- Name ---------------------------------------------------------------- -->
    <section class="fnl-screen" data-screen="name">
      <div class="fnl-inner">
        <h1 class="bl-title" data-name-title></h1>
        <input class="bl-input" type="text" data-name-input placeholder={COPY.namePlaceholder} autocomplete="given-name" maxlength="50" />
        <button class="fnl-cta" type="button" data-action="name-done">{COPY.continue}</button>
      </div>
    </section>

    <!-- Where did you hear about us ----------------------------------------- -->
    <section class="fnl-screen" data-screen="heardAboutUs">
      <div class="fnl-inner">
        <h1 class="bl-title bl-title-plain" data-heard-title></h1>
        <p class="fnl-sub" data-heard-sub></p>
        <div class="bl-sources" data-sources></div>
        <button class="bl-skip" type="button" data-action="skip-heard"></button>
      </div>
    </section>

    <!-- Plan ready ----------------------------------------------------------- -->
    <section class="fnl-screen" data-screen="ready">
      <div class="fnl-inner fnl-center">
        <h1 class="bl-title" data-ready-title></h1>
        <p class="fnl-sub" data-ready-sub></p>

        <div class="bl-stats" data-stats></div>
        <ul class="bl-rows" data-rows></ul>

        <button class="fnl-cta" type="button" data-action="see-plan">{COPY.continue}</button>
      </div>
    </section>

    <!-- Paywall ----------------------------------------------------------- -->
    <section class="fnl-screen" data-screen="plan">
      {funnel.countdownMinutes > 0 && (
        <div class="fnl-countdown" data-countdown-bar>
          <span>Your discount is reserved for</span>
          <strong data-countdown-clock>10:00</strong>
        </div>
      )}

      <div class="fnl-inner fnl-paywall">
        <h2>{funnel.paywallTitle}</h2>
        <p class="fnl-sub">{funnel.paywallSub}</p>

        <div class="fnl-plans" data-plans>
          {funnel.plans.map((plan) => (
            <button
              class:list={['fnl-plan', plan.highlight && 'is-highlight']}
              type="button"
              data-package={plan.packageId}
            >
              {plan.badge && <span class="fnl-plan-badge">{plan.badge}</span>}
              <span class="fnl-plan-radio" aria-hidden="true"></span>
              <span class="fnl-plan-main">
                <span class="fnl-plan-name">{plan.name}</span>
                <span class="fnl-plan-save">SAVE {plan.savePercent}%</span>
                <span class="fnl-plan-totals">
                  <s>{plan.listPrice}</s> {plan.price}
                </span>
              </span>
              <span class="fnl-plan-day">
                <s>{plan.perDayList}</s>
                <strong>{plan.perDay}</strong>
                <em>per day</em>
              </span>
            </button>
          ))}
        </div>

        <button class="fnl-cta" type="button" data-action="checkout" disabled>Continue</button>

        <ul class="fnl-pay" aria-label="Accepted payment methods">
          <li>VISA</li><li>Mastercard</li><li>Apple&nbsp;Pay</li><li>Google&nbsp;Pay</li><li>Amex</li>
        </ul>
        <p class="fnl-secure">Secure payment</p>

        {!checkoutReady && (
          <p class="fnl-warn">
            Checkout is not configured. Set <code>PUBLIC_RC_WEB_BILLING_URL</code> in the deploy
            workflow, and turn on <strong>Allow anonymous sign-ins</strong> in Supabase → Authentication,
            before sending traffic here.
          </p>
        )}

        <p class="fnl-legal" data-renewal></p>
        <p class="fnl-legal"><a href="/privacy/">Privacy</a> · <a href="/terms/">Terms</a></p>

        <!-- Long-form selling below the fold, then the price block again — Praktika repeats it once
             with a second headline rather than making the visitor scroll back up. -->
        <section class="fnl-block">
          <h3>What you get</h3>
          <ul class="fnl-included">
            {funnel.included.map((item) => (
              <li>
                <strong>{item.title}</strong>
                <span>{item.body}</span>
              </li>
            ))}
          </ul>
        </section>

        <section class="fnl-block">
          <h3>Frequently asked questions</h3>
          <dl class="fnl-faq">
            {funnel.faq.map((item) => (
              <>
                <dt>{item.q}</dt>
                <dd>{item.a}</dd>
              </>
            ))}
          </dl>
        </section>

        <section class="fnl-block">
          <h3 data-second-cta-title>Start speaking</h3>
          <div class="fnl-plans" data-plans>
            {funnel.plans.map((plan) => (
              <button
                class:list={['fnl-plan', plan.highlight && 'is-highlight']}
                type="button"
                data-package={plan.packageId}
              >
                {plan.badge && <span class="fnl-plan-badge">{plan.badge}</span>}
                <span class="fnl-plan-radio" aria-hidden="true"></span>
                <span class="fnl-plan-main">
                  <span class="fnl-plan-name">{plan.name}</span>
                  <span class="fnl-plan-save">SAVE {plan.savePercent}%</span>
                  <span class="fnl-plan-totals">
                    <s>{plan.listPrice}</s> {plan.price}
                  </span>
                </span>
                <span class="fnl-plan-day">
                  <s>{plan.perDayList}</s>
                  <strong>{plan.perDay}</strong>
                  <em>per day</em>
                </span>
              </button>
            ))}
          </div>
          <button class="fnl-cta" type="button" data-action="checkout" disabled>Continue</button>
          <p class="fnl-error" data-checkout-error hidden></p>
        </section>
      </div>
    </section>
  </div>
  </div>
</Base>

<script>
  import { FUNNELS, DEFAULT_FUNNEL, SUPABASE_URL, SUPABASE_ANON_KEY, checkoutUrl } from '../../config/funnel';
  import { track } from '../../lib/funnelTrack';
  import {
    COPY,
    RESULT_COPY,
    STEPS,
    STEP_ANALYTICS_NAME,
    TIER_LABEL,
    HEARD_ABOUT_US,
    DEADLINE_EVENTS,
    CEFR_TO_LEVEL_VALUE,
    INTRO_LESSONS,
    introSceneTimings,
    titleWordGroups,
    plainTitle,
    TITLE_WORD_STAGGER_MS,
    titleSettleMs,
    goalOptions,
    type Step,
  } from '../../config/bliss/onboarding';
  import {
    TAUGHT_LANGUAGES,
    LANGUAGE_BY_CODE,
    TUTORS,
    TUTOR_BY_PERSONA,
    tutorsForLanguage,
    recommendedTutor,
    tutorTag,
    hueStep,
    type Tutor,
  } from '../../config/bliss/tutors';
  import {
    probeWordsFor,
    hasVocabularyProbe,
    nextProbeTier,
    estimateVocabulary,
    MAX_PROBE_GRIDS,
    type ProbeResult,
    type VocabTier,
  } from '../../config/bliss/vocabularyProbe';

  const STORAGE_KEY = 'bliss_funnel_v3';

  /**
   * Which language each teacher demonstrates on the intro row. The natives teach their own; the
   * bilingual friends each take a language nobody else in the row is showing, so the rotation walks
   * through as many languages as it can (the app's `introRowItems` rule).
   */
  const DEMO_LANGUAGE: Record<string, string> = {
    sofia: 'es', amelie: 'fr', emily: 'en', meilin: 'zh',
    alex: 'it', mila: 'de', astra: 'pt', charm: 'ja',
  };

  /**
   * Ad attribution, captured from the landing URL and carried to checkout.
   *
   * This is the reason the web funnel exists: on the App Store path these installs land in
   * AppsFlyer's `restricted` bucket with no campaign attached, because the user never resolved ATT.
   * On the web the click ids are simply in the URL and stay ours.
   */
  const ATTRIBUTION_KEYS = [
    'utm_source', 'utm_medium', 'utm_campaign', 'utm_content', 'utm_term',
    'fbclid', 'ttclid', 'gclid',
  ];

  function initFunnel(): void {
    const found = document.querySelector<HTMLElement>('.fnl');
    if (!found || found.dataset.initialised === '1') return;
    // Bound to a non-null local: every closure below captures it, and TypeScript keeps the guard.
    const root: HTMLElement = found;
    root.dataset.initialised = '1';

    // `?t=sofia` sells the single-tutor app: same flow, language and tutor locked. Anything else
    // falls back to the page's own funnel rather than rendering a funnel that does not exist.
    const query = new URLSearchParams(window.location.search);
    const requested = query.get('t') ?? '';
    const funnel = FUNNELS[requested] ?? FUNNELS[root.dataset.funnel ?? DEFAULT_FUNNEL] ?? FUNNELS[DEFAULT_FUNNEL];
    root.dataset.funnel = funnel.id;

    const checkoutReady = root.dataset.checkoutReady === '1';
    const startedAt = Date.now();

    const attribution: Record<string, string> = {};
    ATTRIBUTION_KEYS.forEach((key) => {
      const value = query.get(key);
      if (value) attribution[key] = value.slice(0, 200);
    });

    // ── State ───────────────────────────────────────────────────────────────
    let language = funnel.lockedLanguage ?? '';
    let persona = funnel.lockedPersona ?? '';
    let probeResults: ProbeResult[] = [];
    let knownWords: string[] = [];
    let currentTier: VocabTier = 'basic';
    let goal = '';
    let deadlineEvent = '';
    let deadlineDate = '';
    let firstName = '';
    let heardAboutUs = '';
    let chosenPackage = funnel.plans.find((p) => p.highlight)?.packageId ?? funnel.plans[0].packageId;

    const tutor = (): Tutor => TUTOR_BY_PERSONA[persona] ?? recommendedTutor(language || 'es');
    const languageName = (): string => LANGUAGE_BY_CODE[language]?.name ?? '';

    function persist(): void {
      try {
        localStorage.setItem(
          STORAGE_KEY,
          JSON.stringify({ language, persona, goal, firstName, chosenPackage }),
        );
      } catch {
        /* private mode: the funnel works, it simply does not resume */
      }
    }

    // ── Screens ─────────────────────────────────────────────────────────────
    const screens = new Map<string, HTMLElement>();
    root.querySelectorAll<HTMLElement>('[data-screen]').forEach((el) => {
      screens.set(el.dataset.screen as string, el);
    });

    /** A locked funnel (Sofia) skips the two steps that would be a lie, and the probe needs a grid. */
    function sequence(): Step[] {
      return STEPS.filter((step) => {
        if (step === 'language' || step === 'tutor') return !funnel.lockedLanguage;
        if (step === 'vocabulary') return hasVocabularyProbe(language || null);
        return true;
      });
    }

    let current: Step = 'intro';
    const backBtn = root.querySelector<HTMLButtonElement>('.fnl-back');
    const fill = root.querySelector<HTMLElement>('.fnl-progress-fill');
    const bar = root.querySelector<HTMLElement>('.fnl-progress');

    function show(id: Step, opts: { push?: boolean } = {}): void {
      const el = screens.get(id);
      if (!el) return;
      current = id;
      screens.forEach((s) => s.classList.remove('is-active'));
      el.classList.add('is-active');

      const steps = sequence();
      const i = steps.indexOf(id);
      const span = Math.max(1, steps.length - 1);
      const pct = i <= 0 ? 0 : Math.round(Math.min(1, i / span) * 100);
      if (fill) fill.style.width = `${pct}%`;
      if (bar) bar.setAttribute('aria-valuenow', String(pct));
      if (backBtn) backBtn.hidden = i <= 0;

      window.scrollTo({ top: 0, behavior: 'instant' as ScrollBehavior });
      if (opts.push !== false) history.pushState({ screen: id }, '', `#${id}`);
      revealTitles(el);
      track('funnel_step_view', { funnel: funnel.id, step: STEP_ANALYTICS_NAME[id] });
    }

    function advance(): void {
      const steps = sequence();
      const next = steps[steps.indexOf(current) + 1];
      if (next) show(next);
    }

    // ── Titles: the accent never breaks, and the words land one by one ──────
    //
    // Ported from the app (`titleWordGroups`): the words between *asterisks* are the accent
    // (Instrument Serif italic), they are one unbreakable word, and a multi-word accent starts its
    // own line only when at least three words come before it.
    function renderTitle(el: HTMLElement, raw: string): void {
      el.textContent = '';
      el.setAttribute('aria-label', plainTitle(raw));
      let index = 0;
      titleWordGroups(raw).forEach((group) => {
        if (group.breakBefore) el.appendChild(document.createElement('br'));
        const word = document.createElement('span');
        word.className = 'bl-word';
        word.style.animationDelay = `${index * TITLE_WORD_STAGGER_MS}ms`;
        group.runs.forEach((run) => {
          const span = document.createElement('span');
          span.textContent = run.text;
          if (run.accent) span.className = 'bl-em';
          word.appendChild(span);
        });
        el.appendChild(word);
        el.appendChild(document.createTextNode(' '));
        index += 1;
      });
    }

    /** Re-run the reveal each time a screen is shown, so a back-and-forward is not a static page. */
    function revealTitles(screen: HTMLElement): void {
      screen.querySelectorAll<HTMLElement>('.bl-title').forEach((el) => {
        const raw = el.dataset.title;
        if (raw) renderTitle(el, raw);
        const inner = el.closest('.fnl-inner');
        const answers = inner?.querySelector<HTMLElement>('.bl-langs, .bl-tutors, .bl-words, .bl-goals, .bl-sources, .bl-stats, .bl-input, .fnl-cta');
        if (!raw || !answers) return;
        // The answers arrive while the title is still landing — never later than a second
        // (founder, 2026-09-17: « les réponses mettent trop de temps à apparaître »).
        inner?.classList.add('is-settling');
        window.setTimeout(() => inner?.classList.remove('is-settling'), titleSettleMs(raw));
      });
    }

    // ── Intro demo ──────────────────────────────────────────────────────────
    const demo = {
      photo: root.querySelector<HTMLImageElement>('[data-demo-photo]'),
      name: root.querySelector<HTMLElement>('[data-demo-name]'),
      card: root.querySelector<HTMLElement>('[data-demo-card]'),
      line: root.querySelector<HTMLElement>('[data-demo-line]'),
      lineRoman: root.querySelector<HTMLElement>('[data-demo-line-roman]'),
      reply: root.querySelector<HTMLElement>('[data-demo-reply]'),
      replyWords: root.querySelector<HTMLElement>('[data-demo-reply-words]'),
      replyRoman: root.querySelector<HTMLElement>('[data-demo-reply-roman]'),
    };
    let demoTimers: number[] = [];

    function stopDemo(): void {
      demoTimers.forEach((t) => window.clearTimeout(t));
      demoTimers = [];
    }

    /** The teachers the row walks through: everyone, or only the locked one. */
    function demoRow(): Tutor[] {
      if (funnel.lockedPersona) {
        const only = TUTOR_BY_PERSONA[funnel.lockedPersona];
        return only ? [only] : TUTORS.slice(0, 1);
      }
      return TUTORS.filter((t) => INTRO_LESSONS[DEMO_LANGUAGE[t.persona]]);
    }

    function playScene(sceneIndex: number): void {
      const row = demoRow();
      if (row.length === 0 || !demo.line) return;
      const who = row[sceneIndex % row.length];
      const code = funnel.lockedLanguage ?? DEMO_LANGUAGE[who.persona];
      const lesson = INTRO_LESSONS[code];
      if (!lesson) return;

      if (demo.photo) {
        demo.photo.src = `/home/${who.photo}`;
        demo.photo.alt = `${who.name}, AI ${LANGUAGE_BY_CODE[code]?.name ?? ''} tutor`;
      }
      if (demo.name) demo.name.textContent = who.name;
      if (demo.card) demo.card.style.setProperty('--tutor', who.gradient[1]);
      demo.line.textContent = '';
      if (demo.lineRoman) {
        demo.lineRoman.textContent = lesson.lineRomanization ?? '';
        demo.lineRoman.hidden = !lesson.lineRomanization;
      }
      if (demo.reply) demo.reply.hidden = true;
      if (demo.replyWords) demo.replyWords.textContent = '';

      const chars = Array.from(lesson.line);
      const timings = introSceneTimings(chars.length, lesson.replyWords.length);

      chars.forEach((_, i) => {
        demoTimers.push(
          window.setTimeout(() => {
            if (demo.line) demo.line.textContent = chars.slice(0, i + 1).join('');
          }, timings.charAt(i + 1)),
        );
      });

      demoTimers.push(
        window.setTimeout(() => {
          if (!demo.reply || !demo.replyWords) return;
          demo.reply.hidden = false;
          demo.replyWords.textContent = '';
          lesson.replyWords.forEach((word, w) => {
            const span = document.createElement('span');
            span.className = 'bl-reply-word';
            span.textContent = (w > 0 ? lesson.wordJoiner : '') + word;
            demo.replyWords?.appendChild(span);
            demoTimers.push(
              window.setTimeout(() => span.classList.add('is-said'), timings.wordAt(w) - timings.replyAt),
            );
          });
          if (demo.replyRoman) {
            demo.replyRoman.textContent = lesson.replyRomanization ?? '';
            demo.replyRoman.hidden = !lesson.replyRomanization;
          }
        }, timings.replyAt),
      );

      demoTimers.push(window.setTimeout(() => playScene(sceneIndex + 1), timings.endAt));
    }

    // ── Language ────────────────────────────────────────────────────────────
    const langsEl = root.querySelector<HTMLElement>('[data-langs]');
    if (langsEl) {
      TAUGHT_LANGUAGES.forEach((lang) => {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'bl-lang';
        const recommended = recommendedTutor(lang.code);
        btn.style.setProperty('--tutor', recommended.gradient[1]);
        btn.style.setProperty('--hue', `${hueStep(recommended.persona, lang.code)}deg`);
        btn.innerHTML = `<span class="bl-lang-badge">${lang.badge}</span><span class="bl-lang-name"></span>`;
        (btn.querySelector('.bl-lang-name') as HTMLElement).textContent = lang.name;
        btn.addEventListener('click', () => {
          language = lang.code;
          persona = recommendedTutor(lang.code).persona;
          currentTier = 'basic';
          probeResults = [];
          knownWords = [];
          persist();
          paintTutor();
          track('funnel_answer', { funnel: funnel.id, step: 'bliss_language', value: lang.code });
          buildTutors();
          advance();
        });
        langsEl.appendChild(btn);
      });
    }

    // ── Tutor ───────────────────────────────────────────────────────────────
    const tutorsEl = root.querySelector<HTMLElement>('[data-tutors]');

    /** The chosen teacher's colour drives the whole screen from here on, as it does in the app. */
    function paintTutor(): void {
      const t = tutor();
      root.style.setProperty('--tutor-1', t.gradient[0]);
      root.style.setProperty('--tutor-2', t.gradient[1]);
      root.style.setProperty('--tutor-3', t.gradient[2]);
      root.style.setProperty('--tutor-accent', t.accent);
      root.style.setProperty('--tutor-soft', t.soft);
      root.style.setProperty('--tutor-wash', t.wash);
      // The teacher's colour takes the whole screen from here on — the CTA, the progress bar and the
      // paywall included. In the app it is the same rule: after the tutor step, she tints everything.
      root.style.setProperty('--brand-1', t.gradient[0]);
      root.style.setProperty('--brand-2', t.gradient[1]);
      root.style.setProperty('--brand-3', t.gradient[2]);
      root.style.setProperty('--accent', t.accent);
    }

    function buildTutors(): void {
      if (!tutorsEl || !language) return;
      tutorsEl.textContent = '';
      tutorsForLanguage(language).forEach((t, i) => {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'bl-tutor';
        btn.dataset.persona = t.persona;
        btn.style.setProperty('--tutor', t.gradient[1]);
        btn.classList.toggle('is-selected', t.persona === persona);
        const traits = t.traits.join(' · ');
        btn.innerHTML =
          `<img src="/home/${t.photo}" alt="" width="148" height="188" loading="lazy" />` +
          `<span class="bl-tutor-scrim"></span>` +
          (i === 0 ? `<span class="bl-tutor-reco">Recommended</span>` : '') +
          `<span class="bl-tutor-meta"><b></b><i></i><em></em></span>`;
        (btn.querySelector('.bl-tutor-meta b') as HTMLElement).textContent = t.name;
        (btn.querySelector('.bl-tutor-meta i') as HTMLElement).textContent = tutorTag(t, language);
        (btn.querySelector('.bl-tutor-meta em') as HTMLElement).textContent = traits;
        btn.addEventListener('click', () => {
          persona = t.persona;
          persist();
          paintTutor();
          tutorsEl.querySelectorAll('.bl-tutor').forEach((c) => c.classList.toggle('is-selected', c === btn));
          track('funnel_answer', { funnel: funnel.id, step: 'bliss_tutor', value: t.persona });
        });
        tutorsEl.appendChild(btn);
      });
    }

    // ── Vocabulary probe ────────────────────────────────────────────────────
    const wordsEl = root.querySelector<HTMLElement>('[data-words]');
    const vocabTitle = root.querySelector<HTMLElement>('[data-vocab-title]');
    const vocabTier = root.querySelector<HTMLElement>('[data-vocab-tier]');
    let picked = new Set<string>();

    function buildGrid(tier: VocabTier): void {
      if (!wordsEl) return;
      currentTier = tier;
      picked = new Set();
      wordsEl.textContent = '';
      const isMore = probeResults.length > 0;
      if (vocabTitle) {
        vocabTitle.dataset.title = isMore ? COPY.vocabularyMore : COPY.vocabularyTitle;
        renderTitle(vocabTitle, vocabTitle.dataset.title);
      }
      if (vocabTier) {
        vocabTier.textContent = (TIER_LABEL[tier] ?? '').replace('{language}', languageName());
      }
      probeWordsFor(language, tier).forEach((entry) => {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'bl-word-chip';
        btn.innerHTML = `<b></b>${entry.hint ? '<i></i>' : ''}`;
        (btn.querySelector('b') as HTMLElement).textContent = entry.word;
        if (entry.hint) (btn.querySelector('i') as HTMLElement).textContent = entry.hint;
        btn.addEventListener('click', () => {
          if (picked.has(entry.word)) picked.delete(entry.word);
          else picked.add(entry.word);
          btn.classList.toggle('is-picked', picked.has(entry.word));
        });
        wordsEl.appendChild(btn);
      });
    }

    /** Ticking nothing is an answer, so the grid is submitted the same way whatever is selected. */
    function submitGrid(): void {
      const total = probeWordsFor(language, currentTier).length;
      probeResults.push({ tier: currentTier, picked: picked.size, total });
      knownWords = knownWords.concat(Array.from(picked)).slice(0, 64);
      track('funnel_answer', {
        funnel: funnel.id,
        step: 'bliss_vocabulary',
        value: currentTier,
        picked: picked.size,
        total,
      });
      const next = probeResults.length < MAX_PROBE_GRIDS ? nextProbeTier(probeResults) : null;
      if (next) {
        buildGrid(next);
        revealTitles(screens.get('vocabulary') as HTMLElement);
        window.scrollTo({ top: 0, behavior: 'instant' as ScrollBehavior });
        return;
      }
      advance();
    }

    // ── Goal + optional deadline ────────────────────────────────────────────
    const goalsEl = root.querySelector<HTMLElement>('[data-goals]');
    const deadlineEl = root.querySelector<HTMLElement>('[data-deadline]');
    const eventsEl = root.querySelector<HTMLElement>('[data-events]');
    const dateField = root.querySelector<HTMLElement>('[data-date-field]');
    const dateInput = root.querySelector<HTMLInputElement>('[data-date]');

    function buildGoals(): void {
      if (!goalsEl) return;
      goalsEl.textContent = '';
      goalOptionsFor().forEach((option) => {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'bl-goal';
        btn.innerHTML = `<span class="bl-goal-glyph">${option.glyph}</span><span></span>`;
        (btn.querySelectorAll('span')[1] as HTMLElement).textContent = option.label;
        btn.addEventListener('click', () => {
          goal = option.value;
          persist();
          goalsEl.querySelectorAll('.bl-goal').forEach((c) => c.classList.toggle('is-picked', c === btn));
          track('funnel_answer', { funnel: funnel.id, step: 'main_goal', value: option.value });
          // The deadline is an optional block under the goal, not a screen of its own.
          if (deadlineEl) deadlineEl.hidden = false;
          deadlineEl?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        });
        goalsEl.appendChild(btn);
      });
    }

    if (eventsEl) {
      DEADLINE_EVENTS.forEach((event) => {
        const chip = document.createElement('button');
        chip.type = 'button';
        chip.className = 'bl-chip';
        chip.innerHTML = `<span>${event.glyph}</span><span></span>`;
        (chip.querySelectorAll('span')[1] as HTMLElement).textContent = event.label;
        chip.addEventListener('click', () => {
          const on = deadlineEvent === event.id;
          deadlineEvent = on ? '' : event.id;
          eventsEl.querySelectorAll('.bl-chip').forEach((c) => c.classList.toggle('is-picked', !on && c === chip));
          if (dateField) dateField.hidden = !deadlineEvent;
          if (!deadlineEvent) deadlineDate = '';
        });
        eventsEl.appendChild(chip);
      });
    }
    dateInput?.addEventListener('change', () => {
      deadlineDate = dateInput.value;
    });

    /** Mandarin swaps « Living abroad » for « Family or heritage », exactly as the app does. */
    function goalOptionsFor() {
      return goalOptions(language || null);
    }

    // ── Name ────────────────────────────────────────────────────────────────
    const nameTitle = root.querySelector<HTMLElement>('[data-name-title]');
    const nameInput = root.querySelector<HTMLInputElement>('[data-name-input]');

    function buildName(): void {
      if (!nameTitle) return;
      nameTitle.dataset.title = COPY.nameTitle.replace('{name}', tutor().name);
      renderTitle(nameTitle, nameTitle.dataset.title);
    }

    // ── Where did you hear about us ─────────────────────────────────────────
    const heardTitle = root.querySelector<HTMLElement>('[data-heard-title]');
    const heardSub = root.querySelector<HTMLElement>('[data-heard-sub]');
    const sourcesEl = root.querySelector<HTMLElement>('[data-sources]');
    const skipBtn = root.querySelector<HTMLButtonElement>('[data-action="skip-heard"]');
    if (heardTitle) heardTitle.textContent = HEARD_ABOUT_US.title;
    if (heardSub) heardSub.textContent = HEARD_ABOUT_US.subtitle;
    if (skipBtn) skipBtn.textContent = HEARD_ABOUT_US.skip;
    if (sourcesEl) {
      HEARD_ABOUT_US.sources.forEach((source) => {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'bl-source';
        btn.style.setProperty('--brand', source.color);
        btn.textContent = source.label;
        btn.addEventListener('click', () => {
          heardAboutUs = source.id;
          btn.classList.add('is-picked');
          if (heardSub) heardSub.textContent = HEARD_ABOUT_US.thanks;
          track('funnel_answer', { funnel: funnel.id, step: 'heard_about_us', value: source.id });
          window.setTimeout(advance, 650);
        });
        sourcesEl.appendChild(btn);
      });
    }

    // ── Plan ready ──────────────────────────────────────────────────────────
    const readyTitle = root.querySelector<HTMLElement>('[data-ready-title]');
    const readySub = root.querySelector<HTMLElement>('[data-ready-sub]');
    const statsEl = root.querySelector<HTMLElement>('[data-stats]');
    const rowsEl = root.querySelector<HTMLElement>('[data-rows]');

    function daysUntilDeadline(): number | null {
      if (!deadlineDate) return null;
      const target = new Date(`${deadlineDate}T00:00:00`);
      if (Number.isNaN(target.getTime())) return null;
      const days = Math.ceil((target.getTime() - Date.now()) / 86400000);
      return days > 0 ? days : null;
    }

    function estimate() {
      return estimateVocabulary(probeResults);
    }

    /** The level the tutor teaches at. Nothing was claimed, so it is the grids' verdict alone. */
    function resolvedLevel(): string {
      return estimate()?.measuredCefr ?? 'A1';
    }

    function buildReady(): void {
      const t = tutor();
      if (readyTitle) {
        const raw = firstName
          ? COPY.readyTitle.replace('{first}', firstName)
          : COPY.readyTitleAnon;
        readyTitle.dataset.title = raw;
        renderTitle(readyTitle, raw);
      }
      if (readySub) readySub.textContent = COPY.readySubtitle.replace('{name}', t.name);

      const est = estimate();
      const days = daysUntilDeadline();
      if (statsEl) {
        statsEl.textContent = '';
        const stat = (value: string, label: string) => {
          const box = document.createElement('div');
          box.className = 'bl-stat';
          box.innerHTML = '<b></b><span></span>';
          (box.querySelector('b') as HTMLElement).textContent = value;
          (box.querySelector('span') as HTMLElement).textContent = label;
          statsEl.appendChild(box);
        };
        stat(resolvedLevel(), RESULT_COPY.level);
        // Rounded to the nearest ten by the estimator — a unit digit would claim a precision the
        // 16-word grids do not have.
        if (est) stat(`~${est.knownWords}`, RESULT_COPY.words);
        if (days) stat(String(days), RESULT_COPY.daysLeft);
      }

      if (rowsEl) {
        rowsEl.textContent = '';
        [
          RESULT_COPY.rowDefault,
          RESULT_COPY.rowTutor.replace('{name}', t.name),
          days ? RESULT_COPY.rowDeadline : RESULT_COPY.rowRhythm,
        ].forEach((text) => {
          const li = document.createElement('li');
          li.textContent = text;
          rowsEl.appendChild(li);
        });
      }
    }

    // ── Paywall ─────────────────────────────────────────────────────────────
    function selectPlan(packageId: string): void {
      chosenPackage = packageId;
      persist();
      root.querySelectorAll<HTMLButtonElement>('.fnl-plan').forEach((p) => {
        p.classList.toggle('is-selected', p.dataset.package === packageId);
      });
      const plan = funnel.plans.find((p) => p.packageId === packageId);
      root.querySelectorAll<HTMLElement>('[data-renewal]').forEach((el) => {
        el.textContent = plan
          ? `Your subscription renews at ${plan.price} until you cancel. Cancel any time from your account settings.`
          : '';
      });
      root.querySelectorAll<HTMLButtonElement>('[data-action="checkout"]').forEach((cta) => {
        cta.disabled = !checkoutReady;
      });
    }

    root.querySelectorAll<HTMLButtonElement>('.fnl-plan').forEach((btn) => {
      btn.addEventListener('click', () => {
        selectPlan(btn.dataset.package as string);
        track('funnel_plan_selected', { funnel: funnel.id, package: btn.dataset.package });
      });
    });
    selectPlan(chosenPackage);

    const secondTitle = root.querySelector<HTMLElement>('[data-second-cta-title]');

    function showPaywall(): void {
      if (secondTitle) secondTitle.textContent = `Start speaking with ${tutor().name}`;
      show('plan');
      startCountdown();
      const est = estimate();
      track('funnel_plan_view', {
        funnel: funnel.id,
        language,
        persona,
        goal,
        level: resolvedLevel(),
        words_known: est?.knownWords ?? 0,
        has_deadline: Boolean(daysUntilDeadline()),
        named: Boolean(firstName),
        heard_about_us: heardAboutUs || 'none',
      });
    }

    // Countdown. Manufactured urgency, founder decision 2026-09-16 — one config value to remove it.
    // It never reaches zero-and-locks: expiring the offer a visitor is reading would cost the sale
    // the timer exists to win, so it floors at 0:00 and the price stays.
    let countdownStarted = false;
    function startCountdown(): void {
      if (countdownStarted) return;
      countdownStarted = true;
      const minutes = Number(root.dataset.countdown || '0');
      if (minutes <= 0) return;
      const clock = root.querySelector<HTMLElement>('[data-countdown-clock]');
      let left = minutes * 60;
      const tick = () => {
        if (!clock) return;
        const m = Math.floor(left / 60);
        const sec = left % 60;
        clock.textContent = `${m}:${String(sec).padStart(2, '0')}`;
        if (left > 0) left -= 1;
      };
      tick();
      window.setInterval(tick, 1000);
    }

    // ── Checkout ────────────────────────────────────────────────────────────
    const errorEl = root.querySelector<HTMLElement>('[data-checkout-error]');
    function showError(message: string): void {
      if (!errorEl) return;
      errorEl.textContent = message;
      errorEl.hidden = false;
    }

    /**
     * What the app would have written itself.
     *
     * `guidedPrefilledAnswers()` in APPSOFIA turns the guided answers into the tutor onboarding's
     * own keys: the level under `'2'` / `spanish_level`, the goal under `'8'`, the first name under
     * `'3'`, and the Bliss-specific extras under `bliss_*`. Writing exactly those keys here is what
     * makes the web funnel the onboarding rather than a copy of it — the buyer opens the app and it
     * already knows them. Anything unparsable there is dropped, so a half-written value is safe.
     */
    function appAnswers(): Record<string, string> {
      const est = estimate();
      const cefr = resolvedLevel();
      const answers: Record<string, string> = {
        '2': CEFR_TO_LEVEL_VALUE[cefr as keyof typeof CEFR_TO_LEVEL_VALUE] ?? 'Elementary',
        spanish_level: CEFR_TO_LEVEL_VALUE[cefr as keyof typeof CEFR_TO_LEVEL_VALUE] ?? 'Elementary',
        '8': goal,
        bliss_cefr_level: cefr,
      };
      if (est) {
        answers.bliss_cefr_measured = est.measuredCefr;
        answers.bliss_vocab_size = String(est.knownWords);
      }
      if (knownWords.length > 0) answers.bliss_known_words = JSON.stringify(knownWords);
      if (deadlineEvent && deadlineDate) {
        answers.bliss_deadline = JSON.stringify({ event: deadlineEvent, date: deadlineDate });
      }
      if (firstName) answers['3'] = firstName;
      return answers;
    }

    async function beginCheckout(cta: HTMLButtonElement): Promise<void> {
      const original = cta.textContent;
      cta.disabled = true;
      cta.textContent = 'One moment…';
      if (errorEl) errorEl.hidden = true;
      const plan = funnel.plans.find((p) => p.packageId === chosenPackage);
      track(
        'funnel_checkout_started',
        { funnel: funnel.id, package: chosenPackage },
        plan ? { value: plan.amount, currency: funnel.currency, contentId: chosenPackage } : undefined,
      );

      try {
        const { createClient } = await import('@supabase/supabase-js');
        const client = createClient(SUPABASE_URL, SUPABASE_ANON_KEY);

        // Reuse a session if the buyer already has one (back button, second attempt) so we never
        // create a second customer for the same person.
        let userId = (await client.auth.getUser()).data.user?.id;
        if (!userId) {
          const { data, error } = await client.auth.signInAnonymously();
          if (error || !data.user) throw error ?? new Error('no user');
          userId = data.user.id;
        }

        // Hand the onboarding to the app before leaving for checkout. Best-effort on purpose: a
        // failed write must never block a payment — the buyer simply gets the in-app onboarding.
        try {
          await client.from('web_funnel_profiles').upsert(
            {
              user_id: userId,
              funnel: funnel.id,
              variant: funnel.app,
              name: firstName || null,
              persona,
              taught_language: language,
              answers: appAnswers(),
              words_known: knownWords,
              derived_level: resolvedLevel(),
              heard_about_us: heardAboutUs || null,
              native_language: (navigator.language || '').split('-')[0] || null,
              attribution,
              seconds_spent: Math.round((Date.now() - startedAt) / 1000),
              updated_at: new Date().toISOString(),
            },
            { onConflict: 'user_id' },
          );
        } catch {
          /* the purchase matters more than the hand-off */
        }

        const returnTo = new URL('/start/success/', window.location.origin);
        returnTo.searchParams.set('package', chosenPackage);
        returnTo.searchParams.set('t', funnel.id);
        if (firstName) returnTo.searchParams.set('name', firstName);
        if (persona) returnTo.searchParams.set('tutor', persona);

        track('funnel_checkout_redirect', { funnel: funnel.id, package: chosenPackage });
        window.location.href = checkoutUrl({
          packageId: chosenPackage,
          supabaseUserId: userId,
          funnel: funnel.id,
          returnTo: returnTo.href,
          attribution,
        });
      } catch {
        // Most likely cause: "Allow anonymous sign-ins" is off in Supabase → Authentication. Fail
        // here rather than sending an untrackable buyer to a payment page.
        showError('We could not start checkout. Please try again in a moment.');
        track('funnel_checkout_failed', { funnel: funnel.id, package: chosenPackage });
        cta.disabled = false;
        cta.textContent = original;
      }
    }

    root.querySelectorAll<HTMLButtonElement>('[data-action="checkout"]').forEach((cta) => {
      cta.addEventListener('click', () => void beginCheckout(cta));
    });

    // ── Wiring ──────────────────────────────────────────────────────────────
    root.querySelector<HTMLButtonElement>('[data-action="start"]')?.addEventListener('click', () => {
      track('funnel_started', { funnel: funnel.id, ...attribution });
      stopDemo();
      advance();
    });
    root.querySelector<HTMLButtonElement>('[data-action="next-from-tutor"]')?.addEventListener('click', () => {
      buildGrid('basic');
      advance();
    });
    root.querySelector<HTMLButtonElement>('[data-action="words-done"]')?.addEventListener('click', submitGrid);
    root.querySelector<HTMLButtonElement>('[data-action="words-none"]')?.addEventListener('click', () => {
      picked.clear();
      wordsEl?.querySelectorAll('.bl-word-chip').forEach((c) => c.classList.remove('is-picked'));
      submitGrid();
    });
    root.querySelector<HTMLButtonElement>('[data-action="goal-done"]')?.addEventListener('click', () => {
      if (!goal) return;
      buildName();
      advance();
    });
    root.querySelector<HTMLButtonElement>('[data-action="name-done"]')?.addEventListener('click', () => {
      firstName = (nameInput?.value ?? '').trim().slice(0, 50);
      persist();
      track('funnel_answer', { funnel: funnel.id, step: 'name', value: firstName ? 'provided' : 'skipped' });
      advance();
    });
    nameInput?.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') root.querySelector<HTMLButtonElement>('[data-action="name-done"]')?.click();
    });
    skipBtn?.addEventListener('click', () => {
      track('funnel_answer', { funnel: funnel.id, step: 'heard_about_us', value: 'skipped' });
      advance();
    });
    root.querySelector<HTMLButtonElement>('[data-action="see-plan"]')?.addEventListener('click', showPaywall);

    backBtn?.addEventListener('click', () => history.back());
    window.addEventListener('popstate', () => {
      const id = window.location.hash.replace('#', '') || 'intro';
      if (screens.has(id)) show(id as Step, { push: false });
    });

    // A locked funnel already knows its teacher; an unlocked one paints Bliss's own violet until one
    // is chosen. It also names the language it sells: "Speak a language for real" is Bliss's promise,
    // not Sofia's — hers is Spanish, and the visitor came from an ad that said so.
    if (persona) paintTutor();
    if (funnel.lockedLanguage) {
      const introTitle = screens.get('intro')?.querySelector<HTMLElement>('.bl-title');
      if (introTitle) {
        introTitle.dataset.title = COPY.introTitle.replace('a language', languageName());
      }
    }
    buildGoals();
    buildName();
    if (language) buildTutors();
    if (funnel.lockedLanguage) buildGrid('basic');

    // The 'ready' screen is built from answers, so it is rebuilt every time it is shown.
    const readyScreen = screens.get('ready');
    if (readyScreen) {
      new MutationObserver(() => {
        if (readyScreen.classList.contains('is-active')) buildReady();
      }).observe(readyScreen, { attributes: true, attributeFilter: ['class'] });
    }

    // A deep link (refresh, a shared URL, the back button after a hot reload) must not land on a
    // screen this visitor has no answers for: without a language there are no tutors, no grid and no
    // plan, and the screen would simply be empty. Anything unreachable falls back to the intro.
    const initial = window.location.hash.replace('#', '') as Step;
    const reachable = (step: Step): boolean => {
      if (!screens.has(step)) return false;
      if (step === 'intro' || step === 'language') return true;
      if (!language || !persona) return false;
      if (step === 'ready' || step === 'plan') return Boolean(goal);
      return true;
    };
    show(reachable(initial) ? initial : 'intro', { push: false });
    playScene(0);
  }

  initFunnel();
  document.addEventListener('astro:page-load', initFunnel);
</script>
