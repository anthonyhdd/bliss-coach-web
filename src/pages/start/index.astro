---
// /start/ — the paid funnel, running the app's OWN onboarding.
//
// The flow, its copy and its vocabulary grids are ported from Bliss (src/config/bliss/*, mirrored
// from the APPSOFIA repo). v1 of this page was a Praktika-shaped quiz of questions and pitch
// screens; the founder's verdict on 2026-09-17 was that it sold a product the visitor had not met.
// Here the visitor picks a teacher and measures their own vocabulary BEFORE seeing a price, and the
// answers are handed to the app so the onboarding is never run twice. See src/config/funnel.ts.
//
// `bare` (no header, no footer) and `noindex`: there is no way out but forward or back, and the page
// must not rank as a thin duplicate of the landings and split their organic signal.
//
// Every screen is in this one document and switched client-side — each avoided navigation is
// conversion that does not leak. The hash still changes per screen so the back button works and GA4
// sees the progression. What cannot be static (the tutors of a language, the grid of a language,
// the goals of a language) is built by the script from the same config.
import fs from 'node:fs';
import Base from '../../layouts/Base.astro';
import { FUNNELS, DEFAULT_FUNNEL, isCheckoutConfigured } from '../../config/funnel';
import { APPS } from '../../config/apps';
import { COPY } from '../../config/bliss/onboarding';
import '../../styles/funnel.css';

const funnel = FUNNELS[DEFAULT_FUNNEL];
const app = APPS[funnel.app] ?? APPS.sofia;
// Which funnel is running is a runtime question (`?t=`), and each one has its own hosted checkout,
// so readiness is decided per funnel in the script. This map ships with the page.
// The tutor's real loop plays in the intro card, as in the app. Built from what ships in
// public/home/video: the calm `-idle` loop when there is one (a talking mouth out of sync with the
// typed bubble reads as a glitch), else the persona's main loop. A persona without a file keeps
// its photo.
const VIDEO_DIR = 'public/home/video';
const videoFiles = fs.existsSync(VIDEO_DIR) ? fs.readdirSync(VIDEO_DIR).filter((f) => f.endsWith('.mp4')) : [];
const tutorVideos: Record<string, string> = {};
videoFiles.forEach((f) => {
  const persona = f.replace(/(-idle)?\.mp4$/, '');
  if (f.endsWith('-idle.mp4') || !tutorVideos[persona]) tutorVideos[persona] = f;
});
const checkoutReady = isCheckoutConfigured(DEFAULT_FUNNEL);
const checkoutReadyByFunnel = Object.fromEntries(
  Object.keys(FUNNELS).map((id) => [id, isCheckoutConfigured(id)]),
);

// Bliss's own colour (the violet of the site's hero), not a single tutor's: the tutor's colour takes
// over from the moment one is picked, set on the root as --tutor-* by the script.
const brandStyle =
  '--brand-1:#FF6B35;--brand-2:#DB2777;--brand-3:#6366F1;--accent:#DB2777;--on-gradient:#ffffff';
---

<Base
  title="Speak a language for real — Bliss"
  description="Pick your language and your tutor, measure where you stand, and start speaking."
  bare
  noindex
  pixels
  brandStyle={brandStyle}
  bodyClass="funnel-body"
>
  <div
    class="fnl"
    data-funnel={funnel.id}
    data-app={funnel.app}
    data-countdown={String(funnel.countdownMinutes)}
    data-checkout-ready={checkoutReady ? '1' : '0'}
    data-checkout-ready-map={JSON.stringify(checkoutReadyByFunnel)}
    data-store-url={app.appStoreUrl}
    data-tutor-videos={JSON.stringify(tutorVideos)}
  >
    <header class="fnl-bar">
      <button class="fnl-back" type="button" aria-label="Go back" data-i18n-aria="back" hidden>&larr;</button>
      <div class="fnl-progress" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
        <span class="fnl-progress-fill"></span>
      </div>
    </header>

    <!-- Intro: the principle, shown ---------------------------------------- -->
    <!--
      The app's own intro screen, in its own order: the STAGE first (her card, her question written
      as she says it, then the "your turn" card), the title under it, the promise, the row of
      teachers, and only then the button. Not argued in three sentences — shown.
    -->
    <section class="fnl-screen is-active" data-screen="intro">
      <div class="bl-brand" data-brand>
        <img src="/brand/bliss-coach-mark.png" alt="" width="26" height="26" data-brand-mark />
        <span data-brand-name>Bliss</span>
      </div>

      <div class="fnl-inner fnl-center">
        <div class="bl-stage" data-demo>
          <!-- Her card: the same card as the "pick your tutor" step, in small. -->
          <div class="bl-card bl-card-compact" data-demo-card>
            <img class="bl-card-photo" data-demo-photo src="" alt="" width="180" height="240" />
            <video class="bl-card-photo bl-card-video" data-demo-video muted playsinline loop preload="auto" aria-hidden="true" hidden></video>
            <span class="bl-card-scrim"></span>
            <span class="bl-lights" data-demo-lights aria-hidden="true"></span>
            <span class="bl-sheen"></span>
            <span class="bl-pill bl-pill-live" data-demo-live><i></i><span data-copy="demoLive">{COPY.demoLive}</span></span>
            <span class="bl-card-text">
              <b data-demo-name></b>
              <span class="bl-card-traits" data-demo-traits></span>
            </span>
          </div>

          <!-- Her question, written as she says it: glass, popped out of the card. -->
          <div class="bl-bubble" data-demo-bubble>
            <span class="bl-bubble-head">
              <i class="bl-bubble-dot"></i>
              <b data-demo-bubble-name></b>
            </span>
            <p class="bl-bubble-text" data-demo-line></p>
            <span class="bl-dots" data-demo-dots><i></i><i></i><i></i></span>
            <p class="bl-roman" data-demo-line-roman hidden></p>
          </div>

          <!-- The learner's turn: the answer takes her colour, word by word. -->
          <div class="bl-turn-frame" data-demo-reply hidden>
            <div class="bl-turn">
              <span class="bl-turn-head">
                <i class="bl-mic" data-demo-mic><s></s><s></s><s></s></i>
                <b data-copy="demoYourTurn">{COPY.demoYourTurn}</b>
              </span>
              <p class="bl-turn-words" data-demo-reply-words></p>
              <p class="bl-roman" data-demo-reply-roman hidden></p>
            </div>
          </div>
        </div>

        <h1 class="bl-title bl-title-intro" data-title={COPY.introTitle} data-title-key="introTitle"></h1>
        <p class="bl-promise" data-copy="introPromise">{COPY.introPromise}</p>

        <!-- The row of teachers: the one the scene is showing sits in the middle. -->
        <div class="bl-strip" data-strip></div>
      </div>

      <div class="bl-bottom">
        <button class="fnl-cta" type="button" data-action="start" data-copy="continue">{COPY.continue}</button>
        <p class="bl-legal" data-i18n-html="legalIntro">
          By continuing you agree to our <a href="/terms/">Terms</a> and <a href="/privacy/">Privacy&nbsp;Policy</a>.
          · <a href="#cookies" data-consent-open>Cookies</a>
        </p>
      </div>
    </section>

    <!-- Language ----------------------------------------------------------- -->
    <section class="fnl-screen" data-screen="language">
      <div class="fnl-inner">
        <img class="bl-mark" src="/brand/bliss-coach-mark.png" alt="" width="22" height="22" />
        <h1 class="bl-title" data-title={COPY.languageTitle} data-title-key="languageTitle"></h1>
        <div class="bl-langs" data-langs></div>
      </div>
    </section>

    <!-- Tutor -------------------------------------------------------------- -->
    <section class="fnl-screen" data-screen="tutor">
      <div class="fnl-inner">
        <img class="bl-mark" src="/brand/bliss-coach-mark.png" alt="" width="22" height="22" />
        <h1 class="bl-title" data-title={COPY.tutorTitle} data-title-key="tutorTitle"></h1>
        <p class="fnl-sub" data-copy="tutorSubtitle">{COPY.tutorSubtitle}</p>
        <div class="bl-tutors" data-tutors></div>
        <button class="fnl-cta" type="button" data-action="next-from-tutor" data-copy="continue">{COPY.continue}</button>
      </div>
    </section>

    <!-- Vocabulary probe ---------------------------------------------------- -->
    <!--
      The level is never asked (app: ASKS_LEVEL = false). The grids measure it instead, starting on
      the easiest one and stepping up or down once — ticking nothing is still an answer.
    -->
    <section class="fnl-screen" data-screen="vocabulary">
      <div class="fnl-inner">
        <img class="bl-mark" src="/brand/bliss-coach-mark.png" alt="" width="22" height="22" />
        <h1 class="bl-title" data-vocab-title></h1>
        <p class="fnl-sub" data-vocab-tier></p>
        <div class="bl-words" data-words></div>
        <!-- Ticking nothing is an answer: the button says so rather than hiding a second link
             under it (the app's own rule — `ticked.length > 0 ? continue : vocabulary.none`). -->
        <button class="fnl-cta" type="button" data-action="words-done">{COPY.vocabularyNone}</button>
      </div>
    </section>

    <!-- Goal + optional deadline -------------------------------------------- -->
    <section class="fnl-screen" data-screen="goal">
      <div class="fnl-inner">
        <img class="bl-mark" src="/brand/bliss-coach-mark.png" alt="" width="22" height="22" />
        <h1 class="bl-title" data-title={COPY.goalTitle} data-title-key="goalTitle"></h1>
        <div class="bl-goals" data-goals></div>

        <div class="bl-deadline" data-deadline hidden>
          <div class="bl-deadline-head">
            <b data-copy="goalDeadline">{COPY.goalDeadline}</b>
            <em data-copy="optional">{COPY.optional}</em>
          </div>
          <div class="bl-chips" data-events></div>
          <label class="bl-date" data-date-field hidden>
            <span data-i18n="when">When is it?</span>
            <input type="date" data-date />
          </label>
          <button class="fnl-cta" type="button" data-action="goal-done" data-copy="continue">{COPY.continue}</button>
        </div>
      </div>
    </section>

    <!-- Name ---------------------------------------------------------------- -->
    <section class="fnl-screen" data-screen="name">
      <div class="fnl-inner">
        <img class="bl-mark" src="/brand/bliss-coach-mark.png" alt="" width="22" height="22" />
        <h1 class="bl-title" data-name-title></h1>
        <input class="bl-input" type="text" data-name-input placeholder={COPY.namePlaceholder} data-copy-placeholder="namePlaceholder" autocomplete="given-name" maxlength="50" />
        <button class="fnl-cta" type="button" data-action="name-done" data-copy="continue">{COPY.continue}</button>
      </div>
    </section>

    <!-- Where did you hear about us ----------------------------------------- -->
    <section class="fnl-screen" data-screen="heardAboutUs">
      <div class="fnl-inner">
        <h1 class="bl-title bl-title-plain" data-heard-title></h1>
        <p class="fnl-sub" data-heard-sub></p>
        <div class="bl-sources" data-sources></div>
        <button class="bl-skip" type="button" data-action="skip-heard"></button>
      </div>
    </section>

    <!-- Plan ready ----------------------------------------------------------- -->
    <section class="fnl-screen" data-screen="ready">
      <div class="fnl-inner">
        <img class="bl-mark" src="/brand/bliss-coach-mark.png" alt="" width="22" height="22" />
        <h1 class="bl-title" data-ready-title></h1>
        <p class="fnl-sub" data-ready-sub></p>

        <div class="bl-stats" data-stats></div>
        <ul class="bl-rows" data-rows></ul>

        <button class="fnl-cta" type="button" data-action="see-plan" data-copy="continue">{COPY.continue}</button>
      </div>
    </section>

    <!-- Paywall ------------------------------------------------------------ -->
    <!--
      The app's own paywall (`screens/paywall/bliss/BlissPaywall.tsx`), in its reading order:
      the teachers, the Bliss+ badge, the title, the pills of the plan THEY just built, the plans,
      the button, what it unlocks, the FAQ, the button again.

      Two things the app cannot show and the web keeps, both founder decisions of 2026-09-16: the
      countdown and the struck price. App Review forbids them (2.3.7 / 3.1.2); a web checkout does
      not. Everything else is the same screen.
    -->
    <section class="fnl-screen" data-screen="plan">
      {funnel.countdownMinutes > 0 && (
        <div class="fnl-countdown" data-countdown-bar>
          <span data-i18n="countdown">Your discount is reserved for</span>
          <strong data-countdown-clock>10:00</strong>
        </div>
      )}

      <div class="fnl-inner bl-paywall">
        <header class="bl-pw-head">
          <div class="bl-pw-row" data-pw-row></div>
          <span class="bl-plus"><b>Bliss</b><i>+</i></span>
          <h2 class="bl-pw-title" data-pw-title></h2>
          <p class="bl-pw-sub" data-pw-sub></p>
          <div class="bl-pw-pills" data-pw-pills></div>
        </header>

        <section class="bl-pw-section">
          <h3 data-i18n="pickPlan">Pick your plan</h3>
          <div class="bl-plans" data-plans>
            {funnel.plans.map((plan) => (
              <button class:list={['bl-plan', plan.highlight && 'is-highlight']} type="button" data-package={plan.packageId}>
                {plan.badge && <span class="bl-plan-badge">{plan.badge}</span>}
                <span class="bl-radio" aria-hidden="true"></span>
                <span class="bl-plan-main">
                  <span class="bl-plan-name">{plan.name}</span>
                  {plan.trialDays && <span class="bl-plan-trial" data-trial={String(plan.trialDays)}>{plan.trialDays} days free</span>}
                  <span class="bl-plan-sub" data-price={plan.price} data-save={String(plan.savePercent)}>
                    {plan.listPrice && <s>{plan.listPrice}</s>} {plan.price}
                    {plan.savePercent > 0 && <em class="bl-plan-save">−{plan.savePercent}% vs monthly</em>}
                  </span>
                </span>
                <span class="bl-plan-day">
                  <strong data-price={plan.perDay}>{plan.perDay}</strong>
                  <em>per day</em>
                </span>
              </button>
            ))}
          </div>

          <button class="fnl-cta" type="button" data-action="checkout" data-i18n="continue" disabled>Continue</button>
          {/* Every app sold here is iPhone-only: the script shows this and disables checkout on Android. */}
          <p class="fnl-warn" data-android-block hidden></p>
          <p class="bl-renewal" data-renewal></p>
          <p class="fnl-error" data-checkout-error hidden></p>

          {/* Shown by the script for the funnel actually running — see `data-checkout-ready-map`. */}
          <p class="fnl-warn" data-checkout-warn hidden>
            Checkout is not configured for this funnel. Set its
            <code>PUBLIC_RC_WEB_BILLING_URL_&lt;FUNNEL&gt;</code> secret in the deploy workflow, and turn
            on <strong>Allow anonymous sign-ins</strong> in Supabase → Authentication, before sending
            traffic here.
          </p>

          <ul class="bl-pay" aria-label="Accepted payment methods" data-i18n-aria="payAria">
            <li>VISA</li><li>Mastercard</li><li>Apple&nbsp;Pay</li><li>Google&nbsp;Pay</li><li>Amex</li>
          </ul>
          <p class="bl-secure" data-i18n="secure">Secure payment · Works on iPhone</p>
        </section>

        <section class="bl-pw-section">
          <h3 data-unlock-title>What Bliss+ unlocks</h3>
          <ul class="bl-unlock" data-included>
            {funnel.included.map((item) => (
              <li>
                <span class="bl-unlock-icon" aria-hidden="true">✓</span>
                <span><b>{item.title}</b><i>{item.body}</i></span>
              </li>
            ))}
          </ul>
        </section>

        <section class="bl-pw-section">
          <h3 data-i18n="faq">FAQ</h3>
          <dl class="bl-faq" data-faq>
            {funnel.faq.map((item) => (
              <>
                <dt>{item.q}</dt>
                <dd>{item.a}</dd>
              </>
            ))}
          </dl>
        </section>

        <section class="bl-pw-section">
          <h3 data-second-cta-title>Start speaking</h3>
          <div class="bl-plans" data-plans>
            {funnel.plans.map((plan) => (
              <button class:list={['bl-plan', plan.highlight && 'is-highlight']} type="button" data-package={plan.packageId}>
                {plan.badge && <span class="bl-plan-badge">{plan.badge}</span>}
                <span class="bl-radio" aria-hidden="true"></span>
                <span class="bl-plan-main">
                  <span class="bl-plan-name">{plan.name}</span>
                  {plan.trialDays && <span class="bl-plan-trial" data-trial={String(plan.trialDays)}>{plan.trialDays} days free</span>}
                  <span class="bl-plan-sub" data-price={plan.price} data-save={String(plan.savePercent)}>
                    {plan.listPrice && <s>{plan.listPrice}</s>} {plan.price}
                    {plan.savePercent > 0 && <em class="bl-plan-save">−{plan.savePercent}% vs monthly</em>}
                  </span>
                </span>
                <span class="bl-plan-day">
                  <strong data-price={plan.perDay}>{plan.perDay}</strong>
                  <em>per day</em>
                </span>
              </button>
            ))}
          </div>
          <button class="fnl-cta" type="button" data-action="checkout" data-i18n="continue" disabled>Continue</button>
          <p class="bl-renewal" data-renewal></p>
          <p class="fnl-error" data-checkout-error hidden></p>
          <p class="bl-legal" data-i18n-html="footerLegal"><a href="/privacy/">Privacy</a> · <a href="/terms/">Terms</a> · <a href="#cookies" data-consent-open>Cookies</a></p>
        </section>
      </div>
    </section>
  </div>
</Base>

<script>
  import {
    FUNNELS,
    DEFAULT_FUNNEL,
    SUPABASE_URL,
    SUPABASE_ANON_KEY,
    checkoutUrl,
    buyerCurrency,
    inCurrency,
    CHECKOUT_CONTEXT_KEY,
    type CheckoutContext,
  } from '../../config/funnel';
  import { track } from '../../lib/funnelTrack';
  import {
    STEPS,
    STEP_ANALYTICS_NAME,
    HEARD_ABOUT_US,
    DEADLINE_EVENTS,
    CEFR_TO_LEVEL_VALUE,
    INTRO_LESSONS,
    introSceneTimings,
    titleWordGroups,
    plainTitle,
    TITLE_WORD_STAGGER_MS,
    titleSettleMs,
    goalOptions,
    type Step,
  } from '../../config/bliss/onboarding';
  import {
    TAUGHT_LANGUAGES,
    LANGUAGE_BY_CODE,
    TUTORS,
    TUTOR_BY_PERSONA,
    tutorsForLanguage,
    recommendedTutor,
    hueStep,
    type Tutor,
  } from '../../config/bliss/tutors';
  import {
    probeWordsFor,
    hasVocabularyProbe,
    nextProbeTier,
    estimateVocabulary,
    MAX_PROBE_GRIDS,
    type ProbeResult,
    type VocabTier,
  } from '../../config/bliss/vocabularyProbe';
  import { detectUiLang, stringsFor, capitalise } from '../../config/bliss/i18n';

  /**
   * The interface language: French for a French browser (the paid traffic is French), English
   * otherwise. `?lang=` forces it. The taught language never changes with it.
   */
  const S = stringsFor(detectUiLang(window.location.search, navigator.languages?.length ? navigator.languages : [navigator.language]));
  document.documentElement.lang = S.lang;

  const STORAGE_KEY = 'bliss_funnel_v3';

  /**
   * Which language each teacher demonstrates on the intro row. The natives teach their own; the
   * bilingual friends each take a language nobody else in the row is showing, so the rotation walks
   * through as many languages as it can (the app's `introRowItems` rule).
   */
  const DEMO_LANGUAGE: Record<string, string> = {
    sofia: 'es', amelie: 'fr', emily: 'en', meilin: 'zh',
    alex: 'it', mila: 'de', astra: 'pt', charm: 'en',
  };

  /**
   * Ad attribution, captured from the landing URL and carried to checkout.
   *
   * This is the reason the web funnel exists: on the App Store path these installs land in
   * AppsFlyer's `restricted` bucket with no campaign attached, because the user never resolved ATT.
   * On the web the click ids are simply in the URL and stay ours.
   */
  const ATTRIBUTION_KEYS = [
    'utm_source', 'utm_medium', 'utm_campaign', 'utm_content', 'utm_term',
    'fbclid', 'ttclid', 'gclid', 'gbraid', 'wbraid',
  ];

  function initFunnel(): void {
    const found = document.querySelector<HTMLElement>('.fnl');
    if (!found || found.dataset.initialised === '1') return;
    // Bound to a non-null local: every closure below captures it, and TypeScript keeps the guard.
    const root: HTMLElement = found;
    root.dataset.initialised = '1';

    // `?t=sofia` sells the single-tutor app: same flow, language and tutor locked. Anything else
    // falls back to the page's own funnel rather than rendering a funnel that does not exist.
    const query = new URLSearchParams(window.location.search);
    const requested = query.get('t') ?? '';
    const funnel = FUNNELS[requested] ?? FUNNELS[root.dataset.funnel ?? DEFAULT_FUNNEL] ?? FUNNELS[DEFAULT_FUNNEL];
    const currency = buyerCurrency(funnel);
    const localPrice = (price: string): string => S.price(inCurrency(price, currency));
    // The markup is rendered with Bliss's plans at build time, and only Bliss's yearly has a trial:
    // `?t=sofia` / `?t=emily` must not promise one their checkout does not have.
    root.querySelectorAll<HTMLElement>('.bl-plan').forEach((btn) => {
      const plan = funnel.plans.find((p) => p.packageId === btn.dataset.package);
      if (!plan?.trialDays) btn.querySelector('.bl-plan-trial')?.remove();
    });
    // The markup is rendered in euros at build time; a dollar visitor gets the same numbers in $.
    // (Non-English interfaces rewrite these nodes again below, through `localPrice`.)
    if (currency === 'USD') {
      root.querySelectorAll<HTMLElement>('.bl-plan-sub, .bl-plan-day strong').forEach((el) => {
        const walker = document.createTreeWalker(el, NodeFilter.SHOW_TEXT);
        for (let n = walker.nextNode(); n; n = walker.nextNode()) {
          n.textContent = (n.textContent ?? '').replace(/€(?=\d)/g, '$');
        }
      });
    }
    root.dataset.funnel = funnel.id;

    // Per funnel: Sofia's checkout cannot sell Emily's app, so each one is configured on its own and
    // an unconfigured funnel disables only its own paywall.
    const checkoutReady = (() => {
      try {
        const map = JSON.parse(root.dataset.checkoutReadyMap ?? '{}');
        if (typeof map[funnel.id] === 'boolean') return map[funnel.id] as boolean;
      } catch {
        /* fall back to the page's own default */
      }
      return root.dataset.checkoutReady === '1';
    })();
    root.querySelectorAll<HTMLElement>('[data-checkout-warn]').forEach((el) => {
      el.hidden = checkoutReady;
    });
    // The apps sold here exist on iPhone only. Taking an Android visitor's money would sell a
    // subscription they cannot use (refund, dispute, and a chargeback on the Stripe account), so the
    // paywall says so and never opens the checkout on Android.
    const isAndroid = /android/i.test(navigator.userAgent);
    const appName = funnel.app.charAt(0).toUpperCase() + funnel.app.slice(1);
    let androidBlockTracked = false;
    const startedAt = Date.now();

    const attribution: Record<string, string> = {};
    ATTRIBUTION_KEYS.forEach((key) => {
      const value = query.get(key);
      if (value) attribution[key] = value.slice(0, 200);
    });

    // What the server-side Purchase (RevenueCat webhook -> `web-purchase-capi`) needs to report this
    // buyer to Meta, captured at checkout. ONLY when the visitor accepted advertising cookies: with a
    // refusal we store `ads_consent: '0'` and nothing else, and the server sends nothing (CNIL — the
    // server must not do what the browser was told not to).
    function adSignals(): Record<string, string> {
      let ads = false;
      try {
        const c = JSON.parse(localStorage.getItem('bliss_consent_v1') || 'null');
        ads = !!(c && c.v === 1 && c.ads);
      } catch {}
      if (!ads) return { ads_consent: '0' };
      const cookie = (k: string) => {
        const m = document.cookie.match(new RegExp('(?:^|; )' + k + '=([^;]*)'));
        return m ? decodeURIComponent(m[1]) : '';
      };
      const out: Record<string, string> = { ads_consent: '1', consent_at: new Date().toISOString() };
      const fbp = cookie('_fbp'), fbc = cookie('_fbc'), ttp = cookie('_ttp');
      if (fbp) out.fbp = fbp.slice(0, 200);
      if (fbc) out.fbc = fbc.slice(0, 500);
      else if (attribution.fbclid) out.fbc = `fb.1.${Date.now()}.${attribution.fbclid}`;
      if (ttp) out.ttp = ttp.slice(0, 200);
      out.ua = navigator.userAgent.slice(0, 400);
      return out;
    }

    // ── State ───────────────────────────────────────────────────────────────
    let language = funnel.lockedLanguage ?? '';
    let persona = funnel.lockedPersona ?? '';
    let probeResults: ProbeResult[] = [];
    let knownWords: string[] = [];
    let currentTier: VocabTier = 'basic';
    let goal = '';
    let deadlineEvent = '';
    let deadlineDate = '';
    let firstName = '';
    let heardAboutUs = '';
    let chosenPackage = funnel.plans.find((p) => p.highlight)?.packageId ?? funnel.plans[0].packageId;

    const tutor = (): Tutor => TUTOR_BY_PERSONA[persona] ?? recommendedTutor(language || 'es');
    const languageName = (): string => S.languageName(language, LANGUAGE_BY_CODE[language]?.name ?? '');
    const langLabel = (): string => capitalise(languageName());

    // ── Static text in the interface language ───────────────────────────────
    // The markup ships in English (it is the source); French replaces it before the first screen
    // renders. Titles are swapped on `data-title`, so the word-by-word reveal runs on the French.
    if (S.lang !== 'en') {
      const copy = S.copy as Record<string, string>;
      root.querySelectorAll<HTMLElement>('[data-title-key]').forEach((el) => {
        const t = copy[el.dataset.titleKey ?? ''];
        if (t) el.dataset.title = t;
      });
      root.querySelectorAll<HTMLElement>('[data-copy]').forEach((el) => {
        const t = copy[el.dataset.copy ?? ''];
        if (t) el.textContent = t;
      });
      root.querySelectorAll<HTMLInputElement>('[data-copy-placeholder]').forEach((el) => {
        const t = copy[el.dataset.copyPlaceholder ?? ''];
        if (t) el.placeholder = t;
      });
      const table = S.static ?? {};
      root.querySelectorAll<HTMLElement>('[data-i18n]').forEach((el) => {
        const t = table[el.dataset.i18n ?? ''];
        if (t) el.textContent = t;
      });
      // Only our own strings, with our own links — never visitor input.
      root.querySelectorAll<HTMLElement>('[data-i18n-html]').forEach((el) => {
        const t = table[el.dataset.i18nHtml ?? ''];
        if (t) el.innerHTML = t;
      });
      root.querySelectorAll<HTMLElement>('[data-i18n-aria]').forEach((el) => {
        const t = table[el.dataset.i18nAria ?? ''];
        if (t) el.setAttribute('aria-label', t);
      });
      root.querySelectorAll<HTMLButtonElement>('.bl-plan').forEach((btn) => {
        const plan = funnel.plans.find((p) => p.packageId === btn.dataset.package);
        if (!plan) return;
        const name = btn.querySelector<HTMLElement>('.bl-plan-name');
        if (name) name.textContent = S.planName(plan.packageId, plan.name);
        const badge = btn.querySelector<HTMLElement>('.bl-plan-badge');
        if (badge && plan.badge) badge.textContent = S.mostPopular;
        const sub = btn.querySelector<HTMLElement>('.bl-plan-sub');
        if (sub) {
          sub.textContent = localPrice(plan.price);
          if (plan.savePercent > 0) {
            const save = document.createElement('em');
            save.className = 'bl-plan-save';
            save.textContent = S.saveVsMonthly(plan.savePercent);
            sub.append(' ', save);
          }
        }
        const perDay = btn.querySelector<HTMLElement>('.bl-plan-day strong');
        if (perDay) perDay.textContent = localPrice(plan.perDay);
        const perDayLabel = btn.querySelector<HTMLElement>('.bl-plan-day em');
        if (perDayLabel) perDayLabel.textContent = S.perDay;
        const trial = btn.querySelector<HTMLElement>('.bl-plan-trial');
        if (trial && plan.trialDays) trial.textContent = S.trialTag(plan.trialDays);
      });
      const included = S.included(funnel.id);
      const unlockList = root.querySelector<HTMLElement>('[data-included]');
      if (included && unlockList) {
        unlockList.textContent = '';
        included.forEach((item) => {
          const li = document.createElement('li');
          li.innerHTML = '<span class="bl-unlock-icon" aria-hidden="true">✓</span><span><b></b><i></i></span>';
          (li.querySelector('b') as HTMLElement).textContent = item.title;
          (li.querySelector('i') as HTMLElement).textContent = item.body;
          unlockList.appendChild(li);
        });
      }
      const faqList = root.querySelector<HTMLElement>('[data-faq]');
      if (S.faq && faqList) {
        faqList.textContent = '';
        S.faq.forEach((item) => {
          const dt = document.createElement('dt');
          dt.textContent = item.q;
          const dd = document.createElement('dd');
          dd.textContent = item.a;
          faqList.append(dt, dd);
        });
      }
    }

    function persist(): void {
      try {
        localStorage.setItem(
          STORAGE_KEY,
          JSON.stringify({ language, persona, goal, firstName, chosenPackage }),
        );
      } catch {
        /* private mode: the funnel works, it simply does not resume */
      }
    }

    // ── Screens ─────────────────────────────────────────────────────────────
    const screens = new Map<string, HTMLElement>();
    root.querySelectorAll<HTMLElement>('[data-screen]').forEach((el) => {
      screens.set(el.dataset.screen as string, el);
    });

    /** A locked funnel (Sofia) skips the two steps that would be a lie, and the probe needs a grid. */
    function sequence(): Step[] {
      return STEPS.filter((step) => {
        if (step === 'language' || step === 'tutor') return !funnel.lockedLanguage;
        if (step === 'vocabulary') return hasVocabularyProbe(language || null);
        return true;
      });
    }

    let current: Step = 'intro';
    const backBtn = root.querySelector<HTMLButtonElement>('.fnl-back');
    const fill = root.querySelector<HTMLElement>('.fnl-progress-fill');
    const bar = root.querySelector<HTMLElement>('.fnl-progress');

    function show(id: Step, opts: { push?: boolean } = {}): void {
      const el = screens.get(id);
      if (!el) return;
      current = id;
      screens.forEach((s) => s.classList.remove('is-active'));
      el.classList.add('is-active');

      const steps = sequence();
      const i = steps.indexOf(id);
      const span = Math.max(1, steps.length - 1);
      const pct = i <= 0 ? 0 : Math.round(Math.min(1, i / span) * 100);
      if (fill) fill.style.width = `${pct}%`;
      if (bar) bar.setAttribute('aria-valuenow', String(pct));
      if (backBtn) backBtn.hidden = i <= 0;

      window.scrollTo({ top: 0, behavior: 'instant' as ScrollBehavior });
      if (opts.push !== false) history.pushState({ screen: id }, '', `#${id}`);
      // The rail can only be measured once it is on screen — see `railFocus`. `is-active` was set
      // synchronously just above, so measuring here forces one layout and reads the real numbers.
      //
      // ⚠️ Not on `requestAnimationFrame` alone: a page in a background tab (or a preview pane that
      // is not being composited) never runs its rAF callbacks, and the rail would then open with no
      // `--d` at all — no ring, no colour, every card dimmed. The second pass catches a late shift
      // from a font or an image.
      if (id === 'tutor') {
        centreOn(persona, 'instant');
        selectTutor(persona);
        requestAnimationFrame(() => centreOn(persona, 'instant'));
      }
      revealTitles(el);
      track('funnel_step_view', { funnel: funnel.id, step: STEP_ANALYTICS_NAME[id] });
    }

    function advance(): void {
      const steps = sequence();
      const next = steps[steps.indexOf(current) + 1];
      if (next) show(next);
    }

    // ── Titles: the accent never breaks, and the words land one by one ──────
    //
    // Ported from the app (`titleWordGroups`): the words between *asterisks* are the accent
    // (Instrument Serif italic), they are one unbreakable word, and a multi-word accent starts its
    // own line only when at least three words come before it.
    function renderTitle(el: HTMLElement, raw: string): void {
      el.textContent = '';
      el.setAttribute('aria-label', plainTitle(raw));
      let index = 0;
      titleWordGroups(raw).forEach((group) => {
        if (group.breakBefore) el.appendChild(document.createElement('br'));
        const word = document.createElement('span');
        word.className = 'bl-word';
        word.style.animationDelay = `${index * TITLE_WORD_STAGGER_MS}ms`;
        group.runs.forEach((run) => {
          const span = document.createElement('span');
          span.textContent = run.text;
          if (run.accent) span.className = 'bl-em';
          word.appendChild(span);
        });
        el.appendChild(word);
        el.appendChild(document.createTextNode(' '));
        index += 1;
      });
    }

    /** Re-run the reveal each time a screen is shown, so a back-and-forward is not a static page. */
    function revealTitles(screen: HTMLElement): void {
      screen.querySelectorAll<HTMLElement>('.bl-title').forEach((el) => {
        const raw = el.dataset.title;
        if (raw) renderTitle(el, raw);
        const inner = el.closest('.fnl-inner');
        const answers = inner?.querySelector<HTMLElement>('.bl-langs, .bl-tutors, .bl-words, .bl-goals, .bl-sources, .bl-stats, .bl-input, .fnl-cta');
        if (!raw || !answers) return;
        // The answers arrive while the title is still landing — never later than a second
        // (founder, 2026-09-17: « les réponses mettent trop de temps à apparaître »).
        inner?.classList.add('is-settling');
        window.setTimeout(() => inner?.classList.remove('is-settling'), titleSettleMs(raw));
      });
    }

    // ── Intro demo ──────────────────────────────────────────────────────────
    const demo = {
      stage: root.querySelector<HTMLElement>('[data-demo]'),
      photo: root.querySelector<HTMLImageElement>('[data-demo-photo]'),
      name: root.querySelector<HTMLElement>('[data-demo-name]'),
      traits: root.querySelector<HTMLElement>('[data-demo-traits]'),
      card: root.querySelector<HTMLElement>('[data-demo-card]'),
      lights: root.querySelector<HTMLElement>('[data-demo-lights]'),
      bubble: root.querySelector<HTMLElement>('[data-demo-bubble]'),
      bubbleName: root.querySelector<HTMLElement>('[data-demo-bubble-name]'),
      dots: root.querySelector<HTMLElement>('[data-demo-dots]'),
      line: root.querySelector<HTMLElement>('[data-demo-line]'),
      lineRoman: root.querySelector<HTMLElement>('[data-demo-line-roman]'),
      reply: root.querySelector<HTMLElement>('[data-demo-reply]'),
      mic: root.querySelector<HTMLElement>('[data-demo-mic]'),
      replyWords: root.querySelector<HTMLElement>('[data-demo-reply-words]'),
      replyRoman: root.querySelector<HTMLElement>('[data-demo-reply-roman]'),
      strip: root.querySelector<HTMLElement>('[data-strip]'),
      video: root.querySelector<HTMLVideoElement>('[data-demo-video]'),
    };
    const tutorVideos: Record<string, string> = (() => {
      try {
        return JSON.parse(root.dataset.tutorVideos ?? '{}');
      } catch {
        return {};
      }
    })();
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let demoTimers: number[] = [];

    function stopDemo(): void {
      demoTimers.forEach((t) => window.clearTimeout(t));
      demoTimers = [];
    }

    /** The teachers the row walks through: everyone, or only the locked one. */
    function demoRow(): Tutor[] {
      if (funnel.lockedPersona) {
        const only = TUTOR_BY_PERSONA[funnel.lockedPersona];
        return only ? [only] : TUTORS.slice(0, 1);
      }
      // Opens on Charm, in English (founder 2026-09-24). Emily also demos English: she goes last so
      // the row never shows the same language twice in a row.
      const first = ['charm'];
      const last = ['emily'];
      const rank = (p: string) => (first.includes(p) ? -1 : last.includes(p) ? 1 : 0);
      return TUTORS.filter((t) => INTRO_LESSONS[DEMO_LANGUAGE[t.persona]])
        .map((t, i) => ({ t, i }))
        .sort((a, b) => rank(a.t.persona) - rank(b.t.persona) || a.i - b.i)
        .map(({ t }) => t);
    }

    function playScene(sceneIndex: number): void {
      const row = demoRow();
      if (row.length === 0 || !demo.line) return;
      const who = row[sceneIndex % row.length];
      const code = funnel.lockedLanguage ?? DEMO_LANGUAGE[who.persona];
      const lesson = INTRO_LESSONS[code];
      if (!lesson) return;

      // Her card and her colour. The stage carries `--tutor` so the bubble's dot, the gradient frame
      // and the words all take the colour of whoever is on screen — the card is not the only thing
      // that changes teacher.
      if (demo.stage) {
        demo.stage.style.setProperty('--tutor-glow', who.glow);
        demo.stage.style.setProperty('--tutor-veil', who.veil);
        demo.stage.style.setProperty('--tutor-1', who.gradient[0]);
        demo.stage.style.setProperty('--tutor-2', who.gradient[1]);
        demo.stage.style.setProperty('--tutor-3', who.gradient[2]);
        demo.stage.style.setProperty('--tutor-accent', who.accent);
      }
      if (demo.photo) {
        demo.photo.src = `/home/${who.photo}`;
        demo.photo.alt = S.demoAlt(who.name, S.languageName(code, LANGUAGE_BY_CODE[code]?.name ?? ''));
      }
      // The photo stays underneath as the poster: the loop fades in over it once it can play, and a
      // failed or blocked video simply leaves the photo.
      const video = demo.video;
      const file = tutorVideos[who.persona];
      if (video) {
        if (file && !reduceMotion) {
          const src = `/home/video/${file}`;
          if (!video.src.endsWith(src)) {
            video.classList.remove('is-playing');
            video.hidden = false;
            video.src = src;
            video.oncanplay = () => {
              video.play().then(() => video.classList.add('is-playing')).catch(() => { video.hidden = true; });
            };
            video.onerror = () => { video.hidden = true; };
          }
        } else {
          video.hidden = true;
          video.removeAttribute('src');
        }
      }
      if (demo.name) demo.name.textContent = who.name;
      if (demo.lights && !demo.lights.hasChildNodes()) demo.lights.innerHTML = lights().replace(/<\/?span[^>]*>/g, '');
      if (demo.bubbleName) demo.bubbleName.textContent = who.name;
      if (demo.traits) {
        // Two traits in compact, as in the app: the face must stay clear.
        demo.traits.textContent = '';
        S.traits(who.persona, who.traits).slice(0, 2).forEach((trait) => {
          const pill = document.createElement('span');
          pill.className = 'bl-pill';
          pill.textContent = trait;
          demo.traits?.appendChild(pill);
        });
      }
      centreStrip(who.persona);

      demo.line.textContent = '';
      if (demo.dots) demo.dots.hidden = false;
      if (demo.bubble) {
        demo.bubble.classList.remove('is-out');
        demo.bubble.classList.add('is-in');
      }
      if (demo.lineRoman) {
        demo.lineRoman.textContent = lesson.lineRomanization ?? '';
        demo.lineRoman.hidden = true;
      }
      if (demo.reply) demo.reply.hidden = true;
      if (demo.mic) demo.mic.classList.remove('is-done');
      if (demo.replyWords) demo.replyWords.textContent = '';

      const chars = Array.from(lesson.line);
      const timings = introSceneTimings(chars.length, lesson.replyWords.length);

      // Three typing dots before the first letter, then the sentence is written at 45 ms a character.
      chars.forEach((_, i) => {
        demoTimers.push(
          window.setTimeout(() => {
            if (demo.dots) demo.dots.hidden = true;
            if (demo.line) demo.line.textContent = chars.slice(0, i + 1).join('');
            if (i + 1 === chars.length && demo.lineRoman && lesson.lineRomanization) {
              demo.lineRoman.hidden = false;
            }
          }, timings.charAt(i + 1)),
        );
      });

      demoTimers.push(
        window.setTimeout(() => {
          if (!demo.reply || !demo.replyWords) return;
          demo.reply.hidden = false;
          demo.reply.classList.add('is-in');
          demo.replyWords.textContent = '';
          lesson.replyWords.forEach((word, w) => {
            const span = document.createElement('span');
            span.className = 'bl-reply-word';
            span.textContent = (w > 0 ? lesson.wordJoiner : '') + word;
            demo.replyWords?.appendChild(span);
            demoTimers.push(
              window.setTimeout(() => {
                span.classList.add('is-said');
                // The mic badge is speaking while words are landing, and becomes a check at the end.
                if (w === lesson.replyWords.length - 1 && demo.mic) demo.mic.classList.add('is-done');
              }, timings.wordAt(w) - timings.replyAt),
            );
          });
          if (demo.replyRoman) {
            demo.replyRoman.textContent = lesson.replyRomanization ?? '';
            demo.replyRoman.hidden = !lesson.replyRomanization;
          }
        }, timings.replyAt),
      );

      // The scene rests, then the bubbles fade and the next teacher takes over.
      demoTimers.push(
        window.setTimeout(() => {
          demo.bubble?.classList.add('is-out');
          demo.reply?.classList.add('is-out');
        }, timings.fadeAt),
      );
      demoTimers.push(
        window.setTimeout(() => {
          demo.reply?.classList.remove('is-in', 'is-out');
          playScene(sceneIndex + 1);
        }, timings.endAt),
      );
    }

    /**
     * The row of teachers under the intro (the app's `GuidedAvatarStrip` in carousel mode): every
     * face once, the one the scene is showing in the middle. Founder, 2026-09-17: the bottom of the
     * intro was empty space, and this is what fills it — with the thing being sold.
     */
    function buildStrip(): void {
      if (!demo.strip) return;
      // A single-tutor funnel (Emily, Sofia) has one face: a "row of teachers" of one card, shown
      // twice, reads as a glitch (founder, 2026-09-18). No row at all; the stage takes the room.
      if (funnel.lockedPersona) {
        demo.strip.hidden = true;
        return;
      }
      demo.strip.textContent = '';
      // One inner rail that slides: moving each card would fight the row's own layout.
      const rail = document.createElement('span');
      rail.className = 'bl-strip-inner';
      demo.strip.appendChild(rail);
      // The row twice: the app's carousel always has faces on BOTH sides of the centre, and a row
      // that starts on its first card leaves the left half of the screen empty.
      const row = demoRow();
      [...row, ...row].forEach((t) => {
        const item = document.createElement('span');
        item.className = 'bl-strip-card';
        item.dataset.persona = t.persona;
        item.style.setProperty('--tutor', t.gradient[1]);
        item.innerHTML = `<img src="/home/${t.photo}" alt="" width="54" height="66" loading="lazy" /><i></i>`;
        rail.appendChild(item);
      });
    }

    function centreStrip(persona: string): void {
      if (!demo.strip) return;
      const cards = Array.from(demo.strip.querySelectorAll<HTMLElement>('.bl-strip-card'));
      // Prefer the copy in the second half, so there is always something to the left.
      const half = Math.floor(cards.length / 2);
      const inSecond = cards.findIndex((c, k) => k >= half && c.dataset.persona === persona);
      const i = inSecond >= 0 ? inSecond : cards.findIndex((c) => c.dataset.persona === persona);
      cards.forEach((c, k) => c.classList.toggle('is-centre', k === i));
      if (i < 0) return;
      // Slide the rail so the current face sits in the middle of the row. Same rule as `railFocus`:
      // viewport coordinates, never `offsetLeft` — the strip is not the cards' offsetParent either.
      const card = cards[i];
      const rail = demo.strip.querySelector<HTMLElement>('.bl-strip-inner');
      if (!rail) return;
      const stripRect = demo.strip.getBoundingClientRect();
      const rect = card.getBoundingClientRect();
      const current = Number.parseFloat(getComputedStyle(rail).getPropertyValue('--shift')) || 0;
      const delta = rect.left + rect.width / 2 - (stripRect.left + stripRect.width / 2);
      rail.style.setProperty('--shift', `${current - delta}px`);
    }

    // ── Language ────────────────────────────────────────────────────────────
    const langsEl = root.querySelector<HTMLElement>('[data-langs]');
    if (langsEl) {
      TAUGHT_LANGUAGES.forEach((lang) => {
        const btn = document.createElement('button');
        btn.type = 'button';
        // The app's `LanguageTileGrid`: the tile IS the colour, with the language's own name above
        // its English one and a white code badge. Not a white card with a coloured square.
        btn.className = 'bl-lang';
        const recommended = recommendedTutor(lang.code);
        btn.style.setProperty('--tutor-1', recommended.gradient[0]);
        btn.style.setProperty('--tutor-2', recommended.gradient[1]);
        btn.style.setProperty('--tutor-3', recommended.gradient[2]);
        btn.style.setProperty('--hue', `${hueStep(recommended.persona, lang.code)}deg`);
        btn.innerHTML =
          '<span class="bl-lang-top"><i class="bl-lang-native"></i><b class="bl-lang-badge"></b></span>' +
          '<span class="bl-lang-name"></span>';
        (btn.querySelector('.bl-lang-native') as HTMLElement).textContent = lang.native;
        (btn.querySelector('.bl-lang-badge') as HTMLElement).textContent = lang.badge;
        (btn.querySelector('.bl-lang-name') as HTMLElement).textContent = capitalise(S.languageName(lang.code, lang.name));
        btn.addEventListener('click', () => {
          language = lang.code;
          persona = recommendedTutor(lang.code).persona;
          currentTier = 'basic';
          probeResults = [];
          knownWords = [];
          persist();
          paintTutor();
          track('funnel_answer', { funnel: funnel.id, step: 'bliss_language', value: lang.code });
          buildTutors();
          advance();
        });
        langsEl.appendChild(btn);
      });
    }

    // ── Tutor ───────────────────────────────────────────────────────────────
    const tutorsEl = root.querySelector<HTMLElement>('[data-tutors]');

    /** The chosen teacher's colour drives the whole screen from here on, as it does in the app. */
    /**
     * The light particles that drift up the coloured band of a card (`GlowParticles` in the app:
     * ten dots, seeded once, rising and twinkling). Ten spans with fixed offsets — a seeded random
     * would look identical and cost a script; what matters is that they are irregular, not random.
     */
    function lights(): string {
      const seeds = [
        [8, 74, 3, 0], [22, 88, 2, 3.1], [35, 66, 4, 1.4], [47, 92, 2.5, 5.2], [58, 71, 3, 2.3],
        [66, 85, 2, 6.6], [74, 63, 3.5, 4.1], [82, 90, 2.5, 1.1], [90, 70, 3, 7.4], [16, 60, 2, 8.8],
      ];
      return (
        '<span class="bl-lights" aria-hidden="true">' +
        seeds
          .map(
            ([x, y, size, delay]) =>
              `<i style="left:${x}%;top:${y}%;width:${size}px;height:${size}px;animation-delay:-${delay}s"></i>`,
          )
          .join('') +
        '</span>'
      );
    }

    function paintTutor(): void {
      const t = tutor();
      root.style.setProperty('--tutor-1', t.gradient[0]);
      root.style.setProperty('--tutor-2', t.gradient[1]);
      root.style.setProperty('--tutor-3', t.gradient[2]);
      root.style.setProperty('--tutor-accent', t.accent);
      root.style.setProperty('--tutor-soft', t.soft);
      root.style.setProperty('--tutor-wash', t.wash);
      // The teacher's colour takes the whole screen from here on — the CTA, the progress bar and the
      // paywall included. In the app it is the same rule: after the tutor step, she tints everything.
      root.style.setProperty('--brand-1', t.gradient[0]);
      root.style.setProperty('--brand-2', t.gradient[1]);
      root.style.setProperty('--brand-3', t.gradient[2]);
      root.style.setProperty('--accent', t.accent);
      root.style.setProperty('--tutor-glow', t.glow);
      root.style.setProperty('--tutor-veil', t.veil);
    }

    function buildTutors(): void {
      if (!tutorsEl || !language) return;
      tutorsEl.textContent = '';
      tutorsForLanguage(language).forEach((t, i) => {
        const btn = document.createElement('button');
        btn.type = 'button';
        // The site's own coach card (`.ccard` on the home page) — which is exactly what the app's
        // `TutorPickCard` was built from: portrait edge to edge, a scrim, her name, the serif line
        // in her colours, and her character in glass pills.
        btn.className = 'bl-card bl-tutor';
        btn.dataset.persona = t.persona;
        btn.style.setProperty('--tutor-1', t.gradient[0]);
        btn.style.setProperty('--tutor-2', t.gradient[1]);
        btn.style.setProperty('--tutor-3', t.gradient[2]);
        btn.style.setProperty('--tutor-accent', t.accent);
        btn.style.setProperty('--tutor-glow', t.glow);
        btn.style.setProperty('--tutor-veil', t.veil);
        btn.innerHTML =
          `<img class="bl-card-photo" src="/home/${t.photo}" alt="" width="300" height="400" loading="lazy" />` +
          '<span class="bl-card-scrim"></span>' +
          '<span class="bl-card-tags"><span class="bl-pill bl-pill-lang"></span>' +
          (i === 0 ? '<span class="bl-pill bl-pill-reco"></span>' : '') +
          '</span>' +
          '<span class="bl-card-text"><b></b><em></em><span class="bl-card-traits"></span></span>' +
          '<span class="bl-sheen"></span>' +
          lights();
        (btn.querySelector('.bl-pill-lang') as HTMLElement).textContent = langLabel();
        const reco = btn.querySelector<HTMLElement>('.bl-pill-reco');
        if (reco) reco.textContent = S.recommended;
        (btn.querySelector('.bl-card-text b') as HTMLElement).textContent = t.name;
        (btn.querySelector('.bl-card-text em') as HTMLElement).textContent = S.tutorTag(t.native === language, t.persona);
        const traits = btn.querySelector('.bl-card-traits') as HTMLElement;
        S.traits(t.persona, t.traits).forEach((trait) => {
          const pill = document.createElement('span');
          pill.className = 'bl-pill';
          pill.textContent = trait;
          traits.appendChild(pill);
        });
        // A tap selects her AND brings her to the centre. It does not wait for the scroll to report
        // back: a smooth scroll emits no event at all in a page whose frames are not being
        // composited (a background tab), and the tap would then do nothing at all.
        btn.addEventListener('click', () => {
          selectTutor(t.persona);
          centreOn(t.persona, 'smooth');
        });
        tutorsEl.appendChild(btn);
      });
    }

    /**
     * THE CENTRED CARD IS THE CHOSEN ONE.
     *
     * In the app the rail is a carousel: you swipe a teacher to the middle and that IS the choice
     * (`onIndexChange` → `onTutorCard`). Selecting by tap instead left the card under the thumb dim
     * and the chosen one off screen — which is what made the web rail read as broken.
     *
     * `--d` is the site's own carousel variable (`.ccard`): 0 for the card under the middle of the
     * track, 1 for one a card-width away. It drives the scale and the darkening, so the whole row
     * reacts as you drag rather than snapping between two states.
     */
    function railFocus(opts: { select?: boolean } = {}): void {
      if (!tutorsEl) return;
      const cards = Array.from(tutorsEl.querySelectorAll<HTMLElement>('.bl-tutor'));
      if (cards.length === 0) return;
      // The rail is built while its screen is still hidden, so every card measures 0 there. Dividing
      // by that width produced `--d: NaN`, which Chrome resolves to 0 inside the calc() — and
      // `scale(0)` made the whole rail invisible. Measure only once it has a size.
      const width = cards[0].offsetWidth;
      if (width <= 0 || tutorsEl.clientWidth <= 0) return;
      // ⚠️ MEASURE IN VIEWPORT COORDINATES, NEVER `offsetLeft`.
      // A card is `position: relative`, so its offsetParent is the nearest positioned ancestor —
      // NOT the scroller. On a phone the rail starts at x≈0 and the error was small enough to hide;
      // on a wide screen the column is centred, the error became hundreds of pixels, and the card
      // the maths called "centred" was two cards away from the one under your eyes: the wrong card
      // took the ring and the teacher's colour, and the real centre stayed dimmed.
      const railRect = tutorsEl.getBoundingClientRect();
      const mid = railRect.left + railRect.width / 2;
      let centre: HTMLElement | null = null;
      let best = Infinity;
      for (const card of cards) {
        const rect = card.getBoundingClientRect();
        // Position from the rect (exact wherever the rail sits), size from `offsetWidth` (the rect's
        // width is the SCALED one, which would make `--d` drift as the cards shrink).
        const d = Math.abs(rect.left + rect.width / 2 - mid) / (width * 1.05);
        card.style.setProperty('--d', Math.min(d, 1).toFixed(3));
        if (d < best) {
          best = d;
          centre = card;
        }
      }
      // `select: false` is for a centring we asked for ourselves: at the instant `scrollTo` is
      // called the rail has not moved yet, so the card still under the middle is the OLD one — and
      // reading the selection from it would immediately undo the tap that asked for the move.
      if (opts.select !== false && centre?.dataset.persona) selectTutor(centre.dataset.persona);
    }

    /** The chosen teacher: her ring, her colour on the whole screen, one analytics event per change. */
    function selectTutor(picked: string): void {
      if (!tutorsEl) return;
      tutorsEl.querySelectorAll<HTMLElement>('.bl-tutor').forEach((card) => {
        card.classList.toggle('is-selected', card.dataset.persona === picked);
      });
      if (picked === persona) return;
      persona = picked;
      persist();
      paintTutor();
      track('funnel_answer', { funnel: funnel.id, step: 'bliss_tutor', value: picked });
    }

    /**
     * The side padding that lets the FIRST and LAST teacher reach the middle: half the rail minus
     * half a card, measured, not expressed as a percentage.
     *
     * A percentage padding resolves against the containing block — here the column, 420px wide —
     * while the scroller itself is 460px because of its negative margins. The 20px difference meant
     * the first card stopped 20px short of the centre: it could never reach `--d: 0`, so it kept a
     * sliver of the dimming that is supposed to belong to its neighbours.
     */
    function sizeRail(): void {
      if (!tutorsEl) return;
      const card = tutorsEl.querySelector<HTMLElement>('.bl-tutor');
      if (!card || tutorsEl.clientWidth <= 0 || card.offsetWidth <= 0) return;
      const pad = Math.max(0, (tutorsEl.clientWidth - card.offsetWidth) / 2);
      tutorsEl.style.paddingInline = `${pad}px`;
    }

    /** Put a teacher under the middle of the rail — same viewport maths as `railFocus`. */
    function centreOn(target: string, behavior: ScrollBehavior): void {
      if (!tutorsEl) return;
      const card = tutorsEl.querySelector<HTMLElement>(`.bl-tutor[data-persona="${target}"]`);
      if (!card) return;
      sizeRail();
      const railRect = tutorsEl.getBoundingClientRect();
      const rect = card.getBoundingClientRect();
      const delta = rect.left + rect.width / 2 - (railRect.left + railRect.width / 2);
      tutorsEl.scrollTo({ left: tutorsEl.scrollLeft + delta, behavior });
      railFocus({ select: false });
    }

    // Throttled by the clock rather than by `requestAnimationFrame`: a page whose frames are not
    // being composited never runs a rAF callback, and the rail would then stop reacting entirely.
    let lastFocus = 0;
    tutorsEl?.addEventListener(
      'scroll',
      () => {
        const now = performance.now();
        if (now - lastFocus < 16) return;
        lastFocus = now;
        railFocus();
      },
      { passive: true },
    );
    window.addEventListener(
      'resize',
      () =>
        requestAnimationFrame(() => {
          sizeRail();
          railFocus();
        }),
      { passive: true },
    );

    // ── Vocabulary probe ────────────────────────────────────────────────────
    const wordsEl = root.querySelector<HTMLElement>('[data-words]');
    const vocabTitle = root.querySelector<HTMLElement>('[data-vocab-title]');
    const vocabTier = root.querySelector<HTMLElement>('[data-vocab-tier]');
    let picked = new Set<string>();

    function buildGrid(tier: VocabTier): void {
      if (!wordsEl) return;
      currentTier = tier;
      picked = new Set();
      wordsEl.textContent = '';
      const isMore = probeResults.length > 0;
      if (vocabTitle) {
        vocabTitle.dataset.title = isMore ? S.copy.vocabularyMore : S.copy.vocabularyTitle;
        renderTitle(vocabTitle, vocabTitle.dataset.title);
      }
      if (vocabTier) {
        vocabTier.textContent = (S.tier[tier] ?? '').replace('{language}', langLabel());
      }
      paintProbeCta();
      probeWordsFor(language, tier).forEach((entry) => {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'bl-word-chip';
        btn.innerHTML = `<b></b>${entry.hint ? '<i></i>' : ''}<s class="bl-word-check">✓</s>`;
        (btn.querySelector('b') as HTMLElement).textContent = entry.word;
        if (entry.hint) (btn.querySelector('i') as HTMLElement).textContent = entry.hint;
        btn.addEventListener('click', () => {
          if (picked.has(entry.word)) picked.delete(entry.word);
          else picked.add(entry.word);
          btn.classList.toggle('is-picked', picked.has(entry.word));
          paintProbeCta();
        });
        wordsEl.appendChild(btn);
      });
    }

    /** The button IS the "none of these" answer while nothing is ticked — the app's own rule. */
    function paintProbeCta(): void {
      const cta = root.querySelector<HTMLButtonElement>('[data-action="words-done"]');
      if (cta) cta.textContent = picked.size > 0 ? S.copy.continue : S.copy.vocabularyNone;
    }

    /** Ticking nothing is an answer, so the grid is submitted the same way whatever is selected. */
    function submitGrid(): void {
      const total = probeWordsFor(language, currentTier).length;
      probeResults.push({ tier: currentTier, picked: picked.size, total });
      knownWords = knownWords.concat(Array.from(picked)).slice(0, 64);
      track('funnel_answer', {
        funnel: funnel.id,
        step: 'bliss_vocabulary',
        value: currentTier,
        picked: picked.size,
        total,
      });
      const next = probeResults.length < MAX_PROBE_GRIDS ? nextProbeTier(probeResults) : null;
      if (next) {
        buildGrid(next);
        revealTitles(screens.get('vocabulary') as HTMLElement);
        window.scrollTo({ top: 0, behavior: 'instant' as ScrollBehavior });
        return;
      }
      advance();
    }

    // ── Goal + optional deadline ────────────────────────────────────────────
    const goalsEl = root.querySelector<HTMLElement>('[data-goals]');
    const deadlineEl = root.querySelector<HTMLElement>('[data-deadline]');
    const eventsEl = root.querySelector<HTMLElement>('[data-events]');
    const dateField = root.querySelector<HTMLElement>('[data-date-field]');
    const dateInput = root.querySelector<HTMLInputElement>('[data-date]');

    function buildGoals(): void {
      if (!goalsEl) return;
      goalsEl.textContent = '';
      goalOptionsFor().forEach((option) => {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'bl-goal';
        btn.innerHTML = `<span class="bl-goal-glyph">${option.glyph}</span><span></span>`;
        (btn.querySelectorAll('span')[1] as HTMLElement).textContent = S.goalLabel(option.value, option.label);
        btn.addEventListener('click', () => {
          goal = option.value;
          persist();
          goalsEl.querySelectorAll('.bl-goal').forEach((c) => c.classList.toggle('is-picked', c === btn));
          track('funnel_answer', { funnel: funnel.id, step: 'main_goal', value: option.value });
          // The deadline is an optional block under the goal, not a screen of its own.
          if (deadlineEl) deadlineEl.hidden = false;
          deadlineEl?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        });
        goalsEl.appendChild(btn);
      });
    }

    if (eventsEl) {
      DEADLINE_EVENTS.forEach((event) => {
        const chip = document.createElement('button');
        chip.type = 'button';
        chip.className = 'bl-chip';
        chip.innerHTML = `<span>${event.glyph}</span><span></span>`;
        (chip.querySelectorAll('span')[1] as HTMLElement).textContent = S.deadlineLabel(event.id, event.label);
        chip.addEventListener('click', () => {
          const on = deadlineEvent === event.id;
          deadlineEvent = on ? '' : event.id;
          eventsEl.querySelectorAll('.bl-chip').forEach((c) => c.classList.toggle('is-picked', !on && c === chip));
          if (dateField) dateField.hidden = !deadlineEvent;
          if (!deadlineEvent) deadlineDate = '';
        });
        eventsEl.appendChild(chip);
      });
    }
    dateInput?.addEventListener('change', () => {
      deadlineDate = dateInput.value;
    });

    /** Mandarin swaps « Living abroad » for « Family or heritage », exactly as the app does. */
    function goalOptionsFor() {
      return goalOptions(language || null);
    }

    // ── Name ────────────────────────────────────────────────────────────────
    const nameTitle = root.querySelector<HTMLElement>('[data-name-title]');
    const nameInput = root.querySelector<HTMLInputElement>('[data-name-input]');

    function buildName(): void {
      if (!nameTitle) return;
      nameTitle.dataset.title = S.copy.nameTitle.replace('{name}', tutor().name);
      renderTitle(nameTitle, nameTitle.dataset.title);
    }

    // ── Where did you hear about us ─────────────────────────────────────────
    const heardTitle = root.querySelector<HTMLElement>('[data-heard-title]');
    const heardSub = root.querySelector<HTMLElement>('[data-heard-sub]');
    const sourcesEl = root.querySelector<HTMLElement>('[data-sources]');
    const skipBtn = root.querySelector<HTMLButtonElement>('[data-action="skip-heard"]');
    if (heardTitle) heardTitle.textContent = S.heard.title;
    if (heardSub) heardSub.textContent = S.heard.subtitle;
    if (skipBtn) skipBtn.textContent = S.heard.skip;
    if (sourcesEl) {
      HEARD_ABOUT_US.sources.forEach((source) => {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'bl-source';
        btn.style.setProperty('--brand', source.color);
        btn.textContent = S.sourceLabel(source.id, source.label);
        btn.addEventListener('click', () => {
          heardAboutUs = source.id;
          btn.classList.add('is-picked');
          if (heardSub) heardSub.textContent = S.heard.thanks;
          track('funnel_answer', { funnel: funnel.id, step: 'heard_about_us', value: source.id });
          window.setTimeout(advance, 650);
        });
        sourcesEl.appendChild(btn);
      });
    }

    // ── Plan ready ──────────────────────────────────────────────────────────
    const readyTitle = root.querySelector<HTMLElement>('[data-ready-title]');
    const readySub = root.querySelector<HTMLElement>('[data-ready-sub]');
    const statsEl = root.querySelector<HTMLElement>('[data-stats]');
    const rowsEl = root.querySelector<HTMLElement>('[data-rows]');

    function daysUntilDeadline(): number | null {
      if (!deadlineDate) return null;
      const target = new Date(`${deadlineDate}T00:00:00`);
      if (Number.isNaN(target.getTime())) return null;
      const days = Math.ceil((target.getTime() - Date.now()) / 86400000);
      return days > 0 ? days : null;
    }

    function estimate() {
      return estimateVocabulary(probeResults);
    }

    /** The level the tutor teaches at. Nothing was claimed, so it is the grids' verdict alone. */
    function resolvedLevel(): string {
      return estimate()?.measuredCefr ?? 'A1';
    }

    function buildReady(): void {
      const t = tutor();
      if (readyTitle) {
        const raw = firstName
          ? S.copy.readyTitle.replace('{first}', firstName)
          : S.copy.readyTitleAnon;
        readyTitle.dataset.title = raw;
        renderTitle(readyTitle, raw);
      }
      if (readySub) readySub.textContent = S.copy.readySubtitle.replace('{name}', t.name);

      const est = estimate();
      const days = daysUntilDeadline();
      if (statsEl) {
        statsEl.textContent = '';
        const stat = (value: string, label: string) => {
          const box = document.createElement('div');
          box.className = 'bl-stat';
          box.innerHTML = '<b></b><span></span>';
          (box.querySelector('b') as HTMLElement).textContent = value;
          (box.querySelector('span') as HTMLElement).textContent = label;
          statsEl.appendChild(box);
        };
        stat(resolvedLevel(), S.result.level);
        // Rounded to the nearest ten by the estimator — a unit digit would claim a precision the
        // 16-word grids do not have.
        if (est) stat(`~${est.knownWords}`, S.result.words);
        if (days) stat(String(days), S.result.daysLeft);
      }

      if (rowsEl) {
        rowsEl.textContent = '';
        [
          S.result.rowDefault,
          S.result.rowTutor.replace('{name}', t.name),
          days ? S.result.rowDeadline : S.result.rowRhythm,
        ].forEach((text) => {
          const li = document.createElement('li');
          li.textContent = text;
          rowsEl.appendChild(li);
        });
      }
    }

    // ── Paywall ─────────────────────────────────────────────────────────────
    function selectPlan(packageId: string): void {
      chosenPackage = packageId;
      persist();
      root.querySelectorAll<HTMLButtonElement>('.bl-plan').forEach((p) => {
        p.classList.toggle('is-selected', p.dataset.package === packageId);
      });
      const plan = funnel.plans.find((p) => p.packageId === packageId);
      root.querySelectorAll<HTMLElement>('[data-renewal]').forEach((el) => {
        el.textContent = plan
          ? plan.trialDays
            ? S.trialRenewal(plan.trialDays, localPrice(plan.price))
            : S.renewal(localPrice(plan.price))
          : '';
      });
      root.querySelectorAll<HTMLButtonElement>('[data-action="checkout"]').forEach((cta) => {
        cta.disabled = !checkoutReady || isAndroid;
        cta.textContent = plan?.trialDays ? S.trialCta(plan.trialDays) : (S.static?.continue ?? 'Continue');
      });
      if (isAndroid) {
        root.querySelectorAll<HTMLElement>('[data-android-block]').forEach((el) => {
          el.textContent = S.android(appName);
          el.hidden = false;
        });
        if (!androidBlockTracked) {
          androidBlockTracked = true;
          track('funnel_android_blocked', { funnel: funnel.id });
        }
      }
    }

    root.querySelectorAll<HTMLButtonElement>('.bl-plan').forEach((btn) => {
      btn.addEventListener('click', () => {
        selectPlan(btn.dataset.package as string);
        track('funnel_plan_selected', { funnel: funnel.id, package: btn.dataset.package });
      });
    });
    selectPlan(chosenPackage);

    const secondTitle = root.querySelector<HTMLElement>('[data-second-cta-title]');

    /**
     * The paywall's header is the plan they just built, not a price list with a headline.
     *
     * `buildPlanPills` in the app: the deadline first (it is the one that makes today matter), then
     * the measured level, then the goal — and only what the funnel actually produced. A pill with a
     * guess in it would undo the work the probe just did.
     */
    function buildPaywallHead(): void {
      const t = tutor();
      const row = root.querySelector<HTMLElement>('[data-pw-row]');
      const title = root.querySelector<HTMLElement>('[data-pw-title]');
      const sub = root.querySelector<HTMLElement>('[data-pw-sub]');
      const pills = root.querySelector<HTMLElement>('[data-pw-pills]');
      const unlock = root.querySelector<HTMLElement>('[data-unlock-title]');

      if (row) {
        // Her card in the middle, two of her colleagues on each side — the app's `paywallAvatarRow`.
        row.textContent = '';
        const others = TUTORS.filter((x) => x.persona !== t.persona).slice(0, 4);
        const order = [others[0], others[1], t, others[2], others[3]].filter(Boolean) as Tutor[];
        order.forEach((who) => {
          const card = document.createElement('span');
          card.className = 'bl-pw-face';
          card.classList.toggle('is-featured', who.persona === t.persona);
          card.style.setProperty('--tutor', who.gradient[1]);
          card.innerHTML = `<img src="/home/${who.photo}" alt="" width="64" height="80" loading="lazy" />`;
          row.appendChild(card);
        });
      }

      if (title) {
        title.textContent = '';
        const line = document.createElement('span');
        line.textContent = S.pwTitle(firstName);
        const withName = document.createElement('em');
        withName.textContent = S.pwWith(t.name);
        title.append(line, document.createElement('br'), withName);
      }
      if (sub) sub.textContent = S.pwSub(t.name);
      if (unlock) unlock.textContent = S.unlockTitle(funnel.id === 'bliss' ? 'Bliss+' : `${t.name} Pro`);

      if (pills) {
        pills.textContent = '';
        const days = daysUntilDeadline();
        const event = DEADLINE_EVENTS.find((e) => e.id === deadlineEvent);
        const add = (glyph: string, text: string) => {
          const pill = document.createElement('span');
          pill.className = 'bl-pw-pill';
          pill.innerHTML = '<i></i><b></b>';
          (pill.querySelector('i') as HTMLElement).textContent = glyph;
          (pill.querySelector('b') as HTMLElement).textContent = text;
          pills.appendChild(pill);
        };
        if (days && event) add(event.glyph, S.daysToGo(days, S.deadlineShort(event.id, event.label)));
        if (estimate()) add('📊', S.levelPill(resolvedLevel()));
        if (goal) add('🎯', S.goalLabel(goal, goal));
      }
    }

    function showPaywall(): void {
      if (secondTitle) secondTitle.textContent = S.secondCta(tutor().name);
      buildPaywallHead();
      show('plan');
      startCountdown();
      const est = estimate();
      track('funnel_plan_view', {
        funnel: funnel.id,
        language,
        persona,
        goal,
        level: resolvedLevel(),
        words_known: est?.knownWords ?? 0,
        has_deadline: Boolean(daysUntilDeadline()),
        named: Boolean(firstName),
        heard_about_us: heardAboutUs || 'none',
      });
    }

    // Countdown. Manufactured urgency, founder decision 2026-09-16 — one config value to remove it.
    // It never reaches zero-and-locks: expiring the offer a visitor is reading would cost the sale
    // the timer exists to win, so it floors at 0:00 and the price stays.
    let countdownStarted = false;
    function startCountdown(): void {
      if (countdownStarted) return;
      countdownStarted = true;
      const minutes = Number(root.dataset.countdown || '0');
      if (minutes <= 0) return;
      const clock = root.querySelector<HTMLElement>('[data-countdown-clock]');
      let left = minutes * 60;
      const tick = () => {
        if (!clock) return;
        const m = Math.floor(left / 60);
        const sec = left % 60;
        clock.textContent = `${m}:${String(sec).padStart(2, '0')}`;
        if (left > 0) left -= 1;
      };
      tick();
      window.setInterval(tick, 1000);
    }

    // ── Checkout ────────────────────────────────────────────────────────────
    const errorEl = root.querySelector<HTMLElement>('[data-checkout-error]');
    function showError(message: string): void {
      if (!errorEl) return;
      errorEl.textContent = message;
      errorEl.hidden = false;
    }

    /**
     * What the app would have written itself.
     *
     * `guidedPrefilledAnswers()` in APPSOFIA turns the guided answers into the tutor onboarding's
     * own keys: the level under `'2'` / `spanish_level`, the goal under `'8'`, the first name under
     * `'3'`, and the Bliss-specific extras under `bliss_*`. Writing exactly those keys here is what
     * makes the web funnel the onboarding rather than a copy of it — the buyer opens the app and it
     * already knows them. Anything unparsable there is dropped, so a half-written value is safe.
     */
    function appAnswers(): Record<string, string> {
      const est = estimate();
      const cefr = resolvedLevel();
      const answers: Record<string, string> = {
        '2': CEFR_TO_LEVEL_VALUE[cefr as keyof typeof CEFR_TO_LEVEL_VALUE] ?? 'Elementary',
        spanish_level: CEFR_TO_LEVEL_VALUE[cefr as keyof typeof CEFR_TO_LEVEL_VALUE] ?? 'Elementary',
        '8': goal,
        bliss_cefr_level: cefr,
      };
      if (est) {
        answers.bliss_cefr_measured = est.measuredCefr;
        answers.bliss_vocab_size = String(est.knownWords);
      }
      if (knownWords.length > 0) answers.bliss_known_words = JSON.stringify(knownWords);
      if (deadlineEvent && deadlineDate) {
        answers.bliss_deadline = JSON.stringify({ event: deadlineEvent, date: deadlineDate });
      }
      if (firstName) answers['3'] = firstName;
      return answers;
    }

    async function beginCheckout(cta: HTMLButtonElement): Promise<void> {
      if (isAndroid) return;
      const original = cta.textContent;
      cta.disabled = true;
      cta.textContent = S.oneMoment;
      if (errorEl) errorEl.hidden = true;
      const plan = funnel.plans.find((p) => p.packageId === chosenPackage);
      track(
        'funnel_checkout_started',
        { funnel: funnel.id, package: chosenPackage },
        plan ? { value: plan.amount, currency, contentId: chosenPackage } : undefined,
      );

      try {
        const { createClient } = await import('@supabase/supabase-js');
        const client = createClient(SUPABASE_URL, SUPABASE_ANON_KEY);

        // Reuse a session if the buyer already has one (back button, second attempt) so we never
        // create a second customer for the same person.
        let userId = (await client.auth.getUser()).data.user?.id;
        if (!userId) {
          const { data, error } = await client.auth.signInAnonymously();
          if (error || !data.user) throw error ?? new Error('no user');
          userId = data.user.id;
        }

        // Hand the onboarding to the app before leaving for checkout. Best-effort on purpose: a
        // failed write must never block a payment — the buyer simply gets the in-app onboarding.
        //
        // supabase-js does NOT throw on a rejected write — it returns `{ error }`. Until 2026-09-18
        // the result was ignored, and the table sat EMPTY for every buyer: the payload named four
        // columns the table did not have, PostgREST refused the whole row, and nothing said so.
        // Report it, so the next schema drift shows up in analytics instead of in a support email.
        try {
          const { error: profileError } = await client.from('web_funnel_profiles').upsert(
            {
              user_id: userId,
              funnel: funnel.id,
              variant: funnel.app,
              name: firstName || null,
              persona,
              taught_language: language,
              answers: appAnswers(),
              words_known: knownWords,
              derived_level: resolvedLevel(),
              heard_about_us: heardAboutUs || null,
              native_language: (navigator.language || '').split('-')[0] || null,
              attribution: { ...attribution, ...adSignals() },
              seconds_spent: Math.round((Date.now() - startedAt) / 1000),
              updated_at: new Date().toISOString(),
            },
            { onConflict: 'user_id' },
          );
          if (profileError) {
            track('funnel_profile_write_failed', {
              funnel: funnel.id,
              code: profileError.code ?? 'unknown',
              message: (profileError.message ?? '').slice(0, 100),
            });
          }
        } catch {
          /* the purchase matters more than the hand-off */
          track('funnel_profile_write_failed', { funnel: funnel.id, code: 'exception' });
        }

        // The checkout's redirect back is configured once in the RevenueCat dashboard and cannot
        // carry our state, so the success page gets it from here (same origin).
        const context: CheckoutContext = {
          funnel: funnel.id,
          packageId: chosenPackage,
          userId,
          name: firstName || undefined,
          persona: persona || undefined,
          currency,
          at: Date.now(),
        };
        try {
          localStorage.setItem(CHECKOUT_CONTEXT_KEY, JSON.stringify(context));
        } catch {
          /* private mode: the success page falls back to what the redirect carries */
        }

        track('funnel_checkout_redirect', { funnel: funnel.id, package: chosenPackage });
        window.location.href = checkoutUrl({
          packageId: chosenPackage,
          supabaseUserId: userId,
          funnel: funnel.id,
          currency: currency !== funnel.currency ? currency : undefined,
        });
      } catch {
        // Most likely cause: "Allow anonymous sign-ins" is off in Supabase → Authentication. Fail
        // here rather than sending an untrackable buyer to a payment page.
        showError(S.checkoutError);
        track('funnel_checkout_failed', { funnel: funnel.id, package: chosenPackage });
        cta.disabled = false;
        cta.textContent = original;
      }
    }

    root.querySelectorAll<HTMLButtonElement>('[data-action="checkout"]').forEach((cta) => {
      cta.addEventListener('click', () => void beginCheckout(cta));
    });

    // ── Wiring ──────────────────────────────────────────────────────────────
    root.querySelector<HTMLButtonElement>('[data-action="start"]')?.addEventListener('click', () => {
      track('funnel_started', { funnel: funnel.id, ...attribution });
      stopDemo();
      advance();
    });
    root.querySelector<HTMLButtonElement>('[data-action="next-from-tutor"]')?.addEventListener('click', () => {
      buildGrid('basic');
      advance();
    });
    root.querySelector<HTMLButtonElement>('[data-action="words-done"]')?.addEventListener('click', submitGrid);
    root.querySelector<HTMLButtonElement>('[data-action="goal-done"]')?.addEventListener('click', () => {
      if (!goal) return;
      buildName();
      advance();
    });
    root.querySelector<HTMLButtonElement>('[data-action="name-done"]')?.addEventListener('click', () => {
      firstName = (nameInput?.value ?? '').trim().slice(0, 50);
      persist();
      track('funnel_answer', { funnel: funnel.id, step: 'name', value: firstName ? 'provided' : 'skipped' });
      advance();
    });
    nameInput?.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') root.querySelector<HTMLButtonElement>('[data-action="name-done"]')?.click();
    });
    skipBtn?.addEventListener('click', () => {
      track('funnel_answer', { funnel: funnel.id, step: 'heard_about_us', value: 'skipped' });
      advance();
    });
    root.querySelector<HTMLButtonElement>('[data-action="see-plan"]')?.addEventListener('click', showPaywall);

    backBtn?.addEventListener('click', () => history.back());
    window.addEventListener('popstate', () => {
      const id = window.location.hash.replace('#', '') || 'intro';
      if (screens.has(id)) show(id as Step, { push: false });
    });

    // A locked funnel already knows its teacher; an unlocked one paints Bliss's own violet until one
    // is chosen. It also names the language it sells: "Speak a language for real" is Bliss's promise,
    // not Sofia's — hers is Spanish, and the visitor came from an ad that said so.
    if (persona) paintTutor();
    if (funnel.lockedLanguage) {
      const introTitle = screens.get('intro')?.querySelector<HTMLElement>('.bl-title');
      if (introTitle) {
        introTitle.dataset.title = S.copy.introTitleLocked.replace('{language}', languageName());
      }
    }
    // The visitor came from an Emily (or Sofia) ad, and lands on that app: its icon and name, not
    // the hub's. The hub brand stays on the default (Bliss) funnel.
    if (funnel.lockedPersona) {
      root.classList.add('is-single-tutor');
      const mark = root.querySelector<HTMLImageElement>('[data-brand-mark]');
      const name = root.querySelector<HTMLElement>('[data-brand-name]');
      if (mark) {
        mark.src = `/icons/${funnel.app}.jpg`;
      }
      if (name) name.textContent = funnel.app.charAt(0).toUpperCase() + funnel.app.slice(1);
    }
    buildStrip();
    buildGoals();
    buildName();
    if (language) buildTutors();
    if (funnel.lockedLanguage) buildGrid('basic');

    // The 'ready' screen is built from answers, so it is rebuilt every time it is shown.
    const readyScreen = screens.get('ready');
    if (readyScreen) {
      new MutationObserver(() => {
        if (readyScreen.classList.contains('is-active')) buildReady();
      }).observe(readyScreen, { attributes: true, attributeFilter: ['class'] });
    }

    // A deep link (refresh, a shared URL, the back button after a hot reload) must not land on a
    // screen this visitor has no answers for: without a language there are no tutors, no grid and no
    // plan, and the screen would simply be empty. Anything unreachable falls back to the intro.
    const initial = window.location.hash.replace('#', '') as Step;
    const reachable = (step: Step): boolean => {
      if (!screens.has(step)) return false;
      if (step === 'intro' || step === 'language') return true;
      if (!language || !persona) return false;
      if (step === 'ready' || step === 'plan') return Boolean(goal);
      return true;
    };
    show(reachable(initial) ? initial : 'intro', { push: false });
    playScene(0);
  }

  initFunnel();
  document.addEventListener('astro:page-load', initFunnel);
</script>
