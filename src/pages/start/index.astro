---
// /start/ — the paid-traffic funnel. Structure read screen by screen off start.praktika.ai
// (recording, 2026-09-16): a question is never followed by another question, always by a pitch
// screen. See src/config/funnel.ts for why, and for what is deliberately not copied.
//
// `bare` (no header, no footer) and `noindex`: there is no way out but forward or back, and the page
// must not rank as a thin duplicate of /sofia/ and split its organic signal.
//
// Every screen is in the HTML at build time and switched client-side — a static site can run the
// whole funnel in one document, and each avoided navigation is conversion that does not leak. The
// hash still changes per screen so the back button works and GA4 sees the progression.
import Base from '../../layouts/Base.astro';
import { FUNNELS, DEFAULT_FUNNEL, isCheckoutConfigured } from '../../config/funnel';
import { APPS } from '../../config/apps';
import '../../styles/funnel.css';

const funnel = FUNNELS[DEFAULT_FUNNEL];
const app = APPS[funnel.app];
const checkoutReady = isCheckoutConfigured();

const brandStyle = `--brand-1:${app.gradient[0]};--brand-2:${app.gradient[1]};--brand-3:${app.gradient[2]};--accent:${app.accent};--on-gradient:${app.onGradient}`;

// Pitch screens are not steps the visitor has to "get through", so the progress bar counts only the
// screens that ask something. A bar that crawls through adverts reads as a longer funnel than it is.
const askedCount = funnel.screens.filter((s) => s.kind !== 'pitch').length;
---

<Base
  title={`${funnel.headline} — Sofia`}
  description={funnel.sub}
  bare
  noindex
  brandStyle={brandStyle}
  bodyClass="funnel-body"
>
  <div
    class="fnl"
    data-funnel={funnel.id}
    data-app={funnel.app}
    data-asked={String(askedCount)}
    data-countdown={String(funnel.countdownMinutes)}
    data-checkout-ready={checkoutReady ? '1' : '0'}
  >
    <header class="fnl-bar">
      <button class="fnl-back" type="button" aria-label="Go back" hidden>&larr;</button>
      <div class="fnl-progress" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
        <span class="fnl-progress-fill"></span>
      </div>
    </header>

    <!-- Intro ------------------------------------------------------------ -->
    <section class="fnl-screen is-active" data-screen="intro">
      <div class="fnl-inner fnl-center">
        <h1>{funnel.headline}</h1>
        <p class="fnl-sub">{funnel.sub}</p>
        <button class="fnl-cta" type="button" data-action="start">Build my plan</button>
        <p class="fnl-fineprint">Takes about a minute.</p>
      </div>
    </section>

    <!-- Questions and pitches, alternating ------------------------------- -->
    {funnel.screens.map((screen) => (
      <section class="fnl-screen" data-screen={screen.id} data-kind={screen.kind}>
        <div class:list={['fnl-inner', screen.kind === 'pitch' && 'fnl-center']}>
          {screen.kind === 'pitch' && (
            <>
              <h2>{screen.title}</h2>
              {screen.punch && (
                <div class="fnl-punch">
                  <div class="fnl-punch-side">
                    <span class="fnl-punch-glyph">{screen.punch.before}</span>
                    <span class="fnl-punch-label">{screen.punch.beforeLabel}</span>
                  </div>
                  <div class="fnl-punch-side">
                    <span class="fnl-punch-glyph">{screen.punch.after}</span>
                    <span class="fnl-punch-label">{screen.punch.afterLabel}</span>
                  </div>
                  <p class="fnl-punch-line">{screen.punch.line}</p>
                </div>
              )}
              {screen.proof && (
                <ul class="fnl-proof">
                  {screen.proof.map((p) => (
                    <li>
                      <strong>{p.value}</strong>
                      <span>{p.label}</span>
                    </li>
                  ))}
                </ul>
              )}
              {screen.body && <p class="fnl-sub fnl-pitch-body">{screen.body}</p>}
              <button class="fnl-cta" type="button" data-action="next">Continue</button>
            </>
          )}

          {screen.kind === 'question' && (
            <>
              <h2 set:html={screen.question} />
              {screen.sub && <p class="fnl-sub">{screen.sub}</p>}
              <div class="fnl-options">
                {screen.options.map((opt) => (
                  <button class="fnl-option" type="button" data-step={screen.id} data-value={opt.id}>
                    {opt.glyph && <span class="fnl-glyph" aria-hidden="true">{opt.glyph}</span>}
                    <span class="fnl-option-text">
                      <span class="fnl-option-label">{opt.label}</span>
                      {opt.hint && <span class="fnl-option-hint">{opt.hint}</span>}
                    </span>
                  </button>
                ))}
              </div>
            </>
          )}

          {screen.kind === 'words' && (
            <>
              <h2>{screen.question}</h2>
              <p class="fnl-sub">{screen.sub}</p>
              <div class="fnl-words" data-step={screen.id}>
                {screen.words.map((w) => (
                  <button class="fnl-word" type="button" data-word={w}>{w}</button>
                ))}
              </div>
              <button class="fnl-cta fnl-sticky-cta" type="button" data-action="next">Continue</button>
            </>
          )}

          {screen.kind === 'input' && (
            <>
              <h2>{screen.question}</h2>
              {screen.sub && <p class="fnl-sub">{screen.sub}</p>}
              <form class="fnl-form" data-name-form novalidate>
                <input
                  class="fnl-text"
                  type="text"
                  name="name"
                  placeholder={screen.placeholder}
                  autocomplete="given-name"
                  maxlength="40"
                />
                <button class="fnl-cta" type="submit" disabled>Continue</button>
              </form>
            </>
          )}
        </div>
      </section>
    ))}

    <!-- Building --------------------------------------------------------- -->
    <!--
      The pause is short and the work behind it is real — the plan below is assembled from the
      answers. The delay exists so the reveal reads as a result rather than the next page of a form.
      Praktika parks a testimonial here; we park a product fact, because our review count is 1-4.
    -->
    <section class="fnl-screen" data-screen="building">
      <div class="fnl-inner fnl-center">
        <div class="fnl-ring" aria-hidden="true"><span data-ring-pct>0%</span></div>
        <h2>Building your plan…</h2>
        <ul class="fnl-build-list">
          {funnel.buildSteps.map((line) => (
            <li data-build-line>{line}</li>
          ))}
        </ul>
        <p class="fnl-quote">
          Sofia explains in the language you already speak, and hands you the Spanish to say. That is
          why complete beginners can start talking on day one.
        </p>
      </div>
    </section>

    <!-- Plan reveal ------------------------------------------------------- -->
    <section class="fnl-screen" data-screen="plan">
      <div class="fnl-inner">
        <h2 data-plan-title>Your plan is ready!</h2>
        <p class="fnl-sub" data-plan-recap></p>

        <div class="fnl-curve">
          <span class="fnl-curve-label">Your speaking confidence</span>
          <svg viewBox="0 0 300 120" role="img" aria-label="Your level rising from today to week four">
            <defs>
              <linearGradient id="fnlCurve" x1="0" y1="0" x2="1" y2="0">
                <stop offset="0%" stop-color="var(--brand-1)" />
                <stop offset="100%" stop-color="var(--brand-2)" />
              </linearGradient>
            </defs>
            <path d="M12 104 C 90 100, 150 76, 288 16" fill="none" stroke="url(#fnlCurve)" stroke-width="5" stroke-linecap="round" />
            <circle cx="12" cy="104" r="7" fill="var(--brand-1)" />
            <circle cx="288" cy="16" r="7" fill="var(--brand-2)" />
          </svg>
          <div class="fnl-curve-axis"><span>Today</span><span>Week 4</span></div>
        </div>

        <button class="fnl-cta" type="button" data-action="next">See my plan</button>
      </div>
    </section>

    <!-- Paywall ----------------------------------------------------------- -->
    <section class="fnl-screen" data-screen="paywall">
      {funnel.countdownMinutes > 0 && (
        <div class="fnl-countdown" data-countdown-bar>
          <span>Your discount is reserved for</span>
          <strong data-countdown-clock>10:00</strong>
        </div>
      )}

      <div class="fnl-inner fnl-paywall">
        <h2 data-paywall-title>Get unlimited access to Sofia</h2>
        <p class="fnl-sub">The quickest route to actually speaking Spanish.</p>

        <div class="fnl-plans" data-plans>
          {funnel.plans.map((plan) => (
            <button
              class:list={['fnl-plan', plan.highlight && 'is-highlight']}
              type="button"
              data-package={plan.packageId}
            >
              {plan.badge && <span class="fnl-plan-badge">{plan.badge}</span>}
              <span class="fnl-plan-radio" aria-hidden="true"></span>
              <span class="fnl-plan-main">
                <span class="fnl-plan-name">{plan.name}</span>
                <span class="fnl-plan-save">SAVE {plan.savePercent}%</span>
                <span class="fnl-plan-totals">
                  <s>{plan.listPrice}</s> {plan.price}
                </span>
              </span>
              <span class="fnl-plan-day">
                <s>{plan.perDayList}</s>
                <strong>{plan.perDay}</strong>
                <em>per day</em>
              </span>
            </button>
          ))}
        </div>

        <button class="fnl-cta" type="button" data-action="checkout" disabled>Continue</button>

        <ul class="fnl-pay" aria-label="Accepted payment methods">
          <li>VISA</li><li>Mastercard</li><li>Apple&nbsp;Pay</li><li>Google&nbsp;Pay</li><li>Amex</li>
        </ul>
        <p class="fnl-secure">Secure payment</p>

        {!checkoutReady && (
          <p class="fnl-warn">
            Checkout is not configured. Set <code>PUBLIC_RC_WEB_BILLING_URL</code> in the deploy
            workflow, and turn on <strong>Allow anonymous sign-ins</strong> in Supabase → Authentication,
            before sending traffic here.
          </p>
        )}

        <p class="fnl-legal" data-renewal></p>
        <p class="fnl-legal"><a href="/privacy/">Privacy</a> · <a href="/terms/">Terms</a></p>

        <!-- Long-form selling below the fold, then the price block again — Praktika repeats it once
             with a second headline rather than making the visitor scroll back up. -->
        <section class="fnl-block">
          <h3>What you get</h3>
          <ul class="fnl-included">
            {funnel.included.map((item) => (
              <li>
                <strong>{item.title}</strong>
                <span>{item.body}</span>
              </li>
            ))}
          </ul>
        </section>

        <section class="fnl-block">
          <h3>Frequently asked questions</h3>
          <dl class="fnl-faq">
            {funnel.faq.map((item) => (
              <>
                <dt>{item.q}</dt>
                <dd>{item.a}</dd>
              </>
            ))}
          </dl>
        </section>

        <section class="fnl-block">
          <h3>Start speaking with Sofia</h3>
          <div class="fnl-plans" data-plans>
            {funnel.plans.map((plan) => (
              <button
                class:list={['fnl-plan', plan.highlight && 'is-highlight']}
                type="button"
                data-package={plan.packageId}
              >
                {plan.badge && <span class="fnl-plan-badge">{plan.badge}</span>}
                <span class="fnl-plan-radio" aria-hidden="true"></span>
                <span class="fnl-plan-main">
                  <span class="fnl-plan-name">{plan.name}</span>
                  <span class="fnl-plan-save">SAVE {plan.savePercent}%</span>
                  <span class="fnl-plan-totals">
                    <s>{plan.listPrice}</s> {plan.price}
                  </span>
                </span>
                <span class="fnl-plan-day">
                  <s>{plan.perDayList}</s>
                  <strong>{plan.perDay}</strong>
                  <em>per day</em>
                </span>
              </button>
            ))}
          </div>
          <button class="fnl-cta" type="button" data-action="checkout" disabled>Continue</button>
          <p class="fnl-error" data-checkout-error hidden></p>
        </section>
      </div>
    </section>
  </div>
</Base>

<script>
  import {
    FUNNELS,
    DEFAULT_FUNNEL,
    SUPABASE_URL,
    SUPABASE_ANON_KEY,
    checkoutUrl,
  } from '../../config/funnel';

  const STORAGE_KEY = 'bliss_funnel_v2';

  /**
   * Ad attribution, captured from the landing URL and carried to checkout.
   *
   * This is the reason the web funnel exists: on the App Store path these installs land in
   * AppsFlyer's `restricted` bucket with no campaign attached, because the user never resolved ATT.
   * On the web the click ids are simply in the URL and stay ours.
   */
  const ATTRIBUTION_KEYS = [
    'utm_source', 'utm_medium', 'utm_campaign', 'utm_content', 'utm_term',
    'fbclid', 'ttclid', 'gclid',
  ];

  function track(event: string, params: Record<string, unknown> = {}): void {
    const gtag = (window as unknown as { gtag?: (...a: unknown[]) => void }).gtag;
    if (typeof gtag === 'function') gtag('event', event, params);
  }

  function initFunnel(): void {
    const root = document.querySelector<HTMLElement>('.fnl');
    if (!root || root.dataset.initialised === '1') return;
    root.dataset.initialised = '1';

    const funnel = FUNNELS[root.dataset.funnel ?? DEFAULT_FUNNEL];
    const order = ['intro', ...funnel.screens.map((s) => s.id), 'building', 'plan', 'paywall'];
    const askedTotal = Number(root.dataset.asked || '1');
    const checkoutReady = root.dataset.checkoutReady === '1';

    const screens = new Map<string, HTMLElement>();
    root.querySelectorAll<HTMLElement>('[data-screen]').forEach((el) => {
      screens.set(el.dataset.screen as string, el);
    });

    const backBtn = root.querySelector<HTMLButtonElement>('.fnl-back');
    const fill = root.querySelector<HTMLElement>('.fnl-progress-fill');
    const bar = root.querySelector<HTMLElement>('.fnl-progress');

    let answers: Record<string, string> = {};
    let words: string[] = [];
    let name = '';
    let chosenPackage = funnel.plans.find((p) => p.highlight)?.packageId ?? funnel.plans[0].packageId;
    let current = 'intro';

    const stored = sessionStorage.getItem(STORAGE_KEY);
    let attribution: Record<string, string> = stored ? (JSON.parse(stored).attribution ?? {}) : {};
    const url = new URL(window.location.href);
    for (const key of ATTRIBUTION_KEYS) {
      const value = url.searchParams.get(key);
      if (value) attribution[key] = value;
    }

    function persist(): void {
      try {
        sessionStorage.setItem(
          STORAGE_KEY,
          JSON.stringify({ answers, words, name, attribution, chosenPackage }),
        );
      } catch {
        /* private mode — the funnel still works, it just forgets on reload */
      }
    }

    function show(id: string, opts: { push?: boolean } = {}): void {
      const next = screens.get(id);
      if (!next) return;
      screens.forEach((el) => el.classList.remove('is-active'));
      next.classList.add('is-active');
      current = id;

      // Pitch screens are not counted: a bar that crawls through adverts reads as a longer funnel.
      const asked = funnel.screens
        .slice(0, Math.max(0, order.indexOf(id)))
        .filter((s) => s.kind !== 'pitch').length;
      const pct = id === 'intro' ? 0 : Math.min(100, Math.round((asked / askedTotal) * 100));
      if (fill) fill.style.width = `${pct}%`;
      if (bar) bar.setAttribute('aria-valuenow', String(pct));
      if (backBtn) backBtn.hidden = id === 'intro';

      window.scrollTo({ top: 0, behavior: 'instant' as ScrollBehavior });
      if (opts.push !== false) history.pushState({ screen: id }, '', `#${id}`);
      track('funnel_step_view', { funnel: funnel.id, step: id });
    }

    function advance(): void {
      const next = order[order.indexOf(current) + 1];
      if (next === 'building') runBuilding();
      else if (next) show(next);
    }

    // ── Questions ───────────────────────────────────────────────────────────
    root.querySelectorAll<HTMLButtonElement>('.fnl-option').forEach((btn) => {
      btn.addEventListener('click', () => {
        const step = btn.dataset.step as string;
        answers[step] = btn.dataset.value as string;
        persist();
        track('funnel_answer', { funnel: funnel.id, step, value: btn.dataset.value });
        // The selected state is visible for a beat: an instant jump reads as a glitch and people tap twice.
        btn.classList.add('is-picked');
        window.setTimeout(() => {
          btn.classList.remove('is-picked');
          advance();
        }, 180);
      });
    });

    root.querySelectorAll<HTMLButtonElement>('[data-action="next"]').forEach((btn) => {
      btn.addEventListener('click', advance);
    });

    root.querySelector<HTMLButtonElement>('[data-action="start"]')?.addEventListener('click', () => {
      track('funnel_started', { funnel: funnel.id, ...attribution });
      advance();
    });

    backBtn?.addEventListener('click', () => history.back());
    window.addEventListener('popstate', () => {
      const id = window.location.hash.replace('#', '') || 'intro';
      if (screens.has(id)) show(id, { push: false });
    });

    // ── Vocabulary check ────────────────────────────────────────────────────
    root.querySelectorAll<HTMLButtonElement>('.fnl-word').forEach((btn) => {
      btn.addEventListener('click', () => {
        const word = btn.dataset.word as string;
        btn.classList.toggle('is-on');
        words = btn.classList.contains('is-on') ? [...words, word] : words.filter((w) => w !== word);
        persist();
      });
    });

    // ── Name ────────────────────────────────────────────────────────────────
    const nameForm = root.querySelector<HTMLFormElement>('[data-name-form]');
    const nameInput = nameForm?.querySelector<HTMLInputElement>('input[name="name"]');
    const nameSubmit = nameForm?.querySelector<HTMLButtonElement>('button[type="submit"]');
    nameInput?.addEventListener('input', () => {
      if (nameSubmit) nameSubmit.disabled = nameInput.value.trim().length === 0;
    });
    nameForm?.addEventListener('submit', (e) => {
      e.preventDefault();
      name = (nameInput?.value ?? '').trim();
      persist();
      track('funnel_answer', { funnel: funnel.id, step: 'name', value: 'provided' });
      advance();
    });

    // ── Building ────────────────────────────────────────────────────────────
    function runBuilding(): void {
      show('building');
      const lines = root.querySelectorAll<HTMLElement>('[data-build-line]');
      const ring = root.querySelector<HTMLElement>('[data-ring-pct]');
      const total = 500 + lines.length * 600 + 400;
      const started = Date.now();

      lines.forEach((li, i) => {
        li.classList.remove('is-done');
        window.setTimeout(() => li.classList.add('is-done'), 500 + i * 600);
      });

      const tick = window.setInterval(() => {
        const pct = Math.min(100, Math.round(((Date.now() - started) / total) * 100));
        if (ring) ring.textContent = `${pct}%`;
        if (pct >= 100) window.clearInterval(tick);
      }, 60);

      window.setTimeout(showPlan, total);
    }

    // ── Plan reveal ─────────────────────────────────────────────────────────
    function showPlan(): void {
      const title = root.querySelector<HTMLElement>('[data-plan-title]');
      if (title) title.textContent = name ? `${name}, your plan is ready!` : 'Your plan is ready!';

      const labelOf = (stepId: string): string => {
        const screen = funnel.screens.find((s) => s.id === stepId);
        if (!screen || screen.kind !== 'question') return '';
        const opt = screen.options.find((o) => o.id === answers[stepId]);
        return opt ? opt.label.toLowerCase() : '';
      };
      const parts = [
        answers.time ? `${answers.time} minutes a day` : 'a few minutes a day',
        labelOf('why') && `for ${labelOf('why')}`,
        words.length ? `${words.length} words already in` : null,
      ].filter(Boolean);

      const recap = root.querySelector<HTMLElement>('[data-plan-recap]');
      if (recap) recap.textContent = `${parts.join(' · ')}.`;

      show('plan');
      track('funnel_plan_view', { funnel: funnel.id, ...answers, words_known: words.length });
    }

    // ── Paywall ─────────────────────────────────────────────────────────────
    function selectPlan(packageId: string): void {
      chosenPackage = packageId;
      persist();
      root.querySelectorAll<HTMLButtonElement>('.fnl-plan').forEach((p) => {
        p.classList.toggle('is-selected', p.dataset.package === packageId);
      });
      const plan = funnel.plans.find((p) => p.packageId === packageId);
      root.querySelectorAll<HTMLElement>('[data-renewal]').forEach((el) => {
        el.textContent = plan
          ? `Your subscription renews at ${plan.price} until you cancel. Cancel any time from your account settings.`
          : '';
      });
      root.querySelectorAll<HTMLButtonElement>('[data-action="checkout"]').forEach((cta) => {
        cta.disabled = !checkoutReady;
      });
    }

    root.querySelectorAll<HTMLButtonElement>('.fnl-plan').forEach((btn) => {
      btn.addEventListener('click', () => {
        selectPlan(btn.dataset.package as string);
        track('funnel_plan_selected', { funnel: funnel.id, package: btn.dataset.package });
      });
    });
    selectPlan(chosenPackage);

    // Countdown. Manufactured urgency, founder decision 2026-09-16 — one config value to remove it.
    // It never reaches zero-and-locks: expiring the offer a visitor is reading would cost the sale
    // the timer exists to win, so it floors at 0:00 and the price stays.
    const minutes = Number(root.dataset.countdown || '0');
    if (minutes > 0) {
      const clock = root.querySelector<HTMLElement>('[data-countdown-clock]');
      let left = minutes * 60;
      window.setInterval(() => {
        left = Math.max(0, left - 1);
        if (clock) {
          clock.textContent = `${Math.floor(left / 60)}:${String(left % 60).padStart(2, '0')}`;
        }
      }, 1000);
    }

    // ── Checkout ────────────────────────────────────────────────────────────
    // Supabase is loaded only here: ~40 KB the quiz never needs, and weight on an ad landing is
    // conversion. `signInAnonymously` gives a real, permanent user id with no form — the purchase
    // lands on the id the buyer will keep, and /start/success/ attaches their email to it.
    const errorEl = root.querySelector<HTMLElement>('[data-checkout-error]');
    function showError(message: string): void {
      if (!errorEl) return;
      errorEl.textContent = message;
      errorEl.hidden = false;
    }

    async function beginCheckout(cta: HTMLButtonElement): Promise<void> {
      const original = cta.textContent;
      cta.disabled = true;
      cta.textContent = 'One moment…';
      if (errorEl) errorEl.hidden = true;
      track('funnel_checkout_started', { funnel: funnel.id, package: chosenPackage });

      try {
        const { createClient } = await import('@supabase/supabase-js');
        const client = createClient(SUPABASE_URL, SUPABASE_ANON_KEY);

        // Reuse a session if the buyer already has one (back button, second attempt) so we never
        // create a second customer for the same person.
        let userId = (await client.auth.getUser()).data.user?.id;
        if (!userId) {
          const { data, error } = await client.auth.signInAnonymously();
          if (error || !data.user) throw error ?? new Error('no user');
          userId = data.user.id;
        }

        const returnTo = new URL('/start/success/', window.location.origin);
        returnTo.searchParams.set('package', chosenPackage);
        if (name) returnTo.searchParams.set('name', name);

        track('funnel_checkout_redirect', { funnel: funnel.id, package: chosenPackage });
        window.location.href = checkoutUrl({
          packageId: chosenPackage,
          supabaseUserId: userId,
          funnel: funnel.id,
          returnTo: returnTo.href,
          attribution,
        });
      } catch (err) {
        // Most likely cause: "Allow anonymous sign-ins" is off in Supabase → Authentication. Fail
        // here rather than sending an untrackable buyer to a payment page.
        showError('We could not start checkout. Please try again in a moment.');
        track('funnel_checkout_failed', { funnel: funnel.id, package: chosenPackage });
        cta.disabled = false;
        cta.textContent = original;
      }
    }

    root.querySelectorAll<HTMLButtonElement>('[data-action="checkout"]').forEach((cta) => {
      cta.addEventListener('click', () => void beginCheckout(cta));
    });

    // Deep link support (refresh, or back into the middle of the funnel).
    const initial = window.location.hash.replace('#', '');
    show(screens.has(initial) ? initial : 'intro', { push: false });
  }

  initFunnel();
  document.addEventListener('astro:page-load', initFunnel);
</script>
