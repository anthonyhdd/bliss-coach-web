---
import Base from '../../layouts/Base.astro';
import { withBase } from '../../config/apps';

// Job offer: organic content internship (TikTok / Instagram). The copy below is
// the offer as published on job boards — keep both in sync when it changes.
// The page carries schema.org/JobPosting so Google for Jobs can index it.

const ROLE = {
  title: 'Organic Content Intern — TikTok & Instagram',
  datePosted: '2026-09-14',
  validThrough: '2026-12-31',
  location: 'Paris',
  mode: 'Hybrid / Remote-friendly',
  duration: '6 months',
  start: 'ASAP',
  applyEmail: 'anthony@blisscoach.app',
};

const title = `${ROLE.title} | Careers at Bliss Coach`;
const description =
  'Own organic short-form video across 5+ AI coaching apps: ideate, shoot, edit, post, read the numbers, do it again. 6-month internship in Paris, hybrid / remote-friendly, start ASAP.';

const applyHref = `mailto:${ROLE.applyEmail}?subject=${encodeURIComponent(`Application — ${ROLE.title}`)}&body=${encodeURIComponent(
  'Hi Bliss Coach,\n\nHere are 2–3 links to content I have made:\n1. \n2. \n3. \n\nA few words about me:\n\n',
)}`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'JobPosting',
  title: ROLE.title,
  description:
    '<p>Come build and scale AI coaching apps that actually change how people show up in their lives — and grow them the way apps get grown in 2026: organic-first, one video at a time.</p><p>You will own organic content on TikTok and Instagram across 5+ apps: content creation, account and channel strategy, trend and competitor watch, data and reading the signal, test/kill/scale, creators and UGC, and vibe-coding your own tools.</p><p>6-month internship, Paris, hybrid / remote-friendly, start ASAP. Apply with 2–3 links to content you have made.</p>',
  datePosted: ROLE.datePosted,
  validThrough: `${ROLE.validThrough}T23:59:59+01:00`,
  employmentType: 'INTERN',
  hiringOrganization: {
    '@type': 'Organization',
    name: 'Bliss Coach',
    sameAs: 'https://bliss-coach.com/',
    logo: 'https://bliss-coach.com/home/logo.png',
  },
  jobLocation: {
    '@type': 'Place',
    address: {
      '@type': 'PostalAddress',
      addressLocality: 'Paris',
      addressCountry: 'FR',
    },
  },
  applicantLocationRequirements: { '@type': 'Country', name: 'France' },
  industry: 'Mobile apps / Consumer software',
  skills: 'Short-form video, CapCut, TikTok, Instagram Reels, content strategy, analytics, UGC creator management',
  directApply: true,
  url: 'https://bliss-coach.com/careers/organic-content-intern/',
};
---

<Base title={title} description={description} bodyClass="article-page" jsonLd={jsonLd}>
  <article class="job">
    <header class="article-header">
      <a class="crumb" href={withBase('/careers/')}>← Careers</a>
      <p class="job-kicker">Internship · Bliss Coach</p>
      <h1>{ROLE.title}</h1>
      <ul class="job-facts" aria-label="Job details">
        <li>📍 {ROLE.location}</li>
        <li>🏠 {ROLE.mode}</li>
        <li>⏳ {ROLE.duration}</li>
        <li>🚀 Start: {ROLE.start}</li>
      </ul>
      <a class="btn btn-brand job-apply" href={applyHref}>Apply with 2–3 links to your content</a>
    </header>

    <div class="prose">
      <p class="lead">
        Come build and scale AI coaching apps that actually change how people show up in their lives — and grow them
        the way apps get grown in 2026: <strong>organic-first, one video at a time.</strong>
      </p>

      <h2>🏄 The mission</h2>
      <p>
        At Bliss Coach we build AI coaching apps and launch them internationally. Marketing isn't a support function
        here — it <em>is</em> the growth engine. And our #1 channel isn't a media buy: it's the feed.
      </p>
      <p>
        You'll own organic content on TikTok and Instagram across 5+ apps. Not "community management" — actual
        production. You ideate, you shoot, you edit, you post, you read the numbers the next morning, and you do it
        again. At volume.
      </p>

      <p><strong>Here's what you'll own:</strong></p>

      <h3>🎬 Content creation (this is the job)</h3>
      <p>
        Ideate, film and edit short-form video every single day. Hooks, formats, trends, faceless edits, talking heads,
        screen recordings, memes — whatever the app and the audience need. You'll ship dozens of videos a week and get
        very good, very fast.
      </p>

      <h3>📱 Account &amp; channel strategy</h3>
      <p>
        Run a portfolio of TikTok and Instagram accounts across apps and markets. Decide what each account is
        <em>for</em>, set posting cadence, build content pillars, and grow them from zero. Reels, Stories, carousels,
        TikTok-native — you know what each format is actually good at.
      </p>

      <h3>🔍 Trend &amp; competitor watch</h3>
      <p>
        Live in the feed. Spot formats before they peak, tear down what's working for competitors and adjacent apps,
        and turn it into something shot by end of day.
      </p>

      <h3>📊 Data &amp; reading the signal</h3>
      <p>
        Hook rate, watch time, saves, shares, follow rate — then further down: installs, D7 retention, conversion by
        app × account × market. You'll learn where every number comes from and how to tell a real signal from noise.
      </p>

      <h3>⚡ Test, kill, scale</h3>
      <p>
        Double down on what works, cut what doesn't, and turn your best organic videos into paid creative and Spark
        Ads once they've proven themselves.
      </p>

      <h3>🤝 Creators &amp; UGC (the layer on top)</h3>
      <p>
        Once organic gives us a winning format, we scale it with creators. You'll source, brief and manage a roster of
        UGC creators so the playbook you built runs at 10x volume.
      </p>

      <h3>🤖 And the real unlock: you vibe-code your own tools</h3>
      <p>
        Automate your posting reports, build mini-dashboards, script the boring parts with Claude / Codex so you spend
        your time creating, not copy-pasting.
      </p>
      <p>
        This is an internship where you take initiative from week one. We trust you — and we hold you to results.
      </p>

      <h2>🤓 Who we're looking for</h2>
      <ul>
        <li>
          <strong>You already make content.</strong> Personal account, side project, brand page, client work — we want
          to see what you've posted, not just that you've studied it
        </li>
        <li>You're fluent in CapCut (or equivalent) and can go from idea to published video in a couple of hours</li>
        <li>You genuinely live on TikTok and Reels — and can explain <em>why</em> something worked, not just that it did</li>
        <li>Comfortable being on camera, or smart enough to build formats that don't need you to be</li>
        <li>You like numbers: reading retention curves and spotting patterns doesn't scare you</li>
        <li>
          Curious about AI and vibe coding: you don't need to code, but building your own tools with Claude / Codex
          excites you
        </li>
        <li>Hands-on and autonomous: you'd rather ship a rough v1 today than a perfect v2 next week</li>
        <li>Fluent in English, written and spoken</li>
      </ul>

      <h2>✨ What you'll also get</h2>
      <ul>
        <li>A young team that ships fast</li>
        <li>A high-growth company where new opportunities keep opening up</li>
        <li>Competitive compensation package</li>
        <li>Gymlib membership</li>
        <li>Flexible paid time off</li>
        <li>Green mobility allowance</li>
        <li>Meal vouchers</li>
      </ul>

      <h2>🔥 Sound like your playground?</h2>
      <p>
        Want to learn a lot, fast? Become a top operator in a hyper-growth startup — or build your own company one
        day?
      </p>
      <ul>
        <li>Apply below and add <strong>2–3 links to content you've made</strong>. That matters more than the CV.</li>
      </ul>

      <h2>Job details</h2>
      <table>
        <tbody>
          <tr><th>Company</th><td>Bliss Coach — <a href="https://bliss-coach.com">bliss-coach.com</a></td></tr>
          <tr><th>Contract</th><td>Internship, {ROLE.duration}</td></tr>
          <tr><th>Location</th><td>{ROLE.location} · {ROLE.mode}</td></tr>
          <tr><th>Start</th><td>{ROLE.start}</td></tr>
          <tr><th>Language</th><td>English (fluent, written and spoken)</td></tr>
        </tbody>
      </table>
    </div>

    <aside class="cta-box">
      <div class="inner">
        <img src={withBase('/icons/sofia.jpg')} alt="" width="72" height="72" loading="lazy" />
        <div class="txt">
          <h3>Apply in one email</h3>
          <p>Send 2–3 links to content you've made to {ROLE.applyEmail}. The links matter more than the CV.</p>
        </div>
        <a class="btn" href={applyHref}>Apply now</a>
      </div>
    </aside>
  </article>
</Base>

<style>
  .job-kicker {
    font-size: 13px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase;
    color: var(--accent); margin-bottom: 10px;
  }
  .job-facts {
    list-style: none; padding: 0; margin: 4px 0 22px;
    display: flex; flex-wrap: wrap; gap: 8px;
  }
  .job-facts li {
    font-size: 14px; color: #3a3a44; background: #f1f1f5; border: 1px solid #e4e4ea;
    border-radius: 99px; padding: 6px 12px;
  }
  .job-apply { font-size: 15px; padding: 12px 22px; }
  .job .prose .lead { font-size: 19px; line-height: 1.6; color: #17171c; }
  .job .prose h3 { margin-top: 26px; }
  .job .prose table th { width: 32%; white-space: nowrap; }
  @media (max-width: 640px) {
    .job-apply { width: 100%; justify-content: center; }
  }
</style>
